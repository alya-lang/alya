# Alya Standard Library - Console Module
# Provides cross-platform console encoding, code page management, and terminal control.

# --- Encoding & Code Pages ---

pub function console_set_output_cp(cp: int) -> int
    return set_console_output_cp(cp)
end

pub function console_set_input_cp(cp: int) -> int
    return set_console_input_cp(cp)
end

pub function console_output_cp() -> int
    return get_console_output_cp()
end

pub function console_input_cp() -> int
    return get_console_input_cp()
end

pub function console_utf8() -> int
    set_console_output_cp(65001)
    set_console_input_cp(65001)
    enable_virtual_terminal()
    return 1
end

pub function set_output_encoding(encoding_name: string) -> int
    return console_utf8()
end

pub function get_output_encoding() -> string
    let cp: int = console_output_cp()
    if cp == 65001
        return "UTF-8"
    elif cp == 1254 or cp == 857
        return "Turkish (Windows)"
    elif cp == 1252 or cp == 437
        return "Western (Windows)"
    end
    return "CP" + str(cp)
end

# --- Terminal Display & Cursor Control ---

pub function console_enable_ansi() -> int
    return enable_virtual_terminal()
end

pub function console_clear() -> int
    return clear_console()
end

pub function console_title(title: string) -> int
    return set_console_title(title)
end

pub function console_beep() -> int
    return beep_console()
end

pub function console_cursor_to(row: int, col: int)
    say "\e[" + str(row) + ";" + str(col) + "H"
end

pub function console_cursor_hide()
    say "\e[?25l"
end

pub function console_cursor_show()
    say "\e[?25h"
end

# --- Console Input Helpers ---

# Prompts the user with message and reads a full line of text from stdin.
pub function console_prompt(prompt_text: string) -> string
    return ask(prompt_text)
end

# Asks user a yes/no question. Returns 1 for yes, 0 for no.
pub function console_confirm(prompt_text: string, default_yes: int = 1) -> int
    let suffix: string = " (Y/n): "
    if default_yes == 0
        suffix = " (y/N): "
    end
    let resp: string = lower(trim(ask(prompt_text + suffix)))
    if len(resp) == 0
        return default_yes
    end
    if resp == "y" or resp == "yes" or resp == "1" or resp == "e" or resp == "evet"
        return 1
    end
    return 0
end

# --- Color & Style Enums (Merged from std/color) ---

pub enum Color
    Black = 30
    Red = 31
    Green = 32
    Yellow = 33
    Blue = 34
    Magenta = 35
    Cyan = 36
    White = 37
    Gray = 90
    BrightRed = 91
    BrightGreen = 92
    BrightYellow = 93
    BrightBlue = 94
    BrightMagenta = 95
    BrightCyan = 96
    BrightWhite = 97
end

pub enum BgColor
    Black = 40
    Red = 41
    Green = 42
    Yellow = 43
    Blue = 44
    Magenta = 45
    Cyan = 46
    White = 47
end

pub enum Style
    Reset = 0
    Bold = 1
    Dim = 2
    Italic = 3
    Underline = 4
    Inverse = 7
    Strikethrough = 9
end

function _esc(code: string, s: string) -> string
    return "\e[" + code + "m" + str(s) + "\e[0m"
end

# Applies an ANSI code directly to a string.
pub function color_fg(code: int, s: string) -> string return _esc(str(code), s) end
pub function color_bg(code: int, s: string) -> string return _esc(str(code), s) end
pub function color_style(code: int, s: string) -> string return _esc(str(code), s) end

# --- Foreground Colors ---
pub function color_black(s: string) -> string return _esc(str(Color.Black), s) end
