# Alya Standard Library - Console Module (std/console)
# Provides cross-platform console encoding, code page management, and terminal control.
# Includes ANSI colors, styles, raw code snippets, and input helpers.
# Usage: import "std/console"

# --- Color and Style Types (Merged from std/color) ---

## Background ANSI color codes.
##
## ### Variants
## - `Black` (40): Black background.
## - `Red` (41): Red background.
## - `Green` (42): Green background.
## - `Yellow` (43): Yellow background.
## - `Blue` (44): Blue background.
## - `Magenta` (45): Magenta background.
## - `Cyan` (46): Cyan background.
## - `White` (47): White background.
pub enum BgColor
    Black = 40
    Red = 41
    Green = 42
    Yellow = 43
    Blue = 44
    Magenta = 45
    Cyan = 46
    White = 47
end

## Foreground ANSI color codes.
##
## ### Variants
## - `Black` (30): Black foreground.
## - `Red` (31): Red foreground.
## - `Green` (32): Green foreground.
## - `Yellow` (33): Yellow foreground.
## - `Blue` (34): Blue foreground.
## - `Magenta` (35): Magenta foreground.
## - `Cyan` (36): Cyan foreground.
## - `White` (37): White foreground.
## - `Gray` (90): Gray foreground.
## - `BrightRed` (91): Bright red foreground.
## - `BrightGreen` (92): Bright green foreground.
## - `BrightYellow` (93): Bright yellow foreground.
## - `BrightBlue` (94): Bright blue foreground.
## - `BrightMagenta` (95): Bright magenta foreground.
## - `BrightCyan` (96): Bright cyan foreground.
## - `BrightWhite` (97): Bright white foreground.
pub enum Color
    Black = 30
    Red = 31
    Green = 32
    Yellow = 33
    Blue = 34
    Magenta = 35
    Cyan = 36
    White = 37
    Gray = 90
    BrightRed = 91
    BrightGreen = 92
    BrightYellow = 93
    BrightBlue = 94
    BrightMagenta = 95
    BrightCyan = 96
    BrightWhite = 97
end

## ANSI text style codes.
##
## ### Variants
## - `Reset` (0): Reset style.
## - `Bold` (1): Bold style.
## - `Dim` (2): Dim style.
## - `Italic` (3): Italic style.
## - `Underline` (4): Underline style.
## - `Inverse` (7): Inverse style.
## - `Strikethrough` (9): Strikethrough style.
pub enum Style
    Reset = 0
    Bold = 1
    Dim = 2
    Italic = 3
    Underline = 4
    Inverse = 7
    Strikethrough = 9
end

# --- Code Page and Encoding ---

function _encoding_name_for_cp(cp: int) -> string
    return when cp
        # --- Unicode & ASCII ---
        is 65001 => "UTF-8"
        is 1200 => "UTF-16LE"
        is 1201 => "UTF-16BE"
        is 12000 => "UTF-32LE"
        is 12001 => "UTF-32BE"
        is 20127 => "US-ASCII"

        # --- Turkish ---
        is 1254, 857 => "Turkish (Windows)"
        is 28599 => "Turkish (ISO-8859-9)"

        # --- Western & DOS ---
        is 1252, 437, 850 => "Western (Windows)"
        is 28591 => "Western (ISO-8859-1)"

        # --- Central & Eastern European, Cyrillic, Greek, Baltic ---
        is 1250, 852 => "Central European"
        is 1251, 866, 28595 => "Cyrillic"
        is 1253, 737 => "Greek"
        is 1257, 775 => "Baltic"

        # --- Middle Eastern ---
        is 1255, 862 => "Hebrew"
        is 1256, 720 => "Arabic"

        # --- East Asia (CJK) & Southeast Asia ---
        is 932 => "Shift-JIS (Japanese)"
        is 936 => "GBK (Simplified Chinese)"
        is 949 => "EUC-KR (Korean)"
        is 950 => "Big5 (Traditional Chinese)"
        is 1258 => "Vietnamese"
        is 874 => "Thai"

        else => f"CP{cp}"
    end
end

## Returns the console input code page.
##
## ### Parameters
## None.
##
## ### Returns
## The console input code page number.
pub function console_input_cp() -> int
    return get_console_input_cp()
end

## Returns the console output code page.
##
## ### Parameters
## None.
##
## ### Returns
## The console output code page number.
pub function console_output_cp() -> int
    return get_console_output_cp()
end

## Sets the console input code page.
##
## ### Parameters
## - `cp`: Code page number to set (e.g. 65001 for UTF-8).
##
## ### Returns
## The native status code.
pub function console_set_input_cp(cp: int) -> int
    return set_console_input_cp(cp)
end

## Sets the console output code page.
##
## ### Parameters
## - `cp`: Code page number to set (e.g. 65001 for UTF-8).
##
## ### Returns
## The native status code.
pub function console_set_output_cp(cp: int) -> int
    return set_console_output_cp(cp)
end

## Switches the console to UTF-8 and enables virtual-terminal processing.
##
## ### Parameters
## None.
##
## ### Returns
## 1 after setting both code pages to 65001 and enabling virtual-terminal processing.
pub function console_utf8() -> int
    set_console_output_cp(65001)
    set_console_input_cp(65001)
    enable_virtual_terminal()
    return 1
end

## Returns a display name for the console input code page.
##
## ### Parameters
## None.
##
## ### Returns
## The display name for the current input code page (unmapped code pages render as `CP{n}`).
pub function get_input_encoding() -> string
    let cp: int = console_input_cp()
    return _encoding_name_for_cp(cp)
end

## Returns a display name for the console output code page.
##
## ### Parameters
## None.
##
## ### Returns
## The display name for the current output code page (unmapped code pages render as `CP{n}`).
pub function get_output_encoding() -> string
    let cp: int = console_output_cp()
    return _encoding_name_for_cp(cp)
end

## Sets the console output code page by encoding name.
##
## ### Parameters
## - `encoding_name`: Encoding name, matched case-insensitively (e.g. `utf-8`, `ascii`, `windows-1254`, `shift-jis`, `gbk`); unrecognized names fall back to UTF-8.
##
## ### Returns
## The selected numeric code page (65001 for unrecognized names).
pub function set_output_encoding(encoding_name: string) -> int
    let clean: string = lower(encoding_name)
    let cp: int = when clean
        is "utf-8", "utf8" => 65001
        is "utf-16le", "utf16le" => 1200
        is "utf-16be", "utf16be" => 1201
        is "ascii", "us-ascii" => 20127
        is "turkish", "windows-1254", "cp1254" => 1254
        is "ibm-857", "cp857" => 857
        is "iso-8859-9", "latin-5" => 28599
        is "western", "windows-1252", "cp1252" => 1252
        is "oem-437", "cp437" => 437
        is "oem-850", "cp850" => 850
        is "iso-8859-1", "latin-1" => 28591
        is "windows-1250", "cp1250" => 1250
        is "windows-1251", "cp1251" => 1251
        is "windows-1253", "cp1253" => 1253
        is "windows-1255", "cp1255" => 1255
        is "windows-1256", "cp1256" => 1256
        is "shift-jis", "sjis", "cp932" => 932
        is "gbk", "cp936" => 936
        is "euc-kr", "cp949" => 949
        is "big5", "cp950" => 950
        else => 65001
    end
    set_console_output_cp(cp)
    return cp
end

# --- Terminal Control ---

## Rings the terminal bell.
##
## ### Parameters
## None.
##
## ### Returns
## The native status code.
pub function console_beep() -> int
    return beep_console()
end

## Clears the console screen.
##
## ### Parameters
## None.
##
## ### Returns
## The native status code.
pub function console_clear() -> int
    return clear_console()
end

## Hides the terminal cursor.
##
## ### Parameters
## None.
##
## ### Returns
## Nothing.
pub function console_cursor_hide()
    say "\e[?25l"
end

## Shows the terminal cursor.
##
## ### Parameters
## None.
##
## ### Returns
## Nothing.
pub function console_cursor_show()
    say "\e[?25h"
end

## Moves the cursor to the given row and column.
##
## ### Parameters
## - `row`: Cursor row number.
## - `col`: Cursor column number.
##
## ### Returns
## Nothing.
pub function console_cursor_to(row: int, col: int)
    say f"\e[{row};{col}H"
end

## Enables virtual-terminal ANSI processing.
##
## ### Parameters
## None.
##
## ### Returns
## The native status code.
pub function console_enable_ansi() -> int
    return enable_virtual_terminal()
end

## Sets the console window title.
##
## ### Parameters
## - `title`: Title text to assign to the console window.
##
## ### Returns
## The native status code.
pub function console_title(title: string) -> int
    return set_console_title(title)
end

# --- Console Input ---

## Asks a yes/no question, returning 1 for yes and 0 for no.
##
## ### Parameters
## - `prompt_text`: Question text shown before the yes/no suffix.
## - `default_yes`: Default hint and empty-input result (1 shows ` (Y/n): ` and defaults to yes; 0 shows ` (y/N): ` and defaults to no).
##
## ### Returns
## 1 for a yes answer (`y`, `yes`, `1`, `e`, `evet`, case-insensitive) or an empty answer resolving to a nonzero default; else 0.
pub function console_confirm(prompt_text: string, default_yes: int = 1) -> int
    let suffix: string = " (Y/n): "
    if default_yes == 0
        suffix = " (y/N): "
    end
    let resp: string = lower(trim(ask(prompt_text + suffix)))
    if len(resp) == 0
        return default_yes
    end
    when resp
        is "y", "yes", "1", "e", "evet" then return 1
    end
    return 0
end

## Prompts the user and reads a full line of text from stdin.
##
## ### Parameters
## - `prompt_text`: Prompt text shown to the user.
##
## ### Returns
## The full line of text read from stdin.
pub function console_prompt(prompt_text: string) -> string
    return ask(prompt_text)
end

# --- Color and Style ---

function _esc(code: string, s: string) -> string
    return "\e[" + code + "m" + str(s) + "\e[0m"
end

## Returns the raw ANSI bold sequence.
##
## ### Parameters
## None.
##
## ### Returns
## The raw ANSI bold sequence.
pub function ansi_bold() -> string return "\e[1m" end

## Returns the raw ANSI dim sequence.
##
## ### Parameters
## None.
##
## ### Returns
## The raw ANSI dim sequence.
pub function ansi_dim() -> string return "\e[2m" end

## Returns the raw ANSI italic sequence.
##
## ### Parameters
## None.
##
## ### Returns
## The raw ANSI italic sequence.
pub function ansi_italic() -> string return "\e[3m" end

## Returns the raw ANSI reset sequence.
##
## ### Parameters
## None.
##
## ### Returns
## The raw ANSI reset sequence.
pub function ansi_reset() -> string return "\e[0m" end

## Removes ANSI CSI escape sequences from text.
##
## ### Parameters
## - `text`: Text that may contain ANSI CSI escape sequences.
##
## ### Returns
## The text with ANSI CSI escape sequences removed.
pub function ansi_strip(text: string) -> string
    let s: string = str(text)
    let slen: int = len(s)
    let res: string = ""
    let i: int = 0
    while i < slen
        let ch: string = char_at(s, i)
        if ord(ch) == 27 and i + 1 < slen and char_at(s, i + 1) == "["
            i += 2
            while i < slen
                let c: string = char_at(s, i)
                let o: int = ord(c)
                if o >= 64 and o <= 126
                    break
                end
                i += 1
            end
        else
            res = res + ch
        end
        i += 1
    end
    return res
end

## Returns the raw ANSI underline sequence.
##
## ### Parameters
## None.
##
## ### Returns
## The raw ANSI underline sequence.
pub function ansi_underline() -> string return "\e[4m" end

## Wraps text in a 256-palette background color.
##
## ### Parameters
## - `s`: Text to wrap.
## - `code`: 256-palette color code number.
##
## ### Returns
## The text wrapped in the 256-palette background sequence with a trailing reset.
pub function bg_256(s: string, code: int) -> string
    let c: string = str(code)
    return "\e[48;5;" + c + "m" + str(s) + "\e[0m"
end

## Wraps text in the black background color.
##
## ### Parameters
## - `s`: Text to wrap.
##
## ### Returns
## The text wrapped in the black background sequence with a trailing reset.
pub function bg_black(s: string) -> string return _esc(str(BgColor.Black), s) end

## Wraps text in the blue background color.
##
## ### Parameters
## - `s`: Text to wrap.
##
## ### Returns
