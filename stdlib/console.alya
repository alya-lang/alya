pub function bg_red(s: string) -> string return _esc(str(BgColor.Red), s) end
pub function bg_green(s: string) -> string return _esc(str(BgColor.Green), s) end
pub function bg_yellow(s: string) -> string return _esc(str(BgColor.Yellow), s) end
pub function bg_blue(s: string) -> string return _esc(str(BgColor.Blue), s) end
pub function bg_magenta(s: string) -> string return _esc(str(BgColor.Magenta), s) end
