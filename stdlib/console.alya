# --- Text Styles ---
pub function style_bold(s: string) -> string return _esc(str(Style.Bold), s) end
pub function style_dim(s: string) -> string return _esc(str(Style.Dim), s) end
pub function style_italic(s: string) -> string return _esc(str(Style.Italic), s) end
pub function style_underline(s: string) -> string return _esc(str(Style.Underline), s) end
pub function style_inverse(s: string) -> string return _esc(str(Style.Inverse), s) end
pub function style_strikethrough(s: string) -> string return _esc(str(Style.Strikethrough), s) end

pub function color_bold(s: string) -> string return style_bold(s) end
pub function color_underline(s: string) -> string return style_underline(s) end
pub function color_italic(s: string) -> string return style_italic(s) end

# --- 24-bit TrueColor RGB (r, g, b in range 0-255) ---
pub function color_rgb(s: string, r: int, g: int, b: int) -> string
    let rc: string = str(r)
    let gc: string = str(g)
    let bc: string = str(b)
    return "\e[38;2;" + rc + ";" + gc + ";" + bc + "m" + str(s) + "\e[0m"
end

pub function bg_rgb(s: string, r: int, g: int, b: int) -> string
    let rc: string = str(r)
    let gc: string = str(g)
    let bc: string = str(b)
    return "\e[48;2;" + rc + ";" + gc + ";" + bc + "m" + str(s) + "\e[0m"
end

# --- 256-Color Palette ---
pub function color_256(s: string, code: int) -> string
    let c: string = str(code)
    return "\e[38;5;" + c + "m" + str(s) + "\e[0m"
end

pub function bg_256(s: string, code: int) -> string
    let c: string = str(code)
    return "\e[48;5;" + c + "m" + str(s) + "\e[0m"
end

# --- Raw ANSI Code Snippets ---
pub function ansi_reset() -> string return "\e[0m" end
pub function ansi_bold() -> string return "\e[1m" end
pub function ansi_dim() -> string return "\e[2m" end
pub function ansi_italic() -> string return "\e[3m" end
pub function ansi_underline() -> string return "\e[4m" end

# Strips all ANSI CSI escape sequences from text
pub function ansi_strip(text: string) -> string
    let s: string = str(text)
    let slen: int = len(s)
    let res: string = ""
    let i: int = 0
    while i < slen
        let ch: string = char_at(s, i)
        if ord(ch) == 27 and i + 1 < slen and char_at(s, i + 1) == "["
            i += 2
            while i < slen
                let c: string = char_at(s, i)
                let o: int = ord(c)
                if o >= 64 and o <= 126
                    break
                end
                i += 1
            end
        else
            res = res + ch
        end
        i += 1
    end
    return res
end

# --- Console Aliases ---
pub function console_color(fg_code: int, text: string) -> string return color_fg(fg_code, text) end
pub function console_bold(text: string) -> string return style_bold(text) end
pub function console_dim(text: string) -> string return style_dim(text) end
pub function console_italic(text: string) -> string return style_italic(text) end
pub function console_underline(text: string) -> string return style_underline(text) end
pub function console_red(text: string) -> string return color_red(text) end
pub function console_green(text: string) -> string return color_green(text) end
pub function console_yellow(text: string) -> string return color_yellow(text) end
pub function console_blue(text: string) -> string return color_blue(text) end
pub function console_magenta(text: string) -> string return color_magenta(text) end
pub function console_cyan(text: string) -> string return color_cyan(text) end
pub function console_white(text: string) -> string return color_white(text) end
pub function console_gray(text: string) -> string return color_gray(text) end
