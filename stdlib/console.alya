## Wraps text in a 24-bit truecolor foreground.
pub function color_rgb(s: string, r: int, g: int, b: int) -> string
    let rc: string = str(r)
    let gc: string = str(g)
    let bc: string = str(b)
    return "\e[38;2;" + rc + ";" + gc + ";" + bc + "m" + str(s) + "\e[0m"
end

## Wraps text in an ANSI style code.
pub function color_style(code: int, s: string) -> string return _esc(str(code), s) end

## Wraps text in the white foreground color.
pub function color_white(s: string) -> string return _esc(str(Color.White), s) end

## Wraps text in the yellow foreground color.
pub function color_yellow(s: string) -> string return _esc(str(Color.Yellow), s) end

## Renders text in the bold style.
pub function style_bold(s: string) -> string return _esc(str(Style.Bold), s) end

## Renders text in the dim style.
pub function style_dim(s: string) -> string return _esc(str(Style.Dim), s) end

