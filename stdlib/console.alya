# --- Legacy Aliases ---

## Legacy alias rendering text in blue.
pub function blue(text: string) -> string return console_blue(text) end

## Legacy alias rendering text in bold.
pub function bold(text: string) -> string return console_bold(text) end

## Legacy alias rendering text in bold.
pub function color_bold(s: string) -> string return style_bold(s) end

## Legacy alias rendering text in italic.
pub function color_italic(s: string) -> string return style_italic(s) end

## Legacy alias rendering text underlined.
pub function color_underline(s: string) -> string return style_underline(s) end

## Legacy alias rendering text in blue.
pub function console__blue(text: string) -> string return console_blue(text) end

## Legacy alias rendering text in bold.
pub function console__bold(text: string) -> string return console_bold(text) end

## Legacy alias rendering text in green.
pub function console__green(text: string) -> string return console_green(text) end

