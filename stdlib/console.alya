# Alya Standard Library - Console Module
# Provides cross-platform console encoding, code page management, and terminal control.

# --- Encoding & Code Pages ---

pub function console_set_output_cp(cp: int) -> int
    return set_console_output_cp(cp)
end

pub function console_set_input_cp(cp: int) -> int
    return set_console_input_cp(cp)
end

pub function console_output_cp() -> int
    return get_console_output_cp()
end

pub function console_input_cp() -> int
    return get_console_input_cp()
end

pub function console_utf8() -> int
    set_console_output_cp(65001)
    set_console_input_cp(65001)
    enable_virtual_terminal()
    return 1
end

function _encoding_name_for_cp(cp: int) -> string
    return when cp
        # --- Unicode & ASCII ---
        is 65001 => "UTF-8"
        is 1200 => "UTF-16LE"
        is 1201 => "UTF-16BE"
        is 12000 => "UTF-32LE"
        is 12001 => "UTF-32BE"
        is 20127 => "US-ASCII"

        # --- Turkish ---
        is 1254, 857 => "Turkish (Windows)"
        is 28599 => "Turkish (ISO-8859-9)"

        # --- Western & DOS ---
        is 1252, 437, 850 => "Western (Windows)"
        is 28591 => "Western (ISO-8859-1)"

        # --- Central & Eastern European, Cyrillic, Greek, Baltic ---
        is 1250, 852 => "Central European"
        is 1251, 866, 28595 => "Cyrillic"
        is 1253, 737 => "Greek"
        is 1257, 775 => "Baltic"

        # --- Middle Eastern ---
        is 1255, 862 => "Hebrew"
        is 1256, 720 => "Arabic"

        # --- East Asia (CJK) & Southeast Asia ---
        is 932 => "Shift-JIS (Japanese)"
        is 936 => "GBK (Simplified Chinese)"
        is 949 => "EUC-KR (Korean)"
        is 950 => "Big5 (Traditional Chinese)"
        is 1258 => "Vietnamese"
        is 874 => "Thai"

        else => f"CP{cp}"
    end
end

pub function get_output_encoding() -> string
    let cp: int = console_output_cp()
    return _encoding_name_for_cp(cp)
end

pub function get_input_encoding() -> string
    let cp: int = console_input_cp()
    return _encoding_name_for_cp(cp)
end

pub function set_output_encoding(encoding_name: string) -> int
    let clean: string = lower(encoding_name)
    let cp: int = when clean
        is "utf-8", "utf8" => 65001
        is "utf-16le", "utf16le" => 1200
        is "utf-16be", "utf16be" => 1201
        is "ascii", "us-ascii" => 20127
        is "turkish", "windows-1254", "cp1254" => 1254
        is "ibm-857", "cp857" => 857
        is "iso-8859-9", "latin-5" => 28599
        is "western", "windows-1252", "cp1252" => 1252
        is "oem-437", "cp437" => 437
        is "oem-850", "cp850" => 850
        is "iso-8859-1", "latin-1" => 28591
        is "windows-1250", "cp1250" => 1250
        is "windows-1251", "cp1251" => 1251
        is "windows-1253", "cp1253" => 1253
        is "windows-1255", "cp1255" => 1255
        is "windows-1256", "cp1256" => 1256
        is "shift-jis", "sjis", "cp932" => 932
        is "gbk", "cp936" => 936
        is "euc-kr", "cp949" => 949
        is "big5", "cp950" => 950
        else => 65001
    end
    set_console_output_cp(cp)
    return cp
end

# --- Terminal Display & Cursor Control ---

pub function console_enable_ansi() -> int
    return enable_virtual_terminal()
end

pub function console_clear() -> int
    return clear_console()
end

pub function console_title(title: string) -> int
    return set_console_title(title)
end

pub function console_beep() -> int
    return beep_console()
end

pub function console_cursor_to(row: int, col: int)
    say "\e[" + str(row) + ";" + str(col) + "H"
end

pub function console_cursor_hide()
    say "\e[?25l"
end

pub function console_cursor_show()
    say "\e[?25h"
end

# --- Console Input Helpers ---

# Prompts the user with message and reads a full line of text from stdin.
pub function console_prompt(prompt_text: string) -> string
    return ask(prompt_text)
end

# Asks user a yes/no question. Returns 1 for yes, 0 for no.
pub function console_confirm(prompt_text: string, default_yes: int = 1) -> int
    let suffix: string = " (Y/n): "
    if default_yes == 0
        suffix = " (y/N): "
    end
    let resp: string = lower(trim(ask(prompt_text + suffix)))
    if len(resp) == 0
        return default_yes
    end
    if resp == "y" or resp == "yes" or resp == "1" or resp == "e" or resp == "evet"
        return 1
    end
    return 0
end

# --- Color & Style Enums (Merged from std/color) ---

pub enum Color
    Black = 30
    Red = 31
    Green = 32
    Yellow = 33
    Blue = 34
    Magenta = 35
    Cyan = 36
    White = 37
    Gray = 90
    BrightRed = 91
    BrightGreen = 92
    BrightYellow = 93
    BrightBlue = 94
    BrightMagenta = 95
    BrightCyan = 96
    BrightWhite = 97
end

pub enum BgColor
    Black = 40
    Red = 41
    Green = 42
    Yellow = 43
    Blue = 44
    Magenta = 45
    Cyan = 46
    White = 47
end

pub enum Style
    Reset = 0
    Bold = 1
    Dim = 2
    Italic = 3
    Underline = 4
    Inverse = 7
    Strikethrough = 9
end

function _esc(code: string, s: string) -> string
    return "\e[" + code + "m" + str(s) + "\e[0m"
end

# Applies an ANSI code directly to a string.
pub function color_fg(code: int, s: string) -> string return _esc(str(code), s) end
pub function color_bg(code: int, s: string) -> string return _esc(str(code), s) end
pub function color_style(code: int, s: string) -> string return _esc(str(code), s) end

# --- Foreground Colors ---
pub function color_black(s: string) -> string return _esc(str(Color.Black), s) end
pub function color_red(s: string) -> string return _esc(str(Color.Red), s) end
pub function color_green(s: string) -> string return _esc(str(Color.Green), s) end
pub function color_yellow(s: string) -> string return _esc(str(Color.Yellow), s) end
pub function color_blue(s: string) -> string return _esc(str(Color.Blue), s) end
pub function color_magenta(s: string) -> string return _esc(str(Color.Magenta), s) end
pub function color_cyan(s: string) -> string return _esc(str(Color.Cyan), s) end
pub function color_white(s: string) -> string return _esc(str(Color.White), s) end
pub function color_gray(s: string) -> string return _esc(str(Color.Gray), s) end

# --- Bright Foreground Colors ---
pub function color_bright_red(s: string) -> string return _esc(str(Color.BrightRed), s) end
pub function color_bright_green(s: string) -> string return _esc(str(Color.BrightGreen), s) end
pub function color_bright_yellow(s: string) -> string return _esc(str(Color.BrightYellow), s) end
pub function color_bright_blue(s: string) -> string return _esc(str(Color.BrightBlue), s) end
pub function color_bright_magenta(s: string) -> string return _esc(str(Color.BrightMagenta), s) end
pub function color_bright_cyan(s: string) -> string return _esc(str(Color.BrightCyan), s) end
pub function color_bright_white(s: string) -> string return _esc(str(Color.BrightWhite), s) end

# --- Background Colors ---
pub function bg_black(s: string) -> string return _esc(str(BgColor.Black), s) end
pub function bg_red(s: string) -> string return _esc(str(BgColor.Red), s) end
pub function bg_green(s: string) -> string return _esc(str(BgColor.Green), s) end
pub function bg_yellow(s: string) -> string return _esc(str(BgColor.Yellow), s) end
pub function bg_blue(s: string) -> string return _esc(str(BgColor.Blue), s) end
pub function bg_magenta(s: string) -> string return _esc(str(BgColor.Magenta), s) end
pub function bg_cyan(s: string) -> string return _esc(str(BgColor.Cyan), s) end
pub function bg_white(s: string) -> string return _esc(str(BgColor.White), s) end

# --- Text Styles ---
pub function style_bold(s: string) -> string return _esc(str(Style.Bold), s) end
pub function style_dim(s: string) -> string return _esc(str(Style.Dim), s) end
pub function style_italic(s: string) -> string return _esc(str(Style.Italic), s) end
pub function style_underline(s: string) -> string return _esc(str(Style.Underline), s) end
pub function style_inverse(s: string) -> string return _esc(str(Style.Inverse), s) end
pub function style_strikethrough(s: string) -> string return _esc(str(Style.Strikethrough), s) end

pub function color_bold(s: string) -> string return style_bold(s) end
pub function color_underline(s: string) -> string return style_underline(s) end
pub function color_italic(s: string) -> string return style_italic(s) end

# --- 24-bit TrueColor RGB (r, g, b in range 0-255) ---
pub function color_rgb(s: string, r: int, g: int, b: int) -> string
    let rc: string = str(r)
    let gc: string = str(g)
    let bc: string = str(b)
    return "\e[38;2;" + rc + ";" + gc + ";" + bc + "m" + str(s) + "\e[0m"
end

pub function bg_rgb(s: string, r: int, g: int, b: int) -> string
    let rc: string = str(r)
    let gc: string = str(g)
    let bc: string = str(b)
    return "\e[48;2;" + rc + ";" + gc + ";" + bc + "m" + str(s) + "\e[0m"
end

# --- 256-Color Palette ---
pub function color_256(s: string, code: int) -> string
    let c: string = str(code)
    return "\e[38;5;" + c + "m" + str(s) + "\e[0m"
end

pub function bg_256(s: string, code: int) -> string
    let c: string = str(code)
    return "\e[48;5;" + c + "m" + str(s) + "\e[0m"
end

# --- Raw ANSI Code Snippets ---
pub function ansi_reset() -> string return "\e[0m" end
pub function ansi_bold() -> string return "\e[1m" end
pub function ansi_dim() -> string return "\e[2m" end
pub function ansi_italic() -> string return "\e[3m" end
pub function ansi_underline() -> string return "\e[4m" end

# Strips all ANSI CSI escape sequences from text
pub function ansi_strip(text: string) -> string
    let s: string = str(text)
    let slen: int = len(s)
    let res: string = ""
    let i: int = 0
    while i < slen
        let ch: string = char_at(s, i)
        if ord(ch) == 27 and i + 1 < slen and char_at(s, i + 1) == "["
            i += 2
            while i < slen
                let c: string = char_at(s, i)
                let o: int = ord(c)
                if o >= 64 and o <= 126
                    break
                end
                i += 1
            end
        else
            res = res + ch
        end
        i += 1
    end
    return res
end

# --- Console Aliases ---
pub function console_color(fg_code: int, text: string) -> string return color_fg(fg_code, text) end
pub function console_bold(text: string) -> string return style_bold(text) end
pub function console_dim(text: string) -> string return style_dim(text) end
pub function console_italic(text: string) -> string return style_italic(text) end
pub function console_underline(text: string) -> string return style_underline(text) end
pub function console_red(text: string) -> string return color_red(text) end
pub function console_green(text: string) -> string return color_green(text) end
pub function console_yellow(text: string) -> string return color_yellow(text) end
pub function console_blue(text: string) -> string return color_blue(text) end
pub function console_magenta(text: string) -> string return color_magenta(text) end
pub function console_cyan(text: string) -> string return color_cyan(text) end
pub function console_white(text: string) -> string return color_white(text) end
pub function console_gray(text: string) -> string return color_gray(text) end

pub function utf8() -> int return console_utf8() end
pub function console__utf8() -> int return console_utf8() end
pub function green(text: string) -> string return console_green(text) end
pub function console__green(text: string) -> string return console_green(text) end
pub function blue(text: string) -> string return console_blue(text) end
pub function console__blue(text: string) -> string return console_blue(text) end
pub function bold(text: string) -> string return console_bold(text) end
pub function console__bold(text: string) -> string return console_bold(text) end
