## Wraps text in a 24-bit truecolor background.
##
## ### Parameters
## - `s`: Text to wrap.
## - `r`: Red component value.
## - `g`: Green component value.
## - `b`: Blue component value.
##
## ### Returns
## The text wrapped in the 24-bit truecolor background sequence with a trailing reset.
pub function bg_rgb(s: string, r: int, g: int, b: int) -> string
    let rc: string = str(r)
    let gc: string = str(g)
    let bc: string = str(b)
    return "\e[48;2;" + rc + ";" + gc + ";" + bc + "m" + str(s) + "\e[0m"
end

