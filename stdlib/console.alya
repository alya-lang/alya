## Wraps text in the gray foreground color.
pub function color_gray(s: string) -> string return _esc(str(Color.Gray), s) end

## Wraps text in the green foreground color.
pub function color_green(s: string) -> string return _esc(str(Color.Green), s) end

## Wraps text in the magenta foreground color.
pub function color_magenta(s: string) -> string return _esc(str(Color.Magenta), s) end

