# Alya Standard Library - CLI / Args Module (std/cli)
# Provides lightweight raw access to operating system arguments,
# basic flag detection, option retrieval, and positional arguments.
# For advanced CLI parsing (subcommands, choice validation, auto-generated
# help screens, flag clustering), use the modern 'alya-lang/cli' package.

function _cli_strip_dashes(s)
    let s_str = str_from_ptr(s)
    let slen = len(s_str)
    if slen >= 2
        if substring(s_str, 0, 2) == "--"
            return substring(s_str, 2, slen - 2)
        end
    end
    if slen >= 1
        if substring(s_str, 0, 1) == "-"
            return substring(s_str, 1, slen - 1)
        end
    end
    return s_str
end

# --- Raw Argument Accessors ---

pub function cli_raw_args()
    return args()
end

pub function cli_arg_count()
    return len(args())
end

pub function cli_arg_at(idx, default_val = "")
    let raw = args()
    if idx >= 0
        if idx < len(raw)
            return str_from_ptr(raw[idx])
        end
    end
    return default_val
end

# --- Lightweight Flag & Option Getters ---

pub function cli_has_flag(flag_name)
    let raw = args()
    let clean = _cli_strip_dashes(flag_name)
    let target_long = "--" + clean
    let target_short = "-" + clean
    let count = len(raw)
    let i = 0
    while i < count
        let arg = str_from_ptr(raw[i])
        if arg == target_long or arg == target_short
            return 1
        end
        i += 1
    end
    return 0
end

pub function cli_get_opt(opt_name, default_val = "")
    let raw = args()
    let clean = _cli_strip_dashes(opt_name)
    let target_long = "--" + clean
    let target_short = "-" + clean
    let prefix = target_long + "="
    let prefix_len = len(prefix)
    let count = len(raw)
    let i = 0
    while i < count
        let arg = str_from_ptr(raw[i])
        let arg_len = len(arg)
        if arg_len >= prefix_len
            if substring(arg, 0, prefix_len) == prefix
                return substring(arg, prefix_len, arg_len - prefix_len)
            end
        end
        if arg == target_long or arg == target_short
            if i + 1 < count
                return str_from_ptr(raw[i + 1])
            end
        end
        i += 1
    end
    return default_val
end

pub function cli_get_positional(idx, default_val = "")
    let raw = args()
    let count = len(raw)
    let pos_idx = 0
    let i = 0
    while i < count
        let arg = str_from_ptr(raw[i])
        let arg_len = len(arg)
        if arg_len > 0
            if substring(arg, 0, 1) != "-"
                if pos_idx == idx
                    return arg
                end
                pos_idx += 1
            end
        end
        i += 1
    end
    return default_val
end
