# Alya Standard Library - CLI Module (std/cli)
# Provides lightweight raw access to operating system arguments,
# basic flag detection, option retrieval, and positional arguments.
# For advanced CLI parsing (subcommands, choice validation, auto-generated
# help screens, flag clustering), use the modern 'alya-lang/cli' package.
# Usage: import "std/cli"

# --- Private Helpers ---

# Strips leading dashes from a flag or option name.
function _cli_strip_dashes(s: string) -> string
    let s_str: string = str_from_ptr(s)
    let slen: int = len(s_str)
    if slen >= 2
        if substring(s_str, 0, 2) == "--"
            return substring(s_str, 2, slen - 2)
        end
    end
    if slen >= 1
        if substring(s_str, 0, 1) == "-"
            return substring(s_str, 1, slen - 1)
        end
    end
    return s_str
end

# --- Raw Argument Accessors ---

## Returns the raw argument at idx, or default_val when out of range.
##
## ### Parameters
## - `idx`: Zero-based index into the raw OS argument list.
## - `default_val`: Fallback value returned when idx is out of range.
##
## ### Returns
## The raw argument at idx, or default_val when idx is negative or past the end.
pub function cli_arg_at(idx: int, default_val: string = "") -> string
    let raw: string[] = args()
    if idx >= 0
        if idx < len(raw)
            return str_from_ptr(raw[idx])
        end
    end
    return default_val
end

## Returns the number of raw OS arguments.
##
## ### Parameters
## None.
##
## ### Returns
## The count of raw OS arguments.
pub function cli_arg_count() -> int
    return len(args())
end

## Returns all raw OS arguments.
##
## ### Parameters
## None.
##
## ### Returns
## The full raw OS argument list.
pub function cli_raw_args() -> string[]
    return args()
end

# --- Flags, Options & Positionals ---

## Returns the value of option opt_name (--opt=value or --opt value), or default_val when absent.
##
## ### Parameters
## - `opt_name`: Option name, with or without leading dashes.
## - `default_val`: Fallback value returned when the option is absent.
##
## ### Returns
## The option value, or default_val when the option is absent or has no following value.
pub function cli_get_opt(opt_name: string, default_val: string = "") -> string
    let raw: string[] = args()
    let clean: string = _cli_strip_dashes(opt_name)
    let target_long: string = "--" + clean
    let target_short: string = "-" + clean
    let prefix: string = target_long + "="
    let prefix_len: int = len(prefix)
    let count: int = len(raw)
    let i: int = 0
    while i < count
        let arg: string = str_from_ptr(raw[i])
        let arg_len: int = len(arg)
        if arg_len >= prefix_len
            if substring(arg, 0, prefix_len) == prefix
                return substring(arg, prefix_len, arg_len - prefix_len)
            end
        end
        if arg == target_long or arg == target_short
            if i + 1 < count
                return str_from_ptr(raw[i + 1])
            end
        end
        i += 1
    end
    return default_val
end

## Returns the idx-th positional (non-dash) argument, or default_val when absent.
##
## ### Parameters
## - `idx`: Zero-based index among positional arguments only.
## - `default_val`: Fallback value returned when the index is out of range.
##
## ### Returns
## The idx-th argument that does not start with `-`, or default_val when absent.
pub function cli_get_positional(idx: int, default_val: string = "") -> string
    let raw: string[] = args()
    let count: int = len(raw)
    let pos_idx: int = 0
    let i: int = 0
    while i < count
        let arg: string = str_from_ptr(raw[i])
        let arg_len: int = len(arg)
        if arg_len > 0
            if substring(arg, 0, 1) != "-"
                if pos_idx == idx
                    return arg
                end
                pos_idx += 1
            end
        end
        i += 1
    end
    return default_val
end

## Returns 1 when flag_name (--flag or -flag) is present among raw arguments.
##
## ### Parameters
## - `flag_name`: Flag name, with or without leading dashes.
##
## ### Returns
## 1 when the flag is present, otherwise 0.
pub function cli_has_flag(flag_name: string) -> int
    let raw: string[] = args()
    let clean: string = _cli_strip_dashes(flag_name)
    let target_long: string = "--" + clean
    let target_short: string = "-" + clean
    let count: int = len(raw)
    let i: int = 0
    while i < count
        let arg: string = str_from_ptr(raw[i])
        if arg == target_long or arg == target_short
            return 1
        end
        i += 1
    end
    return 0
end
