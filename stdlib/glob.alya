# Alya Standard Library - Glob Module (std/glob)
# Provides wildcard pattern matching (*, **, ?, [a-z], [!0-9]),
# array filtering, string pattern escaping, and filesystem globbing.

function _glob_find(s: string, target: string, start_idx: int) -> int
    let slen: int = len(s)
    let tlen: int = len(target)
    if tlen == 0 return start_idx end
    let i: int = start_idx
    while i + tlen <= slen
        if substring(s, i, tlen) == target
            return i
        end
        i += 1
    end
    return -1
end

function _glob_match_class(content: string, ch: string) -> int
    let clen: int = len(content)
    if clen == 0 return 0 end

    let negated: int = 0
    let start: int = 0
    if char_at(content, 0) == "!" or char_at(content, 0) == "^"
        negated = 1
        start = 1
    end

    let ch_code: int = ord(ch)
    let matched: int = 0
    let i: int = start
    while i < clen
        if i + 2 < clen and char_at(content, i + 1) == "-"
            let r_start: int = ord(char_at(content, i))
            let r_end: int = ord(char_at(content, i + 2))
            if ch_code >= r_start and ch_code <= r_end
                matched = 1
                break
            end
            i += 3
        else
            if char_at(content, i) == ch
                matched = 1
                break
            end
            i += 1
        end
    end

    if negated == 1
        if matched == 1 return 0 else return 1 end
    end
    return matched
end

function _glob_match_path_rec(p: string, p_idx: int, s: string, s_idx: int) -> int
    let plen: int = len(p)
    let slen: int = len(s)

    while p_idx < plen
        let pch: string = char_at(p, p_idx)

        # Check for ** (double star) in path mode
        if pch == "*" and p_idx + 1 < plen and char_at(p, p_idx + 1) == "*"
            let next_p: int = p_idx + 2
            if next_p < plen and char_at(p, next_p) == "/"
                next_p += 1
            end

            let try_s: int = s_idx
            while try_s <= slen
                if _glob_match_path_rec(p, next_p, s, try_s) == 1
                    return 1
                end
                try_s += 1
            end
            return 0
        end

        # Check for * (single star - does NOT cross /)
        if pch == "*"
            let next_p: int = p_idx + 1
            let try_s: int = s_idx
            while try_s <= slen
                let res: int = _glob_match_path_rec(p, next_p, s, try_s)
                if res == 1
                    return 1
                end
                if try_s < slen
                    let cur_ch: string = char_at(s, try_s)
                    if cur_ch == "/"
                        return 0
                    end
                end
                try_s += 1
            end
            return 0
        end

        if s_idx >= slen
            return 0
        end

        let sch: string = char_at(s, s_idx)

        if pch == "?"
            if sch == "/"
                return 0
            end
            p_idx += 1
            s_idx += 1
        elif pch == "["
            let close_bracket: int = _glob_find(p, "]", p_idx + 1)
            if close_bracket < 0
                if pch != sch return 0 end
                p_idx += 1
                s_idx += 1
            else
                let class_content: string = substring(p, p_idx + 1, close_bracket - (p_idx + 1))
                let matched_class: int = _glob_match_class(class_content, sch)
                if matched_class == 0
                    return 0
                end
                p_idx = close_bracket + 1
                s_idx += 1
            end
        elif pch == "\\"
            p_idx += 1
            if p_idx >= plen return 0 end
            pch = char_at(p, p_idx)
            if pch != sch return 0 end
            p_idx += 1
            s_idx += 1
        else
            if pch != sch
                return 0
            end
            p_idx += 1
            s_idx += 1
        end
    end

    if s_idx == slen
        return 1
    end
    return 0
end

function _glob_match_simple_rec(p: string, p_idx: int, s: string, s_idx: int) -> int
    let plen: int = len(p)
    let slen: int = len(s)

    while p_idx < plen
        let pch: string = char_at(p, p_idx)

        if pch == "*"
            let next_p: int = p_idx + 1
            let try_s: int = s_idx
            while try_s <= slen
                if _glob_match_simple_rec(p, next_p, s, try_s) == 1
                    return 1
                end
                try_s += 1
            end
            return 0
        end

        if s_idx >= slen
            return 0
        end

        let sch: string = char_at(s, s_idx)

        if pch == "?"
            p_idx += 1
            s_idx += 1
        elif pch == "["
            let close_bracket: int = _glob_find(p, "]", p_idx + 1)
            if close_bracket < 0
                if pch != sch return 0 end
                p_idx += 1
                s_idx += 1
            else
                let class_content: string = substring(p, p_idx + 1, close_bracket - (p_idx + 1))
                let matched_class: int = _glob_match_class(class_content, sch)
                if matched_class == 0
                    return 0
                end
                p_idx = close_bracket + 1
                s_idx += 1
            end
        elif pch == "\\"
            p_idx += 1
            if p_idx >= plen return 0 end
            pch = char_at(p, p_idx)
            if pch != sch return 0 end
            p_idx += 1
            s_idx += 1
        else
            if pch != sch
                return 0
            end
            p_idx += 1
            s_idx += 1
        end
    end

    if s_idx == slen
        return 1
    end
    return 0
end

pub function glob_match(pattern: string, text: string) -> int
    return _glob_match_path_rec(str_from_ptr(pattern), 0, str_from_ptr(text), 0)
end

pub function glob_match_simple(pattern: string, text: string) -> int
    return _glob_match_simple_rec(str_from_ptr(pattern), 0, str_from_ptr(text), 0)
end

pub function fnmatch(pattern: string, text: string) -> int
    return glob_match_simple(pattern, text)
end

pub function glob_filter(pattern: string, list: string[]) -> string[]
    let res: string[] = []
    let total: int = array_len(list)
    let i: int = 0
    while i < total
        let item: string = str_from_ptr(list[i])
        if glob_match(pattern, item) == 1
            res.push(item)
        end
        i += 1
    end
    return res
end

pub function glob_is_pattern(pattern: string) -> int
    let s: string = str_from_ptr(pattern)
    let slen: int = len(s)
    let i: int = 0
    while i < slen
        let ch: string = char_at(s, i)
        if ch == "*" or ch == "?" or ch == "[" or ch == "{"
            return 1
        end
        i += 1
    end
    return 0
end

pub function glob_escape(s: string) -> string
    let text: string = str_from_ptr(s)
    let tlen: int = len(text)
    let res: string = ""
    let i: int = 0
    while i < tlen
        let ch: string = char_at(text, i)
        if ch == "*" or ch == "?" or ch == "[" or ch == "]" or ch == "{" or ch == "}" or ch == "\\"
            res = res + "\\" + ch
        else
            res = res + ch
        end
        i += 1
    end
    return res
end

function _glob_read_lines(file_path: string) -> string[]
    if file_exists(file_path) == 0
        return []
    end
    let content: string = read_file(file_path)
    let raw_lines = split(content, "\n")
    let count: int = array_len(raw_lines)
    let res: string[] = []
    let i: int = 0
    while i < count
        let line: string = str_from_ptr(raw_lines[i])
        let llen: int = len(line)
        if llen > 0 and char_at(line, llen - 1) == "\r"
            line = substring(line, 0, llen - 1)
        end
        if len(line) > 0
            res.push(line)
        end
        i += 1
    end
    return res
end

pub function glob_dir(pattern: string, dir_path: string) -> string[]
    let d: string = str_from_ptr(dir_path)
    let raw_lines = list_dir(d)
    return glob_filter(pattern, raw_lines)
end

pub function glob(pattern: string) -> string[]
    return glob_dir(pattern, ".")
end
