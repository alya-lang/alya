# Alya Standard Library - Process Module (std/process)
# Provides subprocess spawning, execution, stream piping, and exit code handling.
# Usage: import "std/process"

# --- Types ---

## Handle to a background process: process id plus the command line.
pub struct ProcessHandle
    pid: int
    command: string
end

## Captured result of a finished process: exit code with stdout and stderr text.
pub struct ProcessOutput
    exit_code: int
    stdout: string
    stderr: string
end

# --- Constructors ---

## Executes program with args, waiting for completion and capturing stdout and stderr.
pub function process_run(program: string, args: string[] = []) -> ProcessOutput
    let pid: int = __native_get_pid()
    let now_ms: int = clock_ms()
    let out_file: string = f"temp_proc_out_{pid}_{now_ms}.tmp"
    let err_file: string = f"temp_proc_err_{pid}_{now_ms}.tmp"

    let cmd: string = program
    for arg in args
        cmd = f"{cmd} {arg}"
    end

    cmd = f"{cmd} > {out_file} 2> {err_file}"
    let exit_code: int = system_exec(cmd)

    let out_content: string = ""
    if file_exists(out_file) == 1
        out_content = read_file(out_file)
        remove_file(out_file)
    end

    let err_content: string = ""
    if file_exists(err_file) == 1
        err_content = read_file(err_file)
        remove_file(err_file)
    end

    return ProcessOutput { exit_code: exit_code, stdout: out_content, stderr: err_content }
end

## Spawns program with args in the background without waiting for completion.
pub function process_spawn(program: string, args: string[] = []) -> ProcessHandle
    let cmd: string = program
    for arg in args
        cmd = f"{cmd} {arg}"
    end
    let bg_cmd: string = when target_os()
        is "windows" => f"start /B {cmd}"
        else => f"{cmd} &"
    end
    let code: int = system_exec(bg_cmd)
    return ProcessHandle { pid: code, command: cmd }
end

# --- Methods ---

## Returns true when the process exited with code 0.
pub function ProcessOutput.is_ok(self: ProcessOutput) -> bool
    return self.exit_code == 0
end

# --- Utilities ---

## Exits the current process with the given code.
pub function process_exit(code: int = 0)
    exit(code)
end

## Returns the current process id.
pub function process_pid() -> int
    return __native_get_pid()
end

# --- Legacy Aliases ---

## Legacy alias of process_run.
pub function process__run(program: string, args: string[] = []) -> ProcessOutput
    return process_run(program, args)
end

## Legacy alias of process_spawn.
pub function process__spawn(program: string, args: string[] = []) -> ProcessHandle
    return process_spawn(program, args)
end
