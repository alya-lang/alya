# Alya Standard Library - Collections Module
# Provides common data structures: Stack, Queue, and Set.

# 1. Stack (LIFO)
pub function stack_new()
    return []
end

pub function stack_push(s, val)
    s.push(val)
end

pub function stack_pop(s)
    return s.pop()
end

pub function stack_peek(s)
    let count = len(s)
    if count == 0
        return 0
    end
    return s[count - 1]
end

pub function stack_size(s)
    return len(s)
end

pub function stack_is_empty(s)
    return len(s) == 0
end

# 2. Queue (FIFO) - O(1) amortized queue using head pointer and compaction
pub function queue_new()
    return [1]
end

pub function queue_push(q, val)
    q.push(val)
end

pub function queue_pop(q)
    let head = q[0]
    let total = len(q)
    if head >= total
        return 0
    end
    let first = q[head]
    head += 1
    q[0] = head
    if head > 32 and (head * 2) >= total
        let count = total - head
        let i = 0
        while i < count
            q[i + 1] = q[head + i]
            i += 1
        end
        q[0] = 1
        while len(q) > count + 1
            q.pop()
        end
    end
    return first
end

pub function queue_peek(q)
    let head = q[0]
    if head >= len(q)
        return 0
    end
    return q[head]
end

pub function queue_size(q)
    let sz = len(q) - q[0]
    if sz < 0
        return 0
    end
    return sz
end

pub function queue_is_empty(q)
    return q[0] >= len(q)
end

pub function queue_clear(q)
    while len(q) > 1
        q.pop()
    end
    q[0] = 1
end

pub function queue_to_array(q)
    let res = []
    let head = q[0]
    let total = len(q)
    let i = head
    while i < total
        res.push(q[i])
        i += 1
    end
    return res
end

# 3. Set (Unique items)
pub function set_new()
    return {}
end

pub function set_add(s, item)
    s[item] = 1
end

pub function set_has(s, item)
    return s.has(item)
end

pub function set_remove(s, item)
    return remove(s, item)
end

pub function set_size(s)
    return len(s)
end

pub function set_to_array(s)
    return keys(s)
end

pub function set_clear(s)
    for k in keys(s)
        remove(s, k)
    end
end

pub function set_from_array(arr)
    let s = {}
    for item in arr
        s[item] = 1
    end
    return s
end

pub function set_union(a, b)
    let res = {}
    for k in keys(a)
        res[k] = 1
    end
    for k in keys(b)
        res[k] = 1
    end
    return res
end

pub function set_intersection(a, b)
    let res = {}
    for k in keys(a)
        if b.has(k)
            res[k] = 1
        end
    end
    return res
end

pub function set_difference(a, b)
    let res = {}
    for k in keys(a)
        if not b.has(k)
            res[k] = 1
        end
    end
    return res
end

pub function set_is_subset(a, b)
    for k in keys(a)
        if not b.has(k)
            return 0
        end
    end
    return 1
end

# 4. Array Utilities
pub function array_contains(arr, val)
    for item in arr
        if item == val
            return 1
        end
    end
    return 0
end

pub function array_index_of(arr, val)
    let count = len(arr)
    let i = 0
    while i < count
        if arr[i] == val
            return i
        end
        i += 1
    end
    return -1
end

pub function array_last_index_of(arr, val)
    let i = len(arr) - 1
    while i >= 0
        if arr[i] == val
            return i
        end
        i -= 1
    end
    return -1
end

pub function array_slice(arr, start_idx, end_idx)
    let res = []
    let total = len(arr)
    if start_idx < 0
        start_idx = 0
    end
    if end_idx > total
        end_idx = total
    end
    let i = start_idx
    while i < end_idx
        res.push(arr[i])
        i += 1
    end
    return res
end

pub function array_clone(arr)
    let res = []
    for x in arr
        res.push(x)
    end
    return res
end

pub function array_concat(a, b)
    let res = []
    for x in a
        res.push(x)
    end
    for y in b
        res.push(y)
    end
    return res
end

pub function array_reverse(arr)
    let res = []
    let i = len(arr) - 1
    while i >= 0
        res.push(arr[i])
        i -= 1
    end
    return res
end

pub function array_reverse_in_place(arr)
    let left = 0
    let right = len(arr) - 1
    let temp = 0
    while left < right
        temp = arr[left]
        arr[left] = arr[right]
        arr[right] = temp
        left += 1
        right -= 1
    end
    return arr
end

pub function array_unique(arr)
    let seen = {}
    let res = []
    for x in arr
        if not seen.has(x)
            seen[x] = 1
            res.push(x)
        end
    end
    return res
end

pub function array_min(arr)
    let count = len(arr)
    if count == 0
        return 0
    end
    let m = arr[0]
    let i = 1
    while i < count
        if arr[i] < m
            m = arr[i]
        end
        i += 1
    end
    return m
end

pub function array_max(arr)
    let count = len(arr)
    if count == 0
        return 0
    end
    let m = arr[0]
    let i = 1
    while i < count
        if arr[i] > m
            m = arr[i]
        end
        i += 1
    end
    return m
end

pub function array_sort_in_place(arr)
    let n = len(arr)
    let i = 0
    let j = 0
    let temp = 0
    while i < n
        j = 0
        while j < n - i - 1
            if arr[j] > arr[j + 1]
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            end
            j += 1
        end
        i += 1
    end
    return arr
end

pub function array_sort(arr)
    let copy = array_clone(arr)
    return array_sort_in_place(copy)
end

pub function array_chunk(arr, chunk_size)
    let res = []
    if chunk_size <= 0
        return res
    end
    let total = len(arr)
    let i = 0
    let j = 0
    let chunk = []
    while i < total
        chunk = []
        j = 0
        while j < chunk_size and (i + j) < total
            chunk.push(arr[i + j])
            j += 1
        end
        res.push(chunk)
        i += chunk_size
    end
    return res
end

pub function array_fill(val, count)
    let res = []
    let i = 0
    while i < count
        res.push(val)
        i += 1
    end
    return res
end

# 5. Map Utilities
pub function map_clone(m)
    let res = {}
    for k in keys(m)
        res[k] = m[k]
    end
    return res
end

pub function map_merge(dest, src)
    let res = map_clone(dest)
    for k in keys(src)
        res[k] = src[k]
    end
    return res
end

pub function map_is_empty(m)
    return len(m) == 0
end

pub function map_entries(m)
    let res = []
    for k in keys(m)
        res.push([k, m[k]])
    end
    return res
end

pub function map_from_entries(entries)
    let res = {}
    for pair in entries
        if len(pair) >= 2
            res[pair[0]] = pair[1]
        end
    end
    return res
end
