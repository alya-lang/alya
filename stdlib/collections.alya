# Alya Standard Library - Collections Module
# Provides common data structures: Stack, Queue, and Set.

# 1. Stack (LIFO)
pub struct Stack
end

pub function Stack.new()
    return []
end

pub function stack_new()
    return []
end

pub function stack_push(s, val)
    s.push(val)
end

pub function stack_pop(s)
    return s.pop()
end

pub function stack_peek(s)
    let count: int = len(s)
    if count == 0
        return 0
    end
    return s[count - 1]
end

pub function stack_size(s) -> int
    return len(s)
end

pub function stack_is_empty(s) -> int
    if len(s) == 0
        return 1
    end
    return 0
end

# 2. Queue (FIFO) - O(1) amortized queue using head pointer and compaction
pub struct Queue
end

pub function Queue.new()
    return queue_new()
end

pub function queue_new()
    return [1]
end

pub function queue_push(q, val)
    q.push(val)
end

pub function queue_pop(q)
    let head: int = q[0]
    let total: int = len(q)
    if head >= total
        return 0
    end
    let first = q[head]
    head += 1
    q[0] = head
    if head > 32 and (head * 2) >= total
        let count: int = total - head
        let i: int = 0
        while i < count
            q[i + 1] = q[head + i]
            i += 1
        end
        q[0] = 1
        while len(q) > count + 1
            q.pop()
        end
    end
    return first
end

pub function queue_peek(q)
    let head: int = q[0]
    if head >= len(q)
        return 0
    end
    return q[head]
end

pub function queue_size(q) -> int
    let sz: int = len(q) - q[0]
    if sz < 0
        return 0
    end
    return sz
end

pub function queue_is_empty(q) -> int
    if q[0] >= len(q)
        return 1
    end
    return 0
end

pub function queue_clear(q)
    while len(q) > 1
        q.pop()
    end
    q[0] = 1
end

pub function queue_to_array(q)
    let res = []
    let head: int = q[0]
    let total: int = len(q)
    let i: int = head
    while i < total
        res.push(q[i])
        i += 1
    end
    return res
end

# 3. Set (Unique items)
pub struct Set
end

pub function Set.new()
    return set_new()
end

pub function set_new()
    return {}
end

pub function set_add(s, item)
    s[item] = 1
end

pub function set_has(s, item) -> int
    if item in s
        return 1
    end
    return 0
end

pub function set_remove(s, item)
    return remove(s, item)
end

pub function set_size(s) -> int
    return len(s)
end

pub function set_to_array(s)
    return keys(s)
end

pub function set_clear(s)
    for k in keys(s)
        remove(s, k)
    end
end

pub function set_from_array(arr)
    let s = {}
    for item in arr
        s[item] = 1
    end
    return s
end

pub function set_union(a, b)
    let res = {}
    for k in keys(a)
        res[k] = 1
    end
    for k in keys(b)
        res[k] = 1
    end
    return res
end

pub function set_intersection(a, b)
    let res = {}
    for k in keys(a)
        if k in b
            res[k] = 1
        end
    end
    return res
end

pub function set_difference(a, b)
    let res = {}
    for k in keys(a)
        if k not in b
            res[k] = 1
        end
    end
    return res
end

pub function set_is_subset(a, b) -> int
    for k in keys(a)
        if k not in b
            return 0
        end
    end
    return 1
end

# 4. Array Utilities
pub function array_contains(arr, val) -> int
    if val in arr
        return 1
    end
    return 0
end

pub function array_index_of(arr, val) -> int
    for i, item in arr
        if item == val
            return i
        end
    end
    return -1
end

pub function array_last_index_of(arr, val) -> int
    let i: int = len(arr) - 1
    while i >= 0
        if arr[i] == val
            return i
        end
        i -= 1
    end
    return -1
end

pub function array_slice(arr, start_idx: int, end_idx: int)
    let total: int = len(arr)
    if start_idx < 0
        start_idx = 0
    end
    if end_idx > total
        end_idx = total
    end
    if start_idx >= end_idx
        return []
    end
    return arr[start_idx..end_idx]
end

pub function array_clone(arr)
    return [...arr]
end

pub function array_concat(a, b)
    return [...a, ...b]
end

pub function array_reverse(arr)
    let res = []
    let i: int = len(arr) - 1
    while i >= 0
        res.push(arr[i])
        i -= 1
    end
    return res
end

pub function array_reverse_in_place(arr)
    let left: int = 0
    let right: int = len(arr) - 1
    let temp = 0
    while left < right
        temp = arr[left]
        arr[left] = arr[right]
        arr[right] = temp
        left += 1
        right -= 1
    end
    return arr
end

pub function array_unique(arr)
    let seen = {}
    let res = []
    for x in arr
        if x not in seen
            seen[x] = 1
            res.push(x)
        end
    end
    return res
end

pub function array_min(arr)
    let count: int = len(arr)
    if count == 0
        return 0
    end
    let m = arr[0]
    let i: int = 1
    while i < count
        if arr[i] < m
            m = arr[i]
        end
        i += 1
    end
    return m
end

pub function array_max(arr)
    let count: int = len(arr)
    if count == 0
        return 0
    end
    let m = arr[0]
    let i: int = 1
    while i < count
        if arr[i] > m
            m = arr[i]
        end
        i += 1
    end
    return m
end

pub function array_sort_in_place(arr)
    let n: int = len(arr)
    let i: int = 0
    let j: int = 0
    let temp = 0
    while i < n
        j = 0
        while j < n - i - 1
            if arr[j] > arr[j + 1]
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            end
            j += 1
        end
        i += 1
    end
    return arr
end

pub function array_sort(arr)
    let copy = array_clone(arr)
    return array_sort_in_place(copy)
end

pub function array_chunk(arr, chunk_size: int)
    let res = []
    if chunk_size <= 0
        return res
    end
    let total: int = len(arr)
    let i: int = 0
    let j: int = 0
    let chunk = []
    while i < total
        chunk = []
        j = 0
        while j < chunk_size and (i + j) < total
            chunk.push(arr[i + j])
            j += 1
        end
        res.push(chunk)
        i += chunk_size
    end
    return res
end

pub function array_fill(val, count: int)
    let res = []
    let i: int = 0
    while i < count
        res.push(val)
        i += 1
    end
    return res
end

# 5. Map Utilities
pub function map_clone(m)
    let res = {}
    for k, v in m
        res[k] = v
    end
    return res
end

pub function map_merge(dest, src)
    let res = map_clone(dest)
    for k, v in src
        res[k] = v
    end
    return res
end

pub function map_is_empty(m) -> int
    if len(m) == 0
        return 1
    end
    return 0
end

pub function map_entries(m)
    let res = []
    for k, v in m
        res.push([k, v])
    end
    return res
end

pub function map_from_entries(entries)
    let res = {}
    for pair in entries
        if len(pair) >= 2
            let k, v = pair
            res[k] = v
        end
    end
    return res
end
