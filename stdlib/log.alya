# Alya Standard Library - Logging Module (std/log)
# Lightweight console logger with leveled output, ANSI colored badges, and timestamps.
#
# NOTE: For advanced features such as structured JSON logging, size-based
# file rotation, and multi-appender pipelines, use the official package:
#   alya-lang/logger (alyac add logger)

import "std/color"

# --- Log Level Enum ---

pub enum LogLevel
    Debug = 1
    Info = 2
    Warn = 3
    Error = 4
    Fatal = 5
    Off = 6
end

# Log Levels (backward compatibility constants)
pub let LOG_DEBUG = LogLevel.Debug
pub let LOG_INFO = LogLevel.Info
pub let LOG_WARN = LogLevel.Warn
pub let LOG_ERROR = LogLevel.Error
pub let LOG_FATAL = LogLevel.Fatal
pub let LOG_OFF = LogLevel.Off

pub struct Logger
    log_name
    log_level
    log_colored
    log_timestamps
    log_file
end

pub function log_level_name(lvl)
    when lvl
        is LogLevel.Debug then return "DEBUG"
        is LogLevel.Info then return "INFO"
        is LogLevel.Warn then return "WARN"
        is LogLevel.Error then return "ERROR"
        is LogLevel.Fatal then return "FATAL"
        is LogLevel.Off then return "OFF"
        else return "LOG"
    end
end

pub function log_level_from_str(s)
    let up = upper(s)
    when up
        is "DEBUG" then return LogLevel.Debug
        is "INFO" then return LogLevel.Info
        is "WARN" then return LogLevel.Warn
        is "WARNING" then return LogLevel.Warn
        is "ERROR" then return LogLevel.Error
        is "FATAL" then return LogLevel.Fatal
        is "OFF" then return LogLevel.Off
        else return LogLevel.Info
    end
end

function _log_pad2(n)
    if n < 10
        return "0" + str(n)
    end
    return str(n)
end

function _log_timestamp()
    let now = time() % 86400
    let hh = (now / 3600) % 24
    let mm = (now / 60) % 60
    let ss = now % 60
    return _log_pad2(hh) + ":" + _log_pad2(mm) + ":" + _log_pad2(ss)
end

pub function logger_new(name, level)
    return Logger(name, level, 1, 0, "")
end

pub function logger_set_level(l, level)
    l.log_level = level
end

pub function logger_set_colored(l, colored)
    l.log_colored = colored
end

pub function logger_set_timestamps(l, timestamps)
    l.log_timestamps = timestamps
end

pub function logger_set_file(l, file_path)
    l.log_file = file_path
end

pub function logger_log(l, level, message)
    if level < l.log_level
        return 0
    end

    let badge = "[" + log_level_name(level) + "]"
    while len(badge) < 7
        badge = badge + " "
    end

    let colored_badge = badge
    if l.log_colored == 1
        if level == 1
            colored_badge = color_cyan(badge)
        elif level == 2
            colored_badge = color_green(badge)
        elif level == 3
            colored_badge = color_yellow(badge)
        elif level == 4
            colored_badge = color_red(badge)
        elif level == 5
            colored_badge = style_bold(color_bright_red(badge))
        end
    end

    let prefix = ""
    if l.log_timestamps == 1
        prefix = prefix + "[" + _log_timestamp() + "] "
    end
    let name_str = str_from_ptr(l.log_name)
    if len(name_str) > 0
        if l.log_colored == 1
            prefix = prefix + color_magenta("[" + name_str + "]") + " "
        else
            prefix = prefix + "[" + name_str + "] "
        end
    end

    let full_msg = prefix + colored_badge + " " + str_from_ptr(message)
    say full_msg

    let fpath = str_from_ptr(l.log_file)
    if len(fpath) > 0
        let plain = ansi_strip(full_msg) + "\n"
        append_file(fpath, plain)
    end
    return 1
end

pub function logger_debug(l, msg) return logger_log(l, 1, msg) end
pub function logger_info(l, msg)  return logger_log(l, 2, msg) end
pub function logger_warn(l, msg)  return logger_log(l, 3, msg) end
pub function logger_error(l, msg) return logger_log(l, 4, msg) end
pub function logger_fatal(l, msg) return logger_log(l, 5, msg) end

# Direct top-level functions
pub function log_debug(msg) say color_cyan("[DEBUG] ") + str_from_ptr(msg) end
pub function log_info(msg)  say color_green("[INFO]  ") + str_from_ptr(msg) end
pub function log_warn(msg)  say color_yellow("[WARN]  ") + str_from_ptr(msg) end
pub function log_error(msg) say color_red("[ERROR] ") + str_from_ptr(msg) end
pub function log_fatal(msg) say style_bold(color_bright_red("[FATAL] ")) + str_from_ptr(msg) end

# --- Logger Struct Methods ---
pub function Logger.set_level(self, level)
    logger_set_level(self, level)
end

pub function Logger.set_colored(self, colored)
    logger_set_colored(self, colored)
end

pub function Logger.set_timestamps(self, timestamps)
    logger_set_timestamps(self, timestamps)
end

pub function Logger.set_file(self, file_path)
    logger_set_file(self, file_path)
end

pub function Logger.log(self, level, message)
    return logger_log(self, level, message)
end

pub function Logger.debug(self, msg) return logger_debug(self, msg) end
pub function Logger.info(self, msg)  return logger_info(self, msg) end
pub function Logger.warn(self, msg)  return logger_warn(self, msg) end
pub function Logger.error(self, msg) return logger_error(self, msg) end
pub function Logger.fatal(self, msg) return logger_fatal(self, msg) end
