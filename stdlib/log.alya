##
## ### Returns
## 0 (implicit return; no meaningful value is produced).
pub function Logger.set_file(self: Logger, file_path: string)
    logger_set_file(self, file_path)
end

## Sets the minimum level that this logger emits.
##
## ### Parameters
## - `self`: Logger to configure.
## - `level`: Minimum numeric severity emitted; lower levels are filtered.
##
## ### Returns
## 0 (implicit return; no meaningful value is produced).
pub function Logger.set_level(self: Logger, level: int)
    logger_set_level(self, level)
end

## Enables or disables timestamp prefixes on this logger.
##
## ### Parameters
## - `self`: Logger to configure.
## - `timestamps`: 1 enables `[HH:MM:SS]` prefixes, other values disable them.
##
## ### Returns
## 0 (implicit return; no meaningful value is produced).
pub function Logger.set_timestamps(self: Logger, timestamps: int)
    logger_set_timestamps(self, timestamps)
end

## Logs msg at warn level through this logger.
##
## ### Parameters
## - `self`: Logger emitting the message.
## - `msg`: Message text.
##
## ### Returns
## 1 when the message is written, or 0 when filtered by the logger level.
pub function Logger.warn(self: Logger, msg: string) -> int  return logger_warn(self, msg) end
