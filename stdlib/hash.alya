# Alya Standard Library - Hash Module
# Provides hashing algorithms (FNV-1a, DJB2, CRC-32, Adler-32, SDBM) and encoding/decoding utilities (Base64, Hex).

function djb2(s)
    let slen = len(s)
    let h = 5381
    let i = 0
    while i < slen
        h = bit_and((bit_shl(h, 5) + h) + ord(char_at(s, i)), 2147483647)
        i += 1
    end
    return h
end

function fnv1a(s)
    let slen = len(s)
    let h = 2166136261
    let i = 0
    while i < slen
        h = bit_and(bit_xor(h, ord(char_at(s, i))) * 16777619, 2147483647)
        i += 1
    end
    return h
end

function hex_encode(s)
    let hex_chars = "0123456789abcdef"
    let slen = len(s)
    let res = ""
    let i, c, hi, lo = 0
    while i < slen
        c = ord(char_at(s, i))
        hi = bit_and(bit_shr(c, 4), 15)
        lo = bit_and(c, 15)
        res = res + char_at(hex_chars, hi) + char_at(hex_chars, lo)
        i += 1
    end
    return res
end

function _hex_val(ch)
    let c = ord(ch)
    when c
        is 48..57 then return c - 48
        is 97..102 then return c - 87
        is 65..70 then return c - 55
        else return 0
    end
end

function hex_decode(s)
    let slen = len(s)
    let res = ""
    let i, hi, lo, b = 0
    while i + 1 < slen
        hi = _hex_val(char_at(s, i))
        lo = _hex_val(char_at(s, i + 1))
        b = bit_or(bit_shl(hi, 4), lo)
        res = res + chr(b)
        i += 2
    end
    return res
end

function base64_encode(s)
    let b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let slen = len(s)
    let res = ""
    let i, b0, b1, b2, has_b1, has_b2, idx0, idx1, idx2, idx3 = 0
    while i < slen
        b0 = ord(char_at(s, i))
        b1 = 0
        b2 = 0
        has_b1 = 0
        has_b2 = 0
        if i + 1 < slen
            b1 = ord(char_at(s, i + 1))
            has_b1 = 1
        end
        if i + 2 < slen
            b2 = ord(char_at(s, i + 2))
            has_b2 = 1
        end

        idx0 = bit_and(bit_shr(b0, 2), 63)
        idx1 = bit_and(bit_or(bit_shl(bit_and(b0, 3), 4), bit_shr(b1, 4)), 63)
        idx2 = bit_and(bit_or(bit_shl(bit_and(b1, 15), 2), bit_shr(b2, 6)), 63)
        idx3 = bit_and(b2, 63)

        res = res + char_at(b64_chars, idx0)
        res = res + char_at(b64_chars, idx1)
        if has_b1
            res = res + char_at(b64_chars, idx2)
        else
            res = res + "="
        end
        if has_b2
            res = res + char_at(b64_chars, idx3)
        else
            res = res + "="
        end
        i += 3
    end
    return res
end

function _b64_val(ch)
    let c = ord(ch)
    when c
        is 65..90 then return c - 65
        is 97..122 then return c - 71
        is 48..57 then return c + 4
        is 43 then return 62
        is 47 then return 63
        else return 0
    end
end

function base64_decode(s)
    let slen = len(s)
    let res = ""
    let i, v0, v1, v2, v3, b0, b1, b2 = 0
    let c0, c1, c2, c3 = ""
    while i + 3 < slen
        c0 = char_at(s, i)
        c1 = char_at(s, i + 1)
        c2 = char_at(s, i + 2)
        c3 = char_at(s, i + 3)

        v0 = _b64_val(c0)
        v1 = _b64_val(c1)
        v2 = _b64_val(c2)
        v3 = _b64_val(c3)

        b0 = bit_or(bit_shl(v0, 2), bit_and(bit_shr(v1, 4), 3))
        res = res + chr(b0)

        if c2 != "="
            b1 = bit_and(bit_or(bit_shl(bit_and(v1, 15), 4), bit_shr(v2, 2)), 255)
            res = res + chr(b1)
        end
        if c3 != "="
            b2 = bit_and(bit_or(bit_shl(bit_and(v2, 3), 6), v3), 255)
            res = res + chr(b2)
        end
        i += 4
    end
    return res
end

function crc32(s)
    let slen = len(s)
    let crc = 4294967295
    let i = 0
    let j = 0
    let byte = 0
    let mask = 0
    while i < slen
        byte = ord(char_at(s, i))
        crc = bit_xor(crc, byte)
        j = 0
        while j < 8
            mask = bit_and(crc, 1)
            crc = bit_shr(crc, 1)
            if mask != 0
                crc = bit_xor(crc, 3988292384)
            end
            j += 1
        end
        i += 1
    end
    return bit_xor(crc, 4294967295)
end

function adler32(s)
    let slen = len(s)
    let a = 1
    let b = 0
    let i = 0
    while i < slen
        a = (a + ord(char_at(s, i))) % 65521
        b = (b + a) % 65521
        i += 1
    end
    return bit_or(bit_shl(b, 16), a)
end

function sdbm(s)
    let slen = len(s)
    let h = 0
    let i = 0
    let c = 0
    while i < slen
        c = ord(char_at(s, i))
        h = c + bit_shl(h, 6) + bit_shl(h, 16) - h
        h = bit_and(h, 2147483647)
        i += 1
    end
    return h
end

function hash_combine(h1, h2)
    let combined = bit_xor(h1, h2 + 2654435769 + bit_shl(h1, 6) + bit_shr(h1, 2))
    return bit_and(combined, 2147483647)
end

function is_hex(s)
    let slen = len(s)
    if slen == 0 or slen % 2 != 0
        return 0
    end
    let i = 0
    let c = 0
    let is_d = 0
    let is_l = 0
    let is_u = 0
    while i < slen
        c = ord(char_at(s, i))
        is_d = c >= 48 and c <= 57
        is_l = c >= 97 and c <= 102
        is_u = c >= 65 and c <= 70
        if not is_d and not is_l and not is_u
            return 0
        end
        i += 1
    end
    return 1
end

function is_base64(s)
    let slen = len(s)
    if slen == 0 or slen % 4 != 0
        return 0
    end
    let i = 0
    let c = 0
    let is_u = 0
    let is_l = 0
    let is_d = 0
    let is_plus_slash = 0
    let is_pad = 0
    while i < slen
        c = ord(char_at(s, i))
        is_u = c >= 65 and c <= 90
        is_l = c >= 97 and c <= 122
        is_d = c >= 48 and c <= 57
        is_plus_slash = c == 43 or c == 47
        is_pad = c == 61
        if not is_u and not is_l and not is_d and not is_plus_slash and not is_pad
            return 0
        end
        i += 1
    end
    return 1
end

function to_hex(s)
    return hex_encode(s)
end

function from_hex(s)
    return hex_decode(s)
end

function to_base64(s)
    return base64_encode(s)
end

function from_base64(s)
    return base64_decode(s)
end
