# Alya Standard Library - Benchmark Module (std/bench)
# Provides BenchmarkDotNet-style micro-benchmarking, memory tracking, and performance reporting.

pub struct BenchRecord
    op_name: string
    op_iters: int
    op_elapsed: int
    op_alloc: int
    op_ns: int
    op_throughput: int
end

pub struct BenchRunner
    suite_name: string
    records: BenchRecord[]
    total_runs: int
    total_ms: int
    start_ms: int
    start_alloc: int
    run_iters: int
end

pub function bench_runner(name: string) -> BenchRunner
    say "=== Benchmark Suite: " + name + " ==="
    return BenchRunner(name, [], 0, 0, 0, 0, 0)
end

pub function bench_start(b: BenchRunner, iters: int)
    b.run_iters = iters
    b.start_alloc = mem_allocated()
    b.start_ms = clock_ms()
end

function _bench_format_thousands(n: int) -> string
    let s: string = str(n)
    let slen: int = len(s)
    if slen <= 3
        return s
    end
    let rem: int = slen % 3
    let res: string = ""
    let i: int = 0
    while i < slen
        if i > 0
            if i == rem
                res = res + ","
            else
                if i > rem
                    if (i - rem) % 3 == 0
                        res = res + ","
                    end
                end
            end
        end
        res = res + substring(s, i, 1)
        i += 1
    end
    return res
end

pub function bench_stop(b: BenchRunner, name: string) -> int
    let elapsed: int = clock_ms() - b.start_ms
    let end_alloc: int = mem_allocated()
    let alloc_diff: int = end_alloc - b.start_alloc
    if alloc_diff < 0
        alloc_diff = 0
    end
    let iters: int = b.run_iters
    if iters <= 0
        iters = 1
    end
    let safe_elapsed: int = elapsed
    if safe_elapsed < 1
        safe_elapsed = 1
    end
    let ns_per_op: int = (safe_elapsed * 1000000) / iters
    let ops_sec: int = (iters * 1000) / safe_elapsed
    let alloc_per_op: int = alloc_diff / iters

    say "  * " + name + ": " + _bench_format_thousands(iters) + " iters in " + str(elapsed) + " ms (~" + _bench_format_thousands(ns_per_op) + " ns/op | " + _bench_format_thousands(ops_sec) + " ops/sec)"

    let rec: BenchRecord = BenchRecord(name, iters, elapsed, alloc_per_op, ns_per_op, ops_sec)
    push(b.records, rec)
    b.total_runs += 1
    b.total_ms += elapsed
    return elapsed
end

pub function bench_measure(name: string, iters: int, elapsed_ms: int) -> int
    let safe_elapsed: int = elapsed_ms
    if safe_elapsed < 1
        safe_elapsed = 1
    end
    let ns_per_op: int = (safe_elapsed * 1000000) / iters
    let ops_sec: int = (iters * 1000) / safe_elapsed
    say "  * " + name + ": " + _bench_format_thousands(iters) + " iters in " + str(elapsed_ms) + " ms (~" + _bench_format_thousands(ns_per_op) + " ns/op | " + _bench_format_thousands(ops_sec) + " ops/sec)"
    return elapsed_ms
end

# Internal helpers for BenchmarkDotNet-style table formatting
function _bench_pad_right(s: string, width: int) -> string
    let res: string = str_from_ptr(s)
    let slen: int = len(res)
    while slen < width
        res = res + " "
        slen += 1
    end
    return res
end

function _bench_pad_left(s: string, width: int) -> string
    let res: string = str_from_ptr(s)
    let slen: int = len(res)
    while slen < width
        res = " " + res
        slen += 1
    end
    return res
end

function _bench_repeat(c: string, count: int) -> string
    let res: string = ""
    let i: int = 0
    while i < count
        res = res + c
        i += 1
    end
    return res
end

function _bench_format_alloc(bytes: int) -> string
    if bytes <= 0
        return "-"
    end
    if bytes < 1024
        return str(bytes) + " B"
    end
    if bytes < 1048576
        let kb_val: int = bytes / 1024
        return str(kb_val) + " KB"
    end
    let mb_val: int = bytes / 1048576
    return str(mb_val) + " MB"
end

function _bench_format_ns(ns: int) -> string
    if ns < 1000
        return str(ns) + " ns"
    end
    if ns < 1000000
        let us: int = ns / 1000
        let rem: int = (ns % 1000) / 100
        if rem > 0 and us < 100
            return str(us) + "." + str(rem) + " us"
        end
        return str(us) + " us"
    end
    let ms: int = ns / 1000000
    let ms_rem: int = (ns % 1000000) / 100000
    if ms_rem > 0 and ms < 100
        return str(ms) + "." + str(ms_rem) + " ms"
    end
    return str(ms) + " ms"
end

function _bench_format_throughput(ops: int) -> string
    if ops < 1000
        return str(ops) + " ops/s"
    end
    return _bench_format_thousands(ops) + " ops/s"
end

pub function bench_summary(b: BenchRunner)
    let num_records: int = b.total_runs
    if num_records > 0
        say "\n// * Summary *\n"
        say "Benchmark Suite: " + str_from_ptr(b.suite_name)
        say "Measurements   : " + str(num_records) + " methods\n"

        let baseline_rec = b.records[0]
        let baseline_ns: int = baseline_rec.op_ns
        if baseline_ns <= 0
            baseline_ns = 1
        end

        # Minimum column widths for headers
        let w_method: int = 6       # "Method"
        let w_mean: int = 12        # "Mean (ns/op)"
        let w_time: int = 10        # "Total Time"
        let w_ratio: int = 5        # "Ratio"
        let w_alloc: int = 9        # "Allocated"
        let w_tp: int = 10          # "Throughput"

        # Calculate max widths dynamically based on all row values
        let k: int = 0
        while k < num_records
            let r_k = b.records[k]
            let nlen: int = len(str_from_ptr(r_k.op_name))
            if nlen > w_method
                w_method = nlen
            end

            let mlen: int = len(_bench_format_ns(r_k.op_ns))
            if mlen > w_mean
                w_mean = mlen
            end

            let tlen: int = len(str(r_k.op_elapsed) + " ms")
            if tlen > w_time
                w_time = tlen
            end

            let r_val: int = (r_k.op_ns * 100) / baseline_ns
            let r_int: int = r_val / 100
            let r_dec: int = r_val % 100
            let r_str: string = str(r_int) + "."
            if r_dec < 10
                r_str = r_str + "0"
            end
            r_str = r_str + str(r_dec)
            let rlen: int = len(r_str)
            if rlen > w_ratio
                w_ratio = rlen
            end

            let alen: int = len(_bench_format_alloc(r_k.op_alloc))
            if alen > w_alloc
                w_alloc = alen
            end

            let tplen: int = len(_bench_format_throughput(r_k.op_throughput))
            if tplen > w_tp
                w_tp = tplen
            end

            k += 1
        end

        # Render Header
        let col_name_hdr: string = _bench_pad_right("Method", w_method)
        let col_mean_hdr: string = _bench_pad_left("Mean (ns/op)", w_mean)
        let col_time_hdr: string = _bench_pad_left("Total Time", w_time)
        let col_ratio_hdr: string = _bench_pad_left("Ratio", w_ratio)
        let col_alloc_hdr: string = _bench_pad_left("Allocated", w_alloc)
        let col_tp_hdr: string = _bench_pad_left("Throughput", w_tp)

        say "| " + col_name_hdr + " | " + col_mean_hdr + " | " + col_time_hdr + " | " + col_ratio_hdr + " | " + col_alloc_hdr + " | " + col_tp_hdr + " |"

        # Render Separator (each column has width W, so between pipes it is W + 2 chars)
        let sep_name: string = ":" + _bench_repeat("-", w_method + 1)
        let sep_mean: string = _bench_repeat("-", w_mean + 1) + ":"
        let sep_time: string = _bench_repeat("-", w_time + 1) + ":"
        let sep_ratio: string = _bench_repeat("-", w_ratio + 1) + ":"
        let sep_alloc: string = _bench_repeat("-", w_alloc + 1) + ":"
        let sep_tp: string = _bench_repeat("-", w_tp + 1) + ":"

        say "|" + sep_name + "|" + sep_mean + "|" + sep_time + "|" + sep_ratio + "|" + sep_alloc + "|" + sep_tp + "|"

        # Render Data Rows
        let i: int = 0
        while i < num_records
            let r = b.records[i]

            let ratio_val: int = (r.op_ns * 100) / baseline_ns
            let ratio_int: int = ratio_val / 100
            let ratio_dec: int = ratio_val % 100
            let ratio_str: string = str(ratio_int) + "."
            if ratio_dec < 10
                ratio_str = ratio_str + "0"
            end
            ratio_str = ratio_str + str(ratio_dec)

            let name_str: string = str_from_ptr(r.op_name)
            let col_name: string = _bench_pad_right(name_str, w_method)
            let col_mean: string = _bench_pad_left(_bench_format_ns(r.op_ns), w_mean)
            let col_time: string = _bench_pad_left(str(r.op_elapsed) + " ms", w_time)
            let col_ratio: string = _bench_pad_left(ratio_str, w_ratio)
            let col_alloc: string = _bench_pad_left(_bench_format_alloc(r.op_alloc), w_alloc)
            let col_tp: string = _bench_pad_left(_bench_format_throughput(r.op_throughput), w_tp)

            say "| " + col_name + " | " + col_mean + " | " + col_time + " | " + col_ratio + " | " + col_alloc + " | " + col_tp + " |"
            i += 1
        end

        say "\n// * Legends *"
        say "  Mean (ns/op) : Average elapsed time per single operation"
        say "  Total Time   : Total elapsed time across all iterations"
        say "  Ratio        : Time ratio relative to baseline (" + str_from_ptr(baseline_rec.op_name) + ")"
        say "  Allocated    : Allocated heap memory per single operation"
        say "  Throughput   : Operations executed per second\n"
    end

    let runs: string = str(b.total_runs)
    let ms: string = str(b.total_ms)
    say "----------------------------------------"
    say "Finished " + runs + " benchmark(s) in " + ms + " ms."
    say "========================================"
end

# --- BenchRunner Struct Methods ---
pub function BenchRunner.start(self: BenchRunner, iters: int)
    bench_start(self, iters)
end

pub function BenchRunner.stop(self: BenchRunner, name: string) -> int
    return bench_stop(self, name)
end

pub function BenchRunner.summary(self: BenchRunner)
    bench_summary(self)
end
