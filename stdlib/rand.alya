# Alya Standard Library - Random Module (std/rand)
# Provides lightweight pseudo-random number generator (PRNG / LCG)
# for basic scripting, ranges, floats, and probability checks.
#
# NOTE: For advanced PRNG engines (SplitMix64, Xorshift64, PCG32),
# statistical distributions (Gaussian, Exponential), sampling, and
# UUID v4/v7 or ULID/NanoID generation, use the official packages:
#   alya-lang/rand (alyac add rand)
#   alya-lang/uuid (alyac add uuid)

# --- Global PRNG Seeding & State ---

pub function rand_seed_state(s)
    rand_seed(s)
end

pub function rand_auto_seed()
    let s = (time() * 1000) + (clock_ms() % 1000) + rand()
    rand_seed(s)
end

# Generates a pseudo-random integer in the range [0, 2147483647] using the global PRNG.
pub function rand_next()
    let r = rand()
    if r < 0
        r = 0 - r
    end
    return r
end

# Generates a pseudo-random integer in the inclusive range [min_val, max_val].
pub function rand_int(min_val, max_val)
    if min_val >= max_val
        return min_val
    end
    let r = rand_next()
    let range = (max_val - min_val) + 1
    return min_val + (r % range)
end

# Generates a pseudo-random float in the range [0.0, 1.0).
pub function rand_float()
    let r = rand_next() % 1000000000
    return r / 1000000000.0
end

# Generates a pseudo-random float in the range [min_val, max_val).
pub function rand_float_range(min_val, max_val)
    if min_val >= max_val
        return min_val
    end
    let f = rand_float()
    return min_val + (f * (max_val - min_val))
end

# Returns 1 or 0 with 50% probability.
pub function rand_bool()
    return rand_next() % 2
end

# Returns 1 if an event with probability 'pct' (0..100) occurs, else 0.
pub function rand_chance(pct)
    if pct <= 0
        return 0
    end
    if pct >= 100
        return 1
    end
    return (rand_next() % 100) < pct
end

# --- Basic Collection Helpers ---

# Returns a randomly selected element from 'arr'.
pub function rand_choice(arr)
    let n = len(arr)
    if n == 0
        return 0
    end
    let idx = rand_int(0, n - 1)
    return arr[idx]
end
