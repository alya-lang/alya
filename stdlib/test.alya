# Alya Standard Library - Test Module
# Provides micro-testing and assertion utilities.

pub function test_suite(name)
    say "=== Test Suite: {name} ==="
end

pub function assert(cond, msg)
    if cond
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg}"
        return 0
    end
end

pub function assert_eq(actual, expected, msg)
    if actual == expected
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (expected: {expected}, got: {actual})"
        return 0
    end
end

pub function assert_ne(actual, expected, msg)
    if actual != expected
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (expected not: {expected})"
        return 0
    end
end

pub function assert_str_eq(actual, expected, msg)
    if streq(actual, expected)
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (expected: \"" + expected + "\", got: \"" + actual + "\")"
        return 0
    end
end

pub function assert_str_ne(actual, expected, msg)
    if streq(actual, expected) == 0
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (expected not: \"" + expected + "\")"
        return 0
    end
end

pub function assert_gt(actual, expected, msg)
    if actual > expected
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (" + str(actual) + " not > " + str(expected) + ")"
        return 0
    end
end

pub function assert_gte(actual, expected, msg)
    if actual >= expected
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (" + str(actual) + " not >= " + str(expected) + ")"
        return 0
    end
end

pub function assert_lt(actual, expected, msg)
    if actual < expected
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (" + str(actual) + " not < " + str(expected) + ")"
        return 0
    end
end

pub function assert_lte(actual, expected, msg)
    if actual <= expected
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (" + str(actual) + " not <= " + str(expected) + ")"
        return 0
    end
end

pub function assert_null(val, msg)
    return assert(val is null or val == 0, msg)
end

pub function assert_not_null(val, msg)
    return assert(val is not null and val != 0, msg)
end

pub function assert_true(cond, msg)
    return assert(cond, msg)
end

pub function assert_false(cond, msg)
    return assert(cond == 0, msg)
end

pub struct TestRunner
    total
    passed
    failed
end

pub function runner_new()
    return TestRunner(0, 0, 0)
end

pub function runner_assert(r, cond, msg)
    r.total += 1
    if cond
        r.passed += 1
        say "  [PASS] {msg}"
        return 1
    else
        r.failed += 1
        say "  [FAIL] {msg}"
        return 0
    end
end

pub function runner_assert_eq(r, actual, expected, msg)
    r.total += 1
    if actual == expected
        r.passed += 1
        say "  [PASS] {msg}"
        return 1
    else
        r.failed += 1
        say "  [FAIL] {msg} (expected: {expected}, got: {actual})"
        return 0
    end
end

pub function runner_assert_ne(r, actual, expected, msg)
    r.total += 1
    if actual != expected
        r.passed += 1
        say "  [PASS] {msg}"
        return 1
    else
        r.failed += 1
        say "  [FAIL] {msg} (expected not: {expected})"
        return 0
    end
end

pub function runner_assert_str_eq(r, actual, expected, msg)
    r.total += 1
    if streq(actual, expected)
        r.passed += 1
        say "  [PASS] {msg}"
        return 1
    else
        r.failed += 1
        say "  [FAIL] {msg} (expected: \"" + expected + "\", got: \"" + actual + "\")"
        return 0
    end
end

pub function runner_assert_str_ne(r, actual, expected, msg)
    r.total += 1
    if streq(actual, expected) == 0
        r.passed += 1
        say "  [PASS] {msg}"
        return 1
    else
        r.failed += 1
        say "  [FAIL] {msg} (expected not: \"" + expected + "\")"
        return 0
    end
end

pub function runner_assert_true(r, cond, msg)
    return runner_assert(r, cond, msg)
end

pub function runner_assert_false(r, cond, msg)
    return runner_assert(r, cond == 0, msg)
end

pub function runner_summary(r)
    say "----------------------------------------"
    say "Results: " + str(r.passed) + "/" + str(r.total) + " passed, " + str(r.failed) + " failed."
    when r.failed
        is 0 then say "Status: ALL TESTS PASSED!"
        else say "Status: SOME TESTS FAILED!"
    end
    say "----------------------------------------"
    return r.failed
end

pub function test_report(passed, total)
    let failed = total - passed
    say "----------------------------------------"
    say "Results: {passed}/{total} passed, {failed} failed."
    when failed
        is 0 then say "Status: ALL TESTS PASSED!"
        else say "Status: SOME TESTS FAILED!"
    end
    say "----------------------------------------"
    return failed
end

pub function test_summary()
    say "----------------------------------------"
    say "Status: ALL TESTS PASSED!"
    say "----------------------------------------"
    return 0
end

# --- TestRunner Struct Methods ---

pub function TestRunner.assert(self, cond, msg)
    return runner_assert(self, cond, msg)
end

pub function TestRunner.assert_eq(self, actual, expected, msg)
    return runner_assert_eq(self, actual, expected, msg)
end

pub function TestRunner.assert_ne(self, actual, expected, msg)
    return runner_assert_ne(self, actual, expected, msg)
end

pub function TestRunner.assert_str_eq(self, actual, expected, msg)
    return runner_assert_str_eq(self, actual, expected, msg)
end

pub function TestRunner.assert_str_ne(self, actual, expected, msg)
    return runner_assert_str_ne(self, actual, expected, msg)
end

pub function TestRunner.assert_true(self, cond, msg)
    return runner_assert_true(self, cond, msg)
end

pub function TestRunner.assert_false(self, cond, msg)
    return runner_assert_false(self, cond, msg)
end

pub function TestRunner.summary(self)
    return runner_summary(self)
end
