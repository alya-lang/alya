# Alya Standard Library - Test Module (std/test)
# Micro-testing and assertion utilities with a counting TestRunner.
# Also hosts the micro-benchmarking engine (BenchRunner).

# --- Types ---

## Stores timing and allocation stats for one benchmark operation.
pub struct BenchRecord
    op_name: string
    op_iters: int
    op_elapsed: int
    op_alloc: int
    op_ns: int
    op_throughput: int
end

## Accumulates benchmark records for one benchmark suite.
pub struct BenchRunner
    suite_name: string
    records: BenchRecord[]
    total_runs: int
    total_ms: int
    start_ms: int
    start_alloc: int
    run_iters: int
end

## Counts passed and failed assertions for one test run.
pub struct TestRunner
    total: int
    passed: int
    failed: int
end

# --- Constructors ---

## Creates a BenchRunner and announces the benchmark suite.
pub function bench_runner(name: string) -> BenchRunner
    say f"=== Benchmark Suite: {name} ==="
    return BenchRunner { suite_name: name, records: [], total_runs: 0, total_ms: 0, start_ms: 0, start_alloc: 0, run_iters: 0 }
end

## Creates a TestRunner with zeroed counters.
pub function runner_new() -> TestRunner
    return TestRunner { total: 0, passed: 0, failed: 0 }
end

# --- Assertions ---

## Prints PASS/FAIL for a condition and returns 1 or 0.
pub function assert(cond: int, msg: string) -> int
    if cond
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg}"
        return 0
    end
end

## Passes when actual equals expected.
pub function assert_eq(actual, expected, msg: string) -> int
    if actual == expected
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (expected: {expected}, got: {actual})"
        return 0
    end
end

## Passes when the condition is zero.
pub function assert_false(cond: int, msg: string) -> int
    if cond == 0
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg}"
        return 0
    end
end

## Passes when actual is greater than expected.
pub function assert_gt(actual, expected, msg: string) -> int
    if actual > expected
        say "  [PASS] {msg}"
        return 1
    else
        say f"  [FAIL] {msg} ({actual} not > {expected})"
        return 0
    end
end

## Passes when actual is greater than or equal to expected.
pub function assert_gte(actual, expected, msg: string) -> int
    if actual >= expected
        say "  [PASS] {msg}"
        return 1
    else
        say f"  [FAIL] {msg} ({actual} not >= {expected})"
        return 0
    end
end

## Passes when actual is less than expected.
pub function assert_lt(actual, expected, msg: string) -> int
    if actual < expected
        say "  [PASS] {msg}"
        return 1
    else
        say f"  [FAIL] {msg} ({actual} not < {expected})"
        return 0
    end
end

## Passes when actual is less than or equal to expected.
pub function assert_lte(actual, expected, msg: string) -> int
    if actual <= expected
        say "  [PASS] {msg}"
        return 1
    else
        say f"  [FAIL] {msg} ({actual} not <= {expected})"
        return 0
    end
end

## Passes when actual differs from expected.
pub function assert_ne(actual, expected, msg: string) -> int
    if actual != expected
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (expected not: {expected})"
        return 0
    end
end

## Passes when the value is neither null nor zero.
pub function assert_not_null(val, msg: string) -> int
    if val is not null and val != 0
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (expected not null)"
        return 0
    end
end

## Passes when the value is null or zero.
pub function assert_null(val, msg: string) -> int
    if val is null or val == 0
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg} (expected null)"
        return 0
    end
end

## Passes when two strings are equal.
pub function assert_str_eq(actual: string, expected: string, msg: string) -> int
    if streq(actual, expected)
        say "  [PASS] {msg}"
        return 1
    else
        say f"  [FAIL] {msg} (expected: \"{expected}\", got: \"{actual}\")"
        return 0
    end
end

## Passes when two strings differ.
pub function assert_str_ne(actual: string, expected: string, msg: string) -> int
    if streq(actual, expected) == 0
        say "  [PASS] {msg}"
        return 1
    else
        say f"  [FAIL] {msg} (expected not: \"{expected}\")"
        return 0
    end
end

## Passes when the condition is nonzero.
pub function assert_true(cond: int, msg: string) -> int
    if cond
        say "  [PASS] {msg}"
        return 1
    else
        say "  [FAIL] {msg}"
        return 0
    end
end

# --- Suites and Reports ---

## Prints a pass/fail summary and returns the failure count.
pub function test_report(passed: int, total: int) -> int
    let failed: int = total - passed
    say "----------------------------------------"
    say "Results: {passed}/{total} passed, {failed} failed."
    when failed
        is 0 then say "Status: ALL TESTS PASSED!"
        else say "Status: SOME TESTS FAILED!"
    end
    say "----------------------------------------"
    return failed
end

## Prints a test suite header banner.
pub function test_suite(name: string)
    say "=== Test Suite: {name} ==="
end

## Prints a fixed all-passed summary and returns 0.
pub function test_summary() -> int
    say "----------------------------------------"
    say "Status: ALL TESTS PASSED!"
    say "----------------------------------------"
    return 0
end

# --- TestRunner Functions ---

## Records a conditional check on the runner and prints PASS/FAIL.
pub function runner_assert(r: TestRunner, cond: int, msg: string) -> int
    r.total += 1
    if cond
        r.passed += 1
        say "  [PASS] {msg}"
        return 1
    else
        r.failed += 1
        say "  [FAIL] {msg}"
        return 0
    end
end

## Records an equality check on the runner.
pub function runner_assert_eq(r: TestRunner, actual, expected, msg: string) -> int
    r.total += 1
    if actual == expected
        r.passed += 1
        say "  [PASS] {msg}"
        return 1
    else
        r.failed += 1
        say "  [FAIL] {msg} (expected: {expected}, got: {actual})"
        return 0
    end
end

## Records a false check on the runner.
pub function runner_assert_false(r: TestRunner, cond: int, msg: string) -> int
    let is_zero: int = 0
    if cond == 0
        is_zero = 1
    end
    return runner_assert(r, is_zero, msg)
end

## Records an inequality check on the runner.
pub function runner_assert_ne(r: TestRunner, actual, expected, msg: string) -> int
    r.total += 1
    if actual != expected
        r.passed += 1
        say "  [PASS] {msg}"
        return 1
    else
        r.failed += 1
        say "  [FAIL] {msg} (expected not: {expected})"
        return 0
    end
end

## Records a string equality check on the runner.
pub function runner_assert_str_eq(r: TestRunner, actual: string, expected: string, msg: string) -> int
    r.total += 1
    if streq(actual, expected)
        r.passed += 1
        say "  [PASS] {msg}"
        return 1
    else
        r.failed += 1
        say f"  [FAIL] {msg} (expected: \"{expected}\", got: \"{actual}\")"
        return 0
    end
end

## Records a string inequality check on the runner.
pub function runner_assert_str_ne(r: TestRunner, actual: string, expected: string, msg: string) -> int
    r.total += 1
    if streq(actual, expected) == 0
        r.passed += 1
        say "  [PASS] {msg}"
        return 1
    else
        r.failed += 1
        say f"  [FAIL] {msg} (expected not: \"{expected}\")"
        return 0
    end
end

## Records a true check on the runner.
pub function runner_assert_true(r: TestRunner, cond: int, msg: string) -> int
    return runner_assert(r, cond, msg)
end

## Prints the runner totals and returns the failure count.
pub function runner_summary(r: TestRunner) -> int
    say "----------------------------------------"
    say f"Results: {r.passed}/{r.total} passed, {r.failed} failed."
    when r.failed
        is 0 then say "Status: ALL TESTS PASSED!"
        else say "Status: SOME TESTS FAILED!"
    end
    say "----------------------------------------"
    return r.failed
end

# --- TestRunner Methods ---

## Method wrapper around runner_assert.
pub function TestRunner.assert(self: TestRunner, cond: int, msg: string) -> int
    return runner_assert(self, cond, msg)
end

## Method wrapper around runner_assert_eq.
pub function TestRunner.assert_eq(self: TestRunner, actual, expected, msg: string) -> int
    return runner_assert_eq(self, actual, expected, msg)
end

## Method wrapper around runner_assert_false.
pub function TestRunner.assert_false(self: TestRunner, cond: int, msg: string) -> int
    return runner_assert_false(self, cond, msg)
end

## Method wrapper around runner_assert_ne.
pub function TestRunner.assert_ne(self: TestRunner, actual, expected, msg: string) -> int
    return runner_assert_ne(self, actual, expected, msg)
end

## Method wrapper around runner_assert_str_eq.
pub function TestRunner.assert_str_eq(self: TestRunner, actual: string, expected: string, msg: string) -> int
    return runner_assert_str_eq(self, actual, expected, msg)
end

## Method wrapper around runner_assert_str_ne.
pub function TestRunner.assert_str_ne(self: TestRunner, actual: string, expected: string, msg: string) -> int
    return runner_assert_str_ne(self, actual, expected, msg)
end

## Method wrapper around runner_assert_true.
pub function TestRunner.assert_true(self: TestRunner, cond: int, msg: string) -> int
    return runner_assert_true(self, cond, msg)
end

## Method wrapper around runner_summary.
pub function TestRunner.summary(self: TestRunner) -> int
    return runner_summary(self)
end

# --- Benchmarking ---

function _bench_format_thousands(n: int) -> string
    let s: string = str(n)
    let slen: int = len(s)
    if slen <= 3
        return s
    end
    let rem: int = slen % 3
    let res: string = ""
    let i: int = 0
    if rem > 0
        res = substring(s, 0, rem)
        i = rem
    end
    while i < slen
        if len(res) > 0
            res = res + ","
        end
        res = res + substring(s, i, 3)
        i += 3
    end
    return res
end

function _bench_pad_right(s: string, width: int) -> string
    let res: string = str_from_ptr(s)
    let slen: int = len(res)
    while slen < width
        res = res + " "
        slen += 1
    end
    return res
end

function _bench_pad_left(s: string, width: int) -> string
    let res: string = str_from_ptr(s)
    let slen: int = len(res)
    while slen < width
        res = " " + res
        slen += 1
    end
    return res
end

function _bench_repeat(c: string, count: int) -> string
    let res: string = ""
    let i: int = 0
    while i < count
        res = res + c
        i += 1
    end
    return res
end

function _bench_format_alloc(bytes: int) -> string
    if bytes <= 0
        return "-"
    end
    if bytes < 1024
        return str(bytes) + " B"
    end
    if bytes < 1048576
        let kb_val: int = bytes / 1024
        return str(kb_val) + " KB"
    end
    let mb_val: int = bytes / 1048576
    return str(mb_val) + " MB"
end

function _bench_format_ns(ns: int) -> string
    if ns < 1000
        return str(ns) + " ns"
    end
    if ns < 1000000
        let us: int = ns / 1000
        let rem: int = (ns % 1000) / 100
        if rem > 0 and us < 100
            return str(us) + "." + str(rem) + " us"
        end
        return str(us) + " us"
    end
    let ms: int = ns / 1000000
    let ms_rem: int = (ns % 1000000) / 100000
    if ms_rem > 0 and ms < 100
        return str(ms) + "." + str(ms_rem) + " ms"
    end
    return str(ms) + " ms"
end

function _bench_format_throughput(ops: int) -> string
    if ops < 1000
        return str(ops) + " ops/s"
    end
    return _bench_format_thousands(ops) + " ops/s"
end

## Reports benchmark stats from a pre-measured elapsed time.
pub function bench_measure(name: string, iters: int, elapsed_ms: int) -> int
    let safe_elapsed: int = elapsed_ms
    if safe_elapsed < 1
        safe_elapsed = 1
    end
    let ns_per_op: int = (safe_elapsed * 1000000) / iters
    let ops_sec: int = (iters * 1000) / safe_elapsed
    say f"  * {name}: {_bench_format_thousands(iters)} iters in {elapsed_ms} ms (~{_bench_format_thousands(ns_per_op)} ns/op | {_bench_format_thousands(ops_sec)} ops/sec)"
    return elapsed_ms
end

## Starts timing a benchmark run of iters iterations.
pub function bench_start(b: BenchRunner, iters: int)
    b.run_iters = iters
    b.start_alloc = mem_allocated()
    b.start_ms = clock_ms()
end

## Stops timing, records a BenchRecord and prints the result.
pub function bench_stop(b: BenchRunner, name: string) -> int
    let elapsed: int = clock_ms() - b.start_ms
    let end_alloc: int = mem_allocated()
    let alloc_diff: int = end_alloc - b.start_alloc
    if alloc_diff < 0
        alloc_diff = 0
    end
    let iters: int = b.run_iters
    if iters <= 0
        iters = 1
    end
    let safe_elapsed: int = elapsed
    if safe_elapsed < 1
        safe_elapsed = 1
    end
    let ns_per_op: int = (safe_elapsed * 1000000) / iters
    let ops_sec: int = (iters * 1000) / safe_elapsed
    let alloc_per_op: int = alloc_diff / iters

    say f"  * {name}: {_bench_format_thousands(iters)} iters in {elapsed} ms (~{_bench_format_thousands(ns_per_op)} ns/op | {_bench_format_thousands(ops_sec)} ops/sec)"

    let rec: BenchRecord = BenchRecord { op_name: name, op_iters: iters, op_elapsed: elapsed, op_alloc: alloc_per_op, op_ns: ns_per_op, op_throughput: ops_sec }
    push(b.records, rec)
    b.total_runs += 1
    b.total_ms += elapsed
    return elapsed
end

## Prints the full benchmark results table.
pub function bench_summary(b: BenchRunner)
    let num_records: int = b.total_runs
    if num_records > 0
        say "\n// * Summary *\n"
        say f"Benchmark Suite : {str_from_ptr(b.suite_name)}"
        say "Target Runtime  : Alya Native (Spec v1.0)"
        say f"Workload        : {num_records} methods\n"

        let baseline_rec = b.records[0]
        let baseline_ns: int = baseline_rec.op_ns
        if baseline_ns <= 0
            baseline_ns = 1
        end
        let baseline_alloc: int = baseline_rec.op_alloc

        # Minimum column widths for headers
        let w_method: int = 6       # "Method"
        let w_iters: int = 6        # "Iters"
        let w_mean: int = 12        # "Mean (ns/op)"
        let w_time: int = 10        # "Total Time"
        let w_ratio: int = 5        # "Ratio"
        let w_alloc: int = 9        # "Allocated"
        let w_alloc_ratio: int = 11 # "Alloc Ratio"
        let w_tp: int = 10          # "Throughput"

        # Calculate max widths dynamically based on all row values
        let k: int = 0
        while k < num_records
            let r_k = b.records[k]
            let nlen: int = len(str_from_ptr(r_k.op_name))
            if nlen > w_method
                w_method = nlen
            end

            let ilen: int = len(_bench_format_thousands(r_k.op_iters))
            if ilen > w_iters
                w_iters = ilen
            end

            let mlen: int = len(_bench_format_ns(r_k.op_ns))
            if mlen > w_mean
                w_mean = mlen
            end

            let tlen: int = len(str(r_k.op_elapsed) + " ms")
            if tlen > w_time
                w_time = tlen
            end

            let r_val: int = (r_k.op_ns * 100) / baseline_ns
            let r_int: int = r_val / 100
            let r_dec: int = r_val % 100
            let r_str: string = str(r_int) + "."
            if r_dec < 10
                r_str = r_str + "0"
            end
            r_str = r_str + str(r_dec)
            let rlen: int = len(r_str)
            if rlen > w_ratio
                w_ratio = rlen
            end

            let alen: int = len(_bench_format_alloc(r_k.op_alloc))
            if alen > w_alloc
                w_alloc = alen
            end

            let a_ratio_str: string = "-"
            if baseline_alloc > 0
                if r_k.op_alloc <= 0
                    a_ratio_str = "-"
                else
                    let a_val: int = (r_k.op_alloc * 100) / baseline_alloc
                    let a_int: int = a_val / 100
                    let a_dec: int = a_val % 100
                    a_ratio_str = str(a_int) + "."
                    if a_dec < 10
                        a_ratio_str = a_ratio_str + "0"
                    end
                    a_ratio_str = a_ratio_str + str(a_dec)
                end
            else
                if r_k.op_alloc > 0
                    a_ratio_str = "NA"
                end
            end
            let arlen: int = len(a_ratio_str)
            if arlen > w_alloc_ratio
                w_alloc_ratio = arlen
            end

            let tplen: int = len(_bench_format_throughput(r_k.op_throughput))
            if tplen > w_tp
                w_tp = tplen
            end

            k += 1
        end

        # Render Header
        let col_name_hdr: string = _bench_pad_right("Method", w_method)
        let col_iters_hdr: string = _bench_pad_left("Iters", w_iters)
        let col_mean_hdr: string = _bench_pad_left("Mean (ns/op)", w_mean)
        let col_time_hdr: string = _bench_pad_left("Total Time", w_time)
        let col_ratio_hdr: string = _bench_pad_left("Ratio", w_ratio)
        let col_alloc_hdr: string = _bench_pad_left("Allocated", w_alloc)
        let col_ar_hdr: string = _bench_pad_left("Alloc Ratio", w_alloc_ratio)
        let col_tp_hdr: string = _bench_pad_left("Throughput", w_tp)

        say f"| {col_name_hdr} | {col_iters_hdr} | {col_mean_hdr} | {col_time_hdr} | {col_ratio_hdr} | {col_alloc_hdr} | {col_ar_hdr} | {col_tp_hdr} |"

        # Render Separator (each column has width W, so between pipes it is W + 2 chars)
        let sep_name: string = ":" + _bench_repeat("-", w_method + 1)
        let sep_iters: string = _bench_repeat("-", w_iters + 1) + ":"
        let sep_mean: string = _bench_repeat("-", w_mean + 1) + ":"
        let sep_time: string = _bench_repeat("-", w_time + 1) + ":"
        let sep_ratio: string = _bench_repeat("-", w_ratio + 1) + ":"
        let sep_alloc: string = _bench_repeat("-", w_alloc + 1) + ":"
        let sep_ar: string = _bench_repeat("-", w_alloc_ratio + 1) + ":"
        let sep_tp: string = _bench_repeat("-", w_tp + 1) + ":"

        say f"|{sep_name}|{sep_iters}|{sep_mean}|{sep_time}|{sep_ratio}|{sep_alloc}|{sep_ar}|{sep_tp}|"

        # Render Data Rows
        let i: int = 0
        while i < num_records
            let r = b.records[i]

            let iters_str: string = _bench_format_thousands(r.op_iters)

            let ratio_val: int = (r.op_ns * 100) / baseline_ns
            let ratio_int: int = ratio_val / 100
            let ratio_dec: int = ratio_val % 100
            let ratio_str: string = str(ratio_int) + "."
            if ratio_dec < 10
                ratio_str = ratio_str + "0"
            end
            ratio_str = ratio_str + str(ratio_dec)

            let a_ratio_str: string = "-"
            if baseline_alloc > 0
                if r.op_alloc <= 0
                    a_ratio_str = "-"
                else
                    let a_val: int = (r.op_alloc * 100) / baseline_alloc
                    let a_int: int = a_val / 100
                    let a_dec: int = a_val % 100
                    a_ratio_str = str(a_int) + "."
                    if a_dec < 10
                        a_ratio_str = a_ratio_str + "0"
                    end
                    a_ratio_str = a_ratio_str + str(a_dec)
                end
            else
                if r.op_alloc > 0
                    a_ratio_str = "NA"
                end
            end

            let name_str: string = str_from_ptr(r.op_name)
            let col_name: string = _bench_pad_right(name_str, w_method)
            let col_iters: string = _bench_pad_left(iters_str, w_iters)
            let col_mean: string = _bench_pad_left(_bench_format_ns(r.op_ns), w_mean)
            let col_time: string = _bench_pad_left(str(r.op_elapsed) + " ms", w_time)
            let col_ratio: string = _bench_pad_left(ratio_str, w_ratio)
            let col_alloc: string = _bench_pad_left(_bench_format_alloc(r.op_alloc), w_alloc)
            let col_ar: string = _bench_pad_left(a_ratio_str, w_alloc_ratio)
            let col_tp: string = _bench_pad_left(_bench_format_throughput(r.op_throughput), w_tp)

            say f"| {col_name} | {col_iters} | {col_mean} | {col_time} | {col_ratio} | {col_alloc} | {col_ar} | {col_tp} |"
            i += 1
        end

        say "\n// * Legends *"
        say "  Mean (ns/op) : Average elapsed time per single operation"
        say "  Total Time   : Total elapsed time across all iterations"
        say f"  Ratio        : Mean time ratio relative to baseline ({str_from_ptr(baseline_rec.op_name)})"
        say "  Allocated    : Allocated heap memory per single operation"
        say "  Alloc Ratio  : Allocated memory ratio relative to baseline"
        say "  Throughput   : Operations executed per second\n"
    end

    let runs: string = str(b.total_runs)
    let ms: string = str(b.total_ms)
    say "----------------------------------------"
    say f"Finished {runs} benchmark(s) in {ms} ms."
    say "========================================"
end

## Warms up, then times a task over iters iterations.
pub function test_run_bench(name: string, warmup: int, iters: int, task) -> int
    let w: int = 0
    while w < warmup
        task()
        w += 1
    end
    let start: int = clock_ms()
    let i: int = 0
    while i < iters
        task()
        i += 1
    end
    let elapsed: int = clock_ms() - start
    if elapsed < 1
        elapsed = 1
    end
    let ns_per_op: int = (elapsed * 1000000) / iters
    let ops_sec: int = (iters * 1000) / elapsed
    say f"  [BENCH] {name}: {iters} iters in {elapsed} ms (~{ns_per_op} ns/op | {ops_sec} ops/sec)"
    return elapsed
end

# --- BenchRunner Methods ---

## Method wrapper around bench_start.
pub function BenchRunner.start(self: BenchRunner, iters: int)
    bench_start(self, iters)
end

## Method wrapper around bench_stop.
pub function BenchRunner.stop(self: BenchRunner, name: string) -> int
    return bench_stop(self, name)
end

## Method wrapper around bench_summary.
pub function BenchRunner.summary(self: BenchRunner)
    bench_summary(self)
end

# --- Legacy Aliases ---

## Prints PASS/FAIL for a condition (alias of assert).
pub function test__assert(cond: int, msg: string) -> int
    return assert(cond, msg)
end

## Checks equality and prints PASS/FAIL (alias of assert_eq).
pub function test__assert_eq(actual, expected, msg: string) -> int
    return assert_eq(actual, expected, msg)
end
