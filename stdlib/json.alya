# Alya Standard Library - JSON Module (std/json)
# Provides JSON encoding helpers and a recursive-descent parser.
# Encoding functions take preformatted fragments; parsing returns Alya values.

# --- Encoding ---

## Encodes preformatted item fragments as a JSON array.
pub function json_array(items) -> string
    let count: int = len(items)
    if count == 0
        return "[]"
    end
    let res: string = "["
    let i: int = 0
    while i < count
        if i > 0
            res = res + ", "
        end
        res = res + items[i]
        i += 1
    end
    res = res + "]"
    return res
end

## Encodes 1 as true and any other value as false.
pub function json_bool(b: int) -> string
    when b
        is 1 then return "true"
        else return "false"
    end
end

## Escapes control characters, quotes, and backslashes for JSON.
pub function json_escape(s: string) -> string
    let slen: int = len(s)
    let res: string = ""
    let i: int = 0
    let ch: string = ""
    let c: int = 0
    while i < slen
        ch = char_at(s, i)
        c = ord(ch)
        when c
            is 34 then res += "\\\""
            is 92 then res += "\\\\"
            is 10 then res += "\\n"
            is 13 then res += "\\r"
            is 9  then res += "\\t"
            is 8  then res += "\\b"
            is 12 then res += "\\f"
            else res += ch
        end
        i += 1
    end
    return res
end

## Formats a float with trimmed fractional digits.
pub function json_float(n: float) -> string
    let iv: int = int(n)
    let fv: float = n - float(iv)
    if fv < 0.0
        fv = -fv
    end
    let frac: int = int(fv * 100.0 + 0.5)
    if frac == 0
        return str(iv) + ".0"
    end
    while frac % 10 == 0
        frac = frac / 10
    end
    if frac < 10 and fv < 0.1
        return str(iv) + ".0" + str(frac)
    end
    return str(iv) + "." + str(frac)
end

## Formats an integer as a JSON number.
pub function json_int(n: int) -> string
    return str(n)
end

## Formats an escaped key with a preformatted value as a JSON pair.
pub function json_kv(key: string, val) -> string
    return "\"" + json_escape(key) + "\": " + str(val)
end

## Returns the JSON null literal.
pub function json_null() -> string
    return "null"
end

## Formats an untyped number as a JSON number.
pub function json_number(n) -> string
    return str(n)
end

## Encodes a map of preformatted values as a JSON object.
pub function json_object(m) -> string
    if len(m) == 0
        return "{}"
    end
    let res: string = "{"
    let first: int = 1
    for k, v in m
        if first == 0
            res = res + ", "
        else
            first = 0
        end
        res = res + "\"" + json_escape(k) + "\": " + str(v)
    end
    res = res + "}"
    return res
end

## Wraps an escaped string in double quotes.
pub function json_string(s: string) -> string
    return "\"" + json_escape(s) + "\""
end

# --- Parsing (Recursive-Descent Parser) ---

function _json_hex_val(ch: string) -> int
    let c: int = ord(ch)
    when c
        is 48..57
            return c - 48
        is 65..70
            return c - 55
        is 97..102
            return c - 87
        else
            return 0
    end
end

function _json_parse_array(s: string, pos: int[], slen: int)
    pos[0] = pos[0] + 1
    let arr = []
    _json_skip_ws(s, pos, slen)
    if pos[0] < slen and char_at(s, pos[0]) == "]"
        pos[0] = pos[0] + 1
        return arr
    end
    while pos[0] < slen
        let val = _json_parse_val(s, pos, slen)
        arr.push(val)
        _json_skip_ws(s, pos, slen)
        if pos[0] >= slen
            break
        end
        let ch: string = char_at(s, pos[0])
        when ch
            is "," then pos[0] = pos[0] + 1
            is "]" then
                pos[0] = pos[0] + 1
                break
            else
                break
        end
    end
    return arr
end

function _json_parse_number(s: string, pos: int[], slen: int)
    let start: int = pos[0]
    let is_flt: int = 0
    while pos[0] < slen
        let ch: string = char_at(s, pos[0])
        let c: int = ord(ch)
        if (c >= 48 and c <= 57) or ch == "-" or ch == "+"
            pos[0] = pos[0] + 1
        elif ch == "." or ch == "e" or ch == "E"
            is_flt = 1
            pos[0] = pos[0] + 1
        else
            break
        end
    end
    let num_str: string = substring(s, start, pos[0] - start)
    if is_flt == 1
        return float(num_str)
    else
        return int(num_str)
    end
end

function _json_parse_object(s: string, pos: int[], slen: int)
    pos[0] = pos[0] + 1
    let obj = {}
    _json_skip_ws(s, pos, slen)
    if pos[0] < slen and char_at(s, pos[0]) == "}"
        pos[0] = pos[0] + 1
        return obj
    end
    while pos[0] < slen
        _json_skip_ws(s, pos, slen)
        if pos[0] >= slen or char_at(s, pos[0]) != "\""
            break
        end
        let key: string = _json_parse_string(s, pos, slen)
        _json_skip_ws(s, pos, slen)
        if pos[0] < slen and char_at(s, pos[0]) == ":"
            pos[0] = pos[0] + 1
        end
        let val = _json_parse_val(s, pos, slen)
        obj[key] = val
        _json_skip_ws(s, pos, slen)
        if pos[0] >= slen
            break
        end
        let ch: string = char_at(s, pos[0])
        when ch
            is "," then pos[0] = pos[0] + 1
            is "}" then
                pos[0] = pos[0] + 1
                break
            else
                break
        end
    end
    return obj
end

function _json_parse_string(s: string, pos: int[], slen: int) -> string
    pos[0] = pos[0] + 1
    let res: string = ""
    while pos[0] < slen
        let ch: string = char_at(s, pos[0])
        if ch == "\""
            pos[0] = pos[0] + 1
            return res
        elif ch == "\\"
            pos[0] = pos[0] + 1
            if pos[0] < slen
                let esc: string = char_at(s, pos[0])
                when esc
                    is "\"" then res = res + "\""
                    is "\\" then res = res + "\\"
                    is "/"  then res = res + "/"
                    is "n"  then res = res + "\n"
                    is "r"  then res = res + "\r"
                    is "t"  then res = res + "\t"
                    is "b"  then res = res + chr(8)
                    is "f"  then res = res + chr(12)
                    is "u"  then
                        if pos[0] + 4 < slen
                            let h0: int = _json_hex_val(char_at(s, pos[0] + 1))
                            let h1: int = _json_hex_val(char_at(s, pos[0] + 2))
                            let h2: int = _json_hex_val(char_at(s, pos[0] + 3))
                            let h3: int = _json_hex_val(char_at(s, pos[0] + 4))
                            let code: int = h0 * 4096 + h1 * 256 + h2 * 16 + h3
                            res = res + chr(code)
                            pos[0] = pos[0] + 4
                        end
                    else
                        res = res + esc
                end
            end
        else
            res = res + ch
        end
        pos[0] = pos[0] + 1
    end
    return res
end

function _json_parse_val(s: string, pos: int[], slen: int)
    _json_skip_ws(s, pos, slen)
    if pos[0] >= slen
        return null
    end
    let ch: string = char_at(s, pos[0])
    when ch
        is "{"
            return _json_parse_object(s, pos, slen)
        is "["
            return _json_parse_array(s, pos, slen)
        is "\""
            return _json_parse_string(s, pos, slen)
        is "t"
            pos[0] = pos[0] + 4
            return 1
        is "f"
            pos[0] = pos[0] + 5
            return 0
        is "n"
            pos[0] = pos[0] + 4
            return null
        else
            return _json_parse_number(s, pos, slen)
    end
end

function _json_skip_ws(s: string, pos: int[], slen: int)
    while pos[0] < slen
        let ch: string = char_at(s, pos[0])
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
            pos[0] = pos[0] + 1
        else
            break
        end
    end
end

## Returns 1 when the text parses as a complete JSON value.
pub function json_is_valid(text: string) -> int
    let s: string = str_from_ptr(text)
    let slen: int = len(s)
    if slen == 0
        return 0
    end
    let pos: int[] = [0]
    let res = _json_parse_val(s, pos, slen)
    _json_skip_ws(s, pos, slen)
    if pos[0] == slen and res != null
        return 1
    end
    return 0
end

## Parses a JSON document into Alya values.
pub function json_parse(text: string)
    let s: string = str_from_ptr(text)
    let slen: int = len(s)
    if slen == 0
        return null
    end
    let pos: int[] = [0]
    return _json_parse_val(s, pos, slen)
end

# --- Legacy Aliases ---

## Legacy alias encoding a map as a JSON object.
pub function json_map(m) -> string
    return json_object(m)
end

## Legacy alias parsing a JSON document expected to be an array.
pub function json_parse_array(text: string)
    return json_parse(text)
end

## Legacy alias parsing a JSON document expected to be an object.
pub function json_parse_object(text: string)
    return json_parse(text)
end
