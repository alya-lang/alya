# Alya Standard Library - String Module
# Provides advanced string manipulation and inspection functions.

pub function is_empty(s)
    return s is null or len(s) == 0
end

pub function is_blank(s)
    let slen = len(s)
    if slen == 0
        return 1
    end
    let i = 0
    let ch = ""
    while i < slen
        ch = char_at(s, i)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
            return 0
        end
        i += 1
    end
    return 1
end

pub function starts_with(s, prefix)
    let plen, slen = len(prefix), len(s)
    if plen > slen
        return 0
    end
    if plen == 0
        return 1
    end
    return substring(s, 0, plen) == prefix
end

pub function ends_with(s, suffix)
    let slen, suflen = len(s), len(suffix)
    if suflen > slen
        return 0
    end
    if suflen == 0
        return 1
    end
    return substring(s, slen - suflen, suflen) == suffix
end

pub function replace(s, old, new_s)
    let slen, olen = len(s), len(old)
    if olen == 0
        return s
    end
    let res = ""
    let i = 0
    while i < slen
        if i + olen <= slen and substring(s, i, olen) == old
            res += new_s
            i += olen
        else
            res += char_at(s, i)
            i += 1
        end
    end
    return res
end

pub function str_repeat(s, count)
    let res = ""
    let i = 0
    while i < count
        res += s
        i += 1
    end
    return res
end

pub function pad_left(s, total_len, pad_char)
    let slen = len(s)
    if slen >= total_len
        return s
    end
    let diff = total_len - slen
    let padding = str_repeat(pad_char, diff)
    return padding + s
end

pub function pad_right(s, total_len, pad_char)
    let slen = len(s)
    if slen >= total_len
        return s
    end
    let diff = total_len - slen
    let padding = str_repeat(pad_char, diff)
    return s + padding
end

pub function center(s, total_len, pad_char)
    let slen = len(s)
    if slen >= total_len
        return s
    end
    let total_pad = total_len - slen
    let left_pad = total_pad / 2
    let right_pad = total_pad - left_pad
    return str_repeat(pad_char, left_pad) + s + str_repeat(pad_char, right_pad)
end

pub function trim_start(s)
    let slen = len(s)
    let i = 0
    let c = ""
    while i < slen
        c = char_at(s, i)
        if c != " " and c != "\t" and c != "\r" and c != "\n"
            break
        end
        i += 1
    end
    if i >= slen
        return ""
    end
    return substring(s, i, slen - i)
end

pub function ltrim(s)
    return trim_start(s)
end

pub function trim_end(s)
    let slen = len(s)
    let i = slen - 1
    let c = ""
    while i >= 0
        c = char_at(s, i)
        if c != " " and c != "\t" and c != "\r" and c != "\n"
            break
        end
        i -= 1
    end
    if i < 0
        return ""
    end
    return substring(s, 0, i + 1)
end

pub function rtrim(s)
    return trim_end(s)
end

pub function trim_char(s, ch)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let start_idx = 0
    while start_idx < slen and char_at(s, start_idx) == ch
        start_idx += 1
    end
    if start_idx >= slen
        return ""
    end
    let end_idx = slen - 1
    while end_idx >= start_idx and char_at(s, end_idx) == ch
        end_idx -= 1
    end
    return substring(s, start_idx, end_idx - start_idx + 1)
end

pub function capitalize(s)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let first = upper(substring(s, 0, 1))
    if slen == 1
        return first
    end
    let rest = lower(substring(s, 1, slen - 1))
    return first + rest
end

pub function title_case(s)
    let slen = len(s)
    if slen == 0
        return ""
    end
    let res = ""
    let capitalize_next = 1
    let i = 0
    let ch = ""
    let c = 0
    let is_space = 0
    while i < slen
        ch = char_at(s, i)
        c = ord(ch)
        is_space = c == 32 or c == 9 or c == 10 or c == 13
        if is_space
            res += ch
            capitalize_next = 1
        else
            if capitalize_next
                res += upper(ch)
                capitalize_next = 0
            else
                res += lower(ch)
            end
        end
        i += 1
    end
    return res
end

pub function lines(s)
    let res = []
    let slen = len(s)
    if slen == 0
        return res
    end
    let current, ch = ""
    let i = 0
    while i < slen
        ch = char_at(s, i)
        when ch
            is "\r" then
                if i + 1 < slen and char_at(s, i + 1) == "\n"
                    i += 1
                end
                res.push(current)
                current = ""
            is "\n" then
                res.push(current)
                current = ""
            else
                current += ch
        end
        i += 1
    end
    res.push(current)
    return res
end

pub function count_matches(s, sub)
    let slen, sublen = len(s), len(sub)
    if sublen == 0 or slen == 0 or sublen > slen
        return 0
    end
    let count = 0
    let i = 0
    while i <= slen - sublen
        if substring(s, i, sublen) == sub
            count += 1
            i += sublen
        else
            i += 1
        end
    end
    return count
end

pub function index_of(s, sub)
    let slen = len(s)
    let sublen = len(sub)
    if sublen == 0
        return 0
    end
    if sublen > slen
        return -1
    end
    let i = 0
    let max_idx = slen - sublen
    while i <= max_idx
        if substring(s, i, sublen) == sub
            return i
        end
        i += 1
    end
    return -1
end

pub function last_index_of(s, sub)
    let slen = len(s)
    let sublen = len(sub)
    if sublen == 0
        return slen
    end
    if sublen > slen
        return -1
    end
    let i = slen - sublen
    while i >= 0
        if substring(s, i, sublen) == sub
            return i
        end
        i -= 1
    end
    return -1
end

pub function contains_str(s, sub)
    return sub in s
end

pub function reverse_str(s)
    let slen = len(s)
    let res = ""
    let i = slen - 1
    while i >= 0
        res += char_at(s, i)
        i -= 1
    end
    return res
end

pub function truncate(s, max_len, suffix)
    let slen = len(s)
    if slen <= max_len
        return s
    end
    let suflen = len(suffix)
    if max_len <= suflen
        return substring(s, 0, max_len)
    end
    return substring(s, 0, max_len - suflen) + suffix
end

pub function is_numeric(s)
    let slen = len(s)
    if slen == 0
        return 0
    end
    let i = 0
    let c = 0
    while i < slen
        c = ord(char_at(s, i))
        if c < 48 or c > 57
            return 0
        end
        i += 1
    end
    return 1
end

pub function is_alphabetic(s)
    let slen = len(s)
    if slen == 0
        return 0
    end
    let i = 0
    let c = 0
    let is_lower_c = 0
    let is_upper_c = 0
    while i < slen
        c = ord(char_at(s, i))
        is_lower_c = c >= 97 and c <= 122
        is_upper_c = c >= 65 and c <= 90
        if not is_lower_c and not is_upper_c
            return 0
        end
        i += 1
    end
    return 1
end

pub function is_alphanumeric(s)
    let slen = len(s)
    if slen == 0
        return 0
    end
    let i = 0
    let c = 0
    let is_digit_c = 0
    let is_lower_c = 0
    let is_upper_c = 0
    while i < slen
        c = ord(char_at(s, i))
        is_digit_c = c >= 48 and c <= 57
        is_lower_c = c >= 97 and c <= 122
        is_upper_c = c >= 65 and c <= 90
        if not is_digit_c and not is_lower_c and not is_upper_c
            return 0
        end
        i += 1
    end
    return 1
end

pub function is_upper(s)
    let slen = len(s)
    if slen == 0
        return 0
    end
    let i = 0
    let c = 0
    while i < slen
        c = ord(char_at(s, i))
        if c < 65 or c > 90
            return 0
        end
        i += 1
    end
    return 1
end

pub function is_lower(s)
    let slen = len(s)
    if slen == 0
        return 0
    end
    let i = 0
    let c = 0
    while i < slen
        c = ord(char_at(s, i))
        if c < 97 or c > 122
            return 0
        end
        i += 1
    end
    return 1
end

pub function slugify(s)
    let slen = len(s)
    let res = ""
    let i = 0
    let last_was_dash = 0
    let ch = ""
    let c = 0
    let is_digit_c = 0
    let is_lower_c = 0
    let is_upper_c = 0
    let is_sep = 0
    while i < slen
        ch = char_at(s, i)
        c = ord(ch)
        is_digit_c = c >= 48 and c <= 57
        is_lower_c = c >= 97 and c <= 122
        is_upper_c = c >= 65 and c <= 90
        is_sep = ch == " " or ch == "-" or ch == "_"

        if is_upper_c
            res += lower(ch)
            last_was_dash = 0
        else
            if is_lower_c or is_digit_c
                res += ch
                last_was_dash = 0
            else
                if is_sep and not last_was_dash and len(res) > 0
                    res += "-"
                    last_was_dash = 1
                end
            end
        end
        i += 1
    end
    let rlen = len(res)
    if rlen > 0 and char_at(res, rlen - 1) == "-"
        return substring(res, 0, rlen - 1)
    end
    return res
end

# --- Hex and Base64 String Encodings ---

function _hex_val(ch)
    let c = ord(ch)
    when c
        is 48..57 then return c - 48
        is 97..102 then return c - 87
        is 65..70 then return c - 55
        else return 0
    end
end

pub function hex_encode(s)
    let hex_chars = "0123456789abcdef"
    let slen = len(s)
    let res = ""
    let i, c, hi, lo = 0
    while i < slen
        c = ord(char_at(s, i))
        hi = bit_and(bit_shr(c, 4), 15)
        lo = bit_and(c, 15)
        res = res + char_at(hex_chars, hi) + char_at(hex_chars, lo)
        i += 1
    end
    return res
end

pub function hex_decode(s)
    let slen = len(s)
    let res = ""
    let i, hi, lo, b = 0
    while i + 1 < slen
        hi = _hex_val(char_at(s, i))
        lo = _hex_val(char_at(s, i + 1))
        b = bit_or(bit_shl(hi, 4), lo)
        res = res + chr(b)
        i += 2
    end
    return res
end

pub function is_hex(s)
    let slen = len(s)
    if slen == 0 or slen % 2 != 0
        return 0
    end
    let i = 0
    let c = 0
    let is_d = 0
    let is_l = 0
    let is_u = 0
    while i < slen
        c = ord(char_at(s, i))
        is_d = c >= 48 and c <= 57
        is_l = c >= 97 and c <= 102
        is_u = c >= 65 and c <= 70
        if not is_d and not is_l and not is_u
            return 0
        end
        i += 1
    end
    return 1
end

function _b64_val(ch)
    let c = ord(ch)
    when c
        is 65..90 then return c - 65
        is 97..122 then return c - 71
        is 48..57 then return c + 4
        is 43 then return 62
        is 47 then return 63
        else return 0
    end
end

pub function base64_encode(s)
    let b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let slen = len(s)
    let res = ""
    let i, b0, b1, b2, has_b1, has_b2, idx0, idx1, idx2, idx3 = 0
    while i < slen
        b0 = ord(char_at(s, i))
        b1 = 0
        b2 = 0
        has_b1 = 0
        has_b2 = 0
        if i + 1 < slen
            b1 = ord(char_at(s, i + 1))
            has_b1 = 1
        end
        if i + 2 < slen
            b2 = ord(char_at(s, i + 2))
            has_b2 = 1
        end

        idx0 = bit_and(bit_shr(b0, 2), 63)
        idx1 = bit_and(bit_or(bit_shl(bit_and(b0, 3), 4), bit_shr(b1, 4)), 63)
        idx2 = bit_and(bit_or(bit_shl(bit_and(b1, 15), 2), bit_shr(b2, 6)), 63)
        idx3 = bit_and(b2, 63)

        res = res + char_at(b64_chars, idx0)
        res = res + char_at(b64_chars, idx1)
        if has_b1
            res = res + char_at(b64_chars, idx2)
        else
            res = res + "="
        end
        if has_b2
            res = res + char_at(b64_chars, idx3)
        else
            res = res + "="
        end
        i += 3
    end
    return res
end

pub function base64_decode(s)
    let slen = len(s)
    let res = ""
    let i, v0, v1, v2, v3, b0, b1, b2 = 0
    let c0, c1, c2, c3 = ""
    while i + 3 < slen
        c0 = char_at(s, i)
        c1 = char_at(s, i + 1)
        c2 = char_at(s, i + 2)
        c3 = char_at(s, i + 3)

        v0 = _b64_val(c0)
        v1 = _b64_val(c1)
        v2 = _b64_val(c2)
        v3 = _b64_val(c3)

        b0 = bit_or(bit_shl(v0, 2), bit_and(bit_shr(v1, 4), 3))
        res = res + chr(b0)

        if c2 != "="
            b1 = bit_and(bit_or(bit_shl(bit_and(v1, 15), 4), bit_shr(v2, 2)), 255)
            res = res + chr(b1)
        end
        if c3 != "="
            b2 = bit_and(bit_or(bit_shl(bit_and(v2, 3), 6), v3), 255)
            res = res + chr(b2)
        end
        i += 4
    end
    return res
end

pub function is_base64(s)
    let slen = len(s)
    if slen == 0 or slen % 4 != 0
        return 0
    end
    let i = 0
    let c = 0
    let is_u = 0
    let is_l = 0
    let is_d = 0
    let is_plus_slash = 0
    let is_pad = 0
    while i < slen
        c = ord(char_at(s, i))
        is_u = c >= 65 and c <= 90
        is_l = c >= 97 and c <= 122
        is_d = c >= 48 and c <= 57
        is_plus_slash = c == 43 or c == 47
        is_pad = c == 61
        if not is_u and not is_l and not is_d and not is_plus_slash and not is_pad
            return 0
        end
        i += 1
    end
    return 1
end

pub function to_hex(s)
    return hex_encode(s)
end

pub function from_hex(s)
    return hex_decode(s)
end

pub function to_base64(s)
    return base64_encode(s)
end

pub function from_base64(s)
    return base64_decode(s)
end
