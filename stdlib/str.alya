# Alya Standard Library - String Module (std/str)
# String inspection, transformation, padding and trimming utilities.
# Also covers hex and base64 encoding helpers.
# Usage: import "std/str"

# --- Inspection ---

## Returns 1 when the string contains the given substring.
##
## ### Parameters
## - `s`: String to search.
## - `sub`: Substring to look for.
##
## ### Returns
## 1 when `sub` is found in `s`, otherwise 0.
pub function contains_str(s: string, sub: string) -> int
    if sub in s
        return 1
    end
    return 0
end

## Counts non-overlapping occurrences of a substring.
##
## ### Parameters
## - `s`: String to search.
## - `sub`: Substring to count.
##
## ### Returns
## The number of non-overlapping matches, or 0 when either string is empty or `sub` is longer.
pub function count_matches(s: string, sub: string) -> int
    let slen: int = len(s)
    let sublen: int = len(sub)
    if sublen == 0 or slen == 0 or sublen > slen
        return 0
    end
    let count: int = 0
    let i: int = 0
    while i <= slen - sublen
        if substring(s, i, sublen) == sub
            count += 1
            i += sublen
        else
            i += 1
        end
    end
    return count
end

## Returns 1 when the string ends with the given suffix.
##
## ### Parameters
## - `s`: String to inspect.
## - `suffix`: Suffix to look for.
##
## ### Returns
## 1 when `s` ends with `suffix` (empty suffix yields 1), otherwise 0.
pub function ends_with(s: string, suffix: string) -> int
    let slen: int = len(s)
    let suflen: int = len(suffix)
    if suflen > slen
        return 0
    end
    if suflen == 0
        return 1
    end
    if substring(s, slen - suflen, suflen) == suffix
        return 1
    end
    return 0
end

## Returns the first index of a substring, or -1 when absent.
##
## ### Parameters
## - `s`: String to search.
## - `sub`: Substring to locate.
##
## ### Returns
## The zero-based index of the first match, 0 for an empty `sub`, or -1 when absent.
pub function index_of(s: string, sub: string) -> int
    let slen: int = len(s)
    let sublen: int = len(sub)
    if sublen == 0
        return 0
    end
    if sublen > slen
        return -1
    end
    let i: int = 0
    let max_idx: int = slen - sublen
    while i <= max_idx
        if substring(s, i, sublen) == sub
            return i
        end
        i += 1
    end
    return -1
end

## Returns 1 when the string holds only ASCII letters.
##
## ### Parameters
## - `s`: String to inspect.
##
## ### Returns
## 1 for a non-empty string of A-Z and a-z only, otherwise 0.
pub function is_alphabetic(s: string) -> int
    let slen: int = len(s)
    if slen == 0
        return 0
    end
    let i: int = 0
    let c: int = 0
    let is_lower_c: int = 0
    let is_upper_c: int = 0
    while i < slen
        c = ord(char_at(s, i))
        is_lower_c = (c >= 97 and c <= 122)
        is_upper_c = (c >= 65 and c <= 90)
        if not is_lower_c and not is_upper_c
            return 0
        end
        i += 1
    end
    return 1
end

## Returns 1 when the string holds only ASCII letters or digits.
##
## ### Parameters
## - `s`: String to inspect.
##
## ### Returns
## 1 for a non-empty string of A-Z, a-z, and 0-9 only, otherwise 0.
pub function is_alphanumeric(s: string) -> int
    let slen: int = len(s)
    if slen == 0
        return 0
    end
    let i: int = 0
    let c: int = 0
    let is_digit_c: int = 0
    let is_lower_c: int = 0
    let is_upper_c: int = 0
    while i < slen
        c = ord(char_at(s, i))
        is_digit_c = (c >= 48 and c <= 57)
        is_lower_c = (c >= 97 and c <= 122)
        is_upper_c = (c >= 65 and c <= 90)
        if not is_digit_c and not is_lower_c and not is_upper_c
            return 0
        end
        i += 1
    end
    return 1
end

## Returns 1 when the string is empty or holds only whitespace.
##
## ### Parameters
## - `s`: String to inspect.
##
## ### Returns
## 1 when empty or holding only spaces, tabs, and line breaks, otherwise 0.
pub function is_blank(s: string) -> int
    let slen: int = len(s)
    if slen == 0
        return 1
    end
    let i: int = 0
    let ch: string = ""
    while i < slen
        ch = char_at(s, i)
        if ch != " " and ch != "\t" and ch != "\r" and ch != "\n"
            return 0
        end
        i += 1
    end
    return 1
end

## Returns 1 when the string is null or has zero length.
##
## ### Parameters
## - `s`: String to inspect.
##
## ### Returns
## 1 when null or zero-length, otherwise 0.
pub function is_empty(s: string) -> int
    if s is null or len(s) == 0
        return 1
    end
    return 0
end

## Returns 1 when the string holds only lowercase ASCII letters.
##
## ### Parameters
## - `s`: String to inspect.
##
## ### Returns
## 1 for a non-empty string of a-z only, otherwise 0.
pub function is_lower(s: string) -> int
    let slen: int = len(s)
    if slen == 0
        return 0
    end
    let i: int = 0
    let c: int = 0
    while i < slen
        c = ord(char_at(s, i))
        if c < 97 or c > 122
            return 0
        end
        i += 1
    end
    return 1
end

## Returns 1 when the string holds only ASCII digits.
##
## ### Parameters
## - `s`: String to inspect.
##
## ### Returns
## 1 for a non-empty string of 0-9 only, otherwise 0.
pub function is_numeric(s: string) -> int
    let slen: int = len(s)
    if slen == 0
        return 0
    end
    let i: int = 0
    let c: int = 0
    while i < slen
        c = ord(char_at(s, i))
        if c < 48 or c > 57
            return 0
        end
        i += 1
    end
    return 1
end

## Returns 1 when the string holds only uppercase ASCII letters.
##
## ### Parameters
## - `s`: String to inspect.
##
## ### Returns
## 1 for a non-empty string of A-Z only, otherwise 0.
pub function is_upper(s: string) -> int
    let slen: int = len(s)
    if slen == 0
        return 0
    end
    let i: int = 0
    let c: int = 0
    while i < slen
        c = ord(char_at(s, i))
        if c < 65 or c > 90
            return 0
        end
        i += 1
    end
    return 1
end

## Returns the last index of a substring, or -1 when absent.
##
## ### Parameters
## - `s`: String to search.
## - `sub`: Substring to locate.
##
## ### Returns
## The zero-based index of the last match, the string length for an empty `sub`, or -1 when absent.
pub function last_index_of(s: string, sub: string) -> int
    let slen: int = len(s)
    let sublen: int = len(sub)
    if sublen == 0
        return slen
    end
    if sublen > slen
        return -1
    end
    let i: int = slen - sublen
    while i >= 0
        if substring(s, i, sublen) == sub
            return i
        end
        i -= 1
    end
    return -1
end

## Returns 1 when the string begins with the given prefix.
##
## ### Parameters
## - `s`: String to inspect.
## - `prefix`: Prefix to look for.
##
## ### Returns
## 1 when `s` starts with `prefix` (empty prefix yields 1), otherwise 0.
pub function starts_with(s: string, prefix: string) -> int
    let plen: int = len(prefix)
    let slen: int = len(s)
    if plen > slen
        return 0
    end
    if plen == 0
        return 1
    end
    if substring(s, 0, plen) == prefix
        return 1
    end
    return 0
end

# --- Case Conversion ---

## Uppercases the first character and lowercases the rest.
##
## ### Parameters
## - `s`: String to transform.
##
## ### Returns
## The string with the first character uppercased and the rest lowercased.
pub function capitalize(s: string) -> string
    let slen: int = len(s)
    if slen == 0
        return ""
    end
    let first: string = upper(substring(s, 0, 1))
    if slen == 1
        return first
    end
    let rest: string = lower(substring(s, 1, slen - 1))
    return first + rest
end

## Uppercases the first letter of each whitespace-separated word.
##
## ### Parameters
## - `s`: String to transform.
##
## ### Returns
## The string with the first letter of each word uppercased and remaining letters lowercased.
pub function title_case(s: string) -> string
    let slen: int = len(s)
    if slen == 0
        return ""
    end
    let res: string = ""
    let capitalize_next: int = 1
    let i: int = 0
    let ch: string = ""
    let c: int = 0
    let is_space: int = 0
    while i < slen
        ch = char_at(s, i)
        c = ord(ch)
        when c
            is 32, 9, 10, 13 then is_space = 1
            else is_space = 0
        end
        if is_space == 1
            res += ch
            capitalize_next = 1
        else
            if capitalize_next == 1
                res += upper(ch)
                capitalize_next = 0
            else
                res += lower(ch)
            end
        end
        i += 1
    end
    return res
end

# --- Trimming ---

## Removes the given character from both ends of the string.
##
## ### Parameters
## - `s`: String to trim.
## - `ch`: Character to strip from both ends.
##
## ### Returns
## The trimmed string, or "" when everything is stripped.
pub function trim_char(s: string, ch: string) -> string
    let slen: int = len(s)
    if slen == 0
        return ""
    end
    let start_idx: int = 0
    while start_idx < slen and char_at(s, start_idx) == ch
        start_idx += 1
    end
    if start_idx >= slen
        return ""
    end
    let end_idx: int = slen - 1
    while end_idx >= start_idx and char_at(s, end_idx) == ch
        end_idx -= 1
    end
    return substring(s, start_idx, end_idx - start_idx + 1)
end

## Removes trailing whitespace from the string.
##
## ### Parameters
## - `s`: String to trim.
##
## ### Returns
## The string without trailing spaces, tabs, or line breaks.
pub function trim_end(s: string) -> string
    let slen: int = len(s)
    let i: int = slen - 1
    let c: string = ""
    while i >= 0
        c = char_at(s, i)
        if c != " " and c != "\t" and c != "\r" and c != "\n"
            break
        end
        i -= 1
    end
    if i < 0
        return ""
    end
    return substring(s, 0, i + 1)
end

## Removes leading whitespace from the string.
##
## ### Parameters
## - `s`: String to trim.
##
## ### Returns
## The string without leading spaces, tabs, or line breaks.
pub function trim_start(s: string) -> string
    let slen: int = len(s)
    let i: int = 0
    let c: string = ""
    while i < slen
        c = char_at(s, i)
        if c != " " and c != "\t" and c != "\r" and c != "\n"
            break
        end
        i += 1
    end
    if i >= slen
        return ""
    end
    return substring(s, i, slen - i)
end

# --- Padding and Shaping ---

## Centers the string in a field padded with the given character.
##
## ### Parameters
## - `s`: String to center.
## - `total_len`: Desired total length in characters.
## - `pad_char`: Padding repeated on both sides.
##
## ### Returns
## The centered string, or `s` unchanged when it already fills the width.
pub function center(s: string, total_len: int, pad_char: string) -> string
    let slen: int = len(s)
    if slen >= total_len
        return s
    end
    let total_pad: int = total_len - slen
    let left_pad: int = total_pad / 2
    let right_pad: int = total_pad - left_pad
    return str_repeat(pad_char, left_pad) + s + str_repeat(pad_char, right_pad)
end

## Pads the left side until the string reaches the total length.
##
## ### Parameters
## - `s`: String to pad.
## - `total_len`: Desired total length in characters.
## - `pad_char`: Padding repeated on the left.
##
## ### Returns
## The left-padded string, or `s` unchanged when it already fills the width.
pub function pad_left(s: string, total_len: int, pad_char: string) -> string
    let slen: int = len(s)
    if slen >= total_len
        return s
    end
    let diff: int = total_len - slen
    let padding: string = str_repeat(pad_char, diff)
    return padding + s
end

## Pads the right side until the string reaches the total length.
##
## ### Parameters
## - `s`: String to pad.
## - `total_len`: Desired total length in characters.
## - `pad_char`: Padding repeated on the right.
##
## ### Returns
## The right-padded string, or `s` unchanged when it already fills the width.
pub function pad_right(s: string, total_len: int, pad_char: string) -> string
    let slen: int = len(s)
    if slen >= total_len
        return s
    end
    let diff: int = total_len - slen
    let padding: string = str_repeat(pad_char, diff)
    return s + padding
end

## Repeats the string count times.
##
## ### Parameters
## - `s`: String to repeat.
## - `count`: Number of repetitions.
##
## ### Returns
## `s` concatenated `count` times, or "" when `count` is not positive.
pub function str_repeat(s: string, count: int) -> string
    let res: string = ""
    let i: int = 0
    while i < count
        res += s
        i += 1
    end
    return res
end

## Shortens the string to max_len, appending the suffix when cut.
##
## ### Parameters
## - `s`: String to shorten.
## - `max_len`: Maximum length in characters.
## - `suffix`: Marker appended when the string is cut.
##
## ### Returns
## `s` when it fits, otherwise the shortened string with the suffix.
pub function truncate(s: string, max_len: int, suffix: string) -> string
    let slen: int = len(s)
    if slen <= max_len
        return s
    end
    let suflen: int = len(suffix)
    if max_len <= suflen
        return substring(s, 0, max_len)
    end
    return substring(s, 0, max_len - suflen) + suffix
end

# --- Transformation ---

## Replaces every occurrence of old with new_s.
##
## ### Parameters
## - `s`: String to transform.
## - `old`: Substring to replace.
## - `new_s`: Replacement text.
##
## ### Returns
## The string with every non-overlapping occurrence replaced, or `s` when `old` is empty.
pub function replace(s: string, old: string, new_s: string) -> string
    let slen: int = len(s)
    let olen: int = len(old)
    if olen == 0
        return s
    end
    let res: string = ""
    let i: int = 0
    while i < slen
        if i + olen <= slen and substring(s, i, olen) == old
            res += new_s
            i += olen
        else
            res += char_at(s, i)
            i += 1
        end
    end
    return res
end

## Returns the string with characters in reverse order.
##
## ### Parameters
## - `s`: String to reverse.
##
## ### Returns
## The reversed string.
pub function reverse_str(s: string) -> string
    let slen: int = len(s)
    let res: string = ""
    let i: int = slen - 1
    while i >= 0
        res += char_at(s, i)
        i -= 1
    end
    return res
end

## Converts the string to a lowercase dash-separated slug.
##
## ### Parameters
## - `s`: String to convert.
##
## ### Returns
## The slug with lowercase alphanumerics and single-dash separators.
pub function slugify(s: string) -> string
    let slen: int = len(s)
    let res: string = ""
    let i: int = 0
    let last_was_dash: int = 0
    let ch: string = ""
    let c: int = 0
    let is_digit_c: int = 0
    let is_lower_c: int = 0
    let is_upper_c: int = 0
    let is_sep: int = 0
    while i < slen
        ch = char_at(s, i)
        c = ord(ch)
        is_digit_c = (c >= 48 and c <= 57)
        is_lower_c = (c >= 97 and c <= 122)
        is_upper_c = (c >= 65 and c <= 90)
        when ch
            is " ", "-", "_" then is_sep = 1
            else is_sep = 0
        end

        if is_upper_c == 1
            res += lower(ch)
            last_was_dash = 0
        else
            if is_lower_c == 1 or is_digit_c == 1
                res += ch
                last_was_dash = 0
            else
                if is_sep == 1 and last_was_dash == 0 and len(res) > 0
                    res += "-"
                    last_was_dash = 1
                end
            end
        end
        i += 1
    end
    let rlen: int = len(res)
    if rlen > 0 and char_at(res, rlen - 1) == "-"
        return substring(res, 0, rlen - 1)
    end
    return res
end

# --- Splitting ---

## Splits the string into lines on CR, LF or CRLF boundaries.
##
## ### Parameters
## - `s`: String to split.
##
## ### Returns
## The lines without terminators, or an empty array when `s` is empty.
pub function lines(s: string) -> string[]
    let res: string[] = []
    let slen: int = len(s)
    if slen == 0
        return res
    end
    let current: string = ""
    let ch: string = ""
    let i: int = 0
    while i < slen
        ch = char_at(s, i)
        when ch
            is "\r" then
                if i + 1 < slen and char_at(s, i + 1) == "\n"
                    i += 1
                end
                res.push(current)
                current = ""
            is "\n" then
                res.push(current)
                current = ""
            else
                current += ch
        end
        i += 1
    end
    res.push(current)
    return res
end

# --- Hex Encoding ---

function _hex_val(ch: string) -> int
    let c: int = ord(ch)
    when c
        is 48..57 then return c - 48
        is 97..102 then return c - 87
        is 65..70 then return c - 55
        else return 0
    end
end

## Decodes a hex string back into its raw bytes.
##
## ### Parameters
## - `s`: Hex string with two characters per byte.
##
## ### Returns
## The decoded bytes as a string; a trailing lone nibble is dropped.
pub function hex_decode(s: string) -> string
    let slen: int = len(s)
    let res: string = ""
    let i: int = 0
    let hi: int = 0
    let lo: int = 0
    let b: int = 0
    while i + 1 < slen
        hi = _hex_val(char_at(s, i))
        lo = _hex_val(char_at(s, i + 1))
        b = bit_or(bit_shl(hi, 4), lo)
        res = res + chr(b)
        i += 2
    end
    return res
end

## Encodes the string bytes as lowercase hex.
##
## ### Parameters
## - `s`: String whose bytes are encoded.
##
## ### Returns
## The lowercase hex string with two characters per byte.
pub function hex_encode(s: string) -> string
    let hex_chars: string = "0123456789abcdef"
    let slen: int = len(s)
    let res: string = ""
    let i: int = 0
    let c: int = 0
    let hi: int = 0
    let lo: int = 0
    while i < slen
        c = ord(char_at(s, i))
        hi = bit_and(bit_shr(c, 4), 15)
        lo = bit_and(c, 15)
        res = res + char_at(hex_chars, hi) + char_at(hex_chars, lo)
        i += 1
    end
    return res
end

## Returns 1 when the string is even-length valid hex.
##
## ### Parameters
## - `s`: String to inspect.
##
## ### Returns
## 1 for a non-empty even-length string of hex digits only, otherwise 0.
pub function is_hex(s: string) -> int
    let slen: int = len(s)
    if slen == 0 or slen % 2 != 0
        return 0
    end
    let i: int = 0
    let c: int = 0
    let is_d: int = 0
    let is_l: int = 0
    let is_u: int = 0
    while i < slen
        c = ord(char_at(s, i))
        is_d = (c >= 48 and c <= 57)
        is_l = (c >= 97 and c <= 102)
        is_u = (c >= 65 and c <= 70)
        if not is_d and not is_l and not is_u
            return 0
        end
        i += 1
    end
    return 1
end

# --- Base64 Encoding ---

function _b64_val(ch: string) -> int
    let c: int = ord(ch)
    return when c
        is 65..90 => c - 65
        is 97..122 => c - 71
        is 48..57 => c + 4
        is 43 => 62
        is 47 => 63
        else => 0
    end
end

## Decodes a base64 string back into a string.
##
## ### Parameters
## - `s`: Standard base64 input.
##
## ### Returns
## The decoded string.
pub function base64_decode(s: string) -> string
    let bytes: int[] = base64_decode_bytes(s)
    let blen: int = len(bytes)
    let res: string = ""
    let i: int = 0
    while i < blen
        res = res + chr(bytes[i])
        i += 1
    end
    return res
end

## Decodes a base64 string back into a byte array.
##
## ### Parameters
## - `s`: Standard base64 input.
##
## ### Returns
## The decoded bytes as an integer array.
pub function base64_decode_bytes(s: string) -> int[]
    let slen: int = len(s)
    let bytes: int[] = []
    let i: int = 0
    let v0: int = 0
    let v1: int = 0
    let v2: int = 0
    let v3: int = 0
    let b0: int = 0
    let b1: int = 0
    let b2: int = 0
    let c0: string = ""
    let c1: string = ""
    let c2: string = ""
    let c3: string = ""
    while i + 3 < slen
        c0 = char_at(s, i)
        c1 = char_at(s, i + 1)
        c2 = char_at(s, i + 2)
        c3 = char_at(s, i + 3)

        v0 = _b64_val(c0)
        v1 = _b64_val(c1)
        v2 = _b64_val(c2)
        v3 = _b64_val(c3)

        b0 = bit_or(bit_shl(v0, 2), bit_and(bit_shr(v1, 4), 3))
        bytes.push(b0)

        if c2 != "="
            b1 = bit_and(bit_or(bit_shl(bit_and(v1, 15), 4), bit_shr(v2, 2)), 255)
            bytes.push(b1)
        end
        if c3 != "="
            b2 = bit_and(bit_or(bit_shl(bit_and(v2, 3), 6), v3), 255)
            bytes.push(b2)
        end
        i += 4
    end
    return bytes
end

## Encodes the string with standard base64.
##
## ### Parameters
## - `s`: String to encode.
##
## ### Returns
## The standard base64 string with padding.
pub function base64_encode(s: string) -> string
    let slen: int = len(s)
    let bytes: int[] = []
    let i: int = 0
    while i < slen
        bytes.push(ord(char_at(s, i)))
        i += 1
    end
    return base64_encode_bytes(bytes)
end

## Encodes a byte array with standard base64.
##
## ### Parameters
## - `bytes`: Byte values to encode.
##
## ### Returns
## The standard base64 string with padding.
pub function base64_encode_bytes(bytes: int[]) -> string
    let b64_chars: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let blen: int = len(bytes)
    let res: string = ""
    let i: int = 0
    let b0: int = 0
    let b1: int = 0
    let b2: int = 0
    let has_b1: int = 0
    let has_b2: int = 0
    let idx0: int = 0
    let idx1: int = 0
    let idx2: int = 0
    let idx3: int = 0
    while i < blen
        b0 = bytes[i]
        b1 = 0
        b2 = 0
        has_b1 = 0
        has_b2 = 0
        if i + 1 < blen
            b1 = bytes[i + 1]
            has_b1 = 1
        end
        if i + 2 < blen
            b2 = bytes[i + 2]
            has_b2 = 1
        end

        idx0 = bit_and(bit_shr(b0, 2), 63)
        idx1 = bit_and(bit_or(bit_shl(bit_and(b0, 3), 4), bit_shr(b1, 4)), 63)
        idx2 = bit_and(bit_or(bit_shl(bit_and(b1, 15), 2), bit_shr(b2, 6)), 63)
        idx3 = bit_and(b2, 63)

        res = res + char_at(b64_chars, idx0)
        res = res + char_at(b64_chars, idx1)
        if has_b1 == 1
            res = res + char_at(b64_chars, idx2)
        else
            res = res + "="
        end
        if has_b2 == 1
            res = res + char_at(b64_chars, idx3)
        else
            res = res + "="
        end
        i += 3
    end
    return res
end

## Returns 1 when the string looks like valid base64 input.
##
## ### Parameters
## - `s`: String to inspect.
##
## ### Returns
## 1 for a non-empty alphabet-only string whose length is a multiple of 4, otherwise 0.
pub function is_base64(s: string) -> int
    let slen: int = len(s)
    if slen == 0 or slen % 4 != 0
        return 0
    end
    let i: int = 0
    let c: int = 0
    let is_u: int = 0
    let is_l: int = 0
    let is_d: int = 0
    let is_plus_slash: int = 0
    let is_pad: int = 0
    while i < slen
        c = ord(char_at(s, i))
        is_u = (c >= 65 and c <= 90)
        is_l = (c >= 97 and c <= 122)
        is_d = (c >= 48 and c <= 57)
        is_plus_slash = (c == 43 or c == 47)
        is_pad = (c == 61)
        if not is_u and not is_l and not is_d and not is_plus_slash and not is_pad
            return 0
        end
        i += 1
    end
    return 1
end

# --- Legacy Aliases ---

## Decodes a base64 string. See: `base64_decode`.
pub function from_base64(s: string) -> string
    return base64_decode(s)
end

## Decodes a hex string. See: `hex_decode`.
pub function from_hex(s: string) -> string
    return hex_decode(s)
end

## Removes leading whitespace. See: `trim_start`.
pub function ltrim(s: string) -> string
    return trim_start(s)
end

## Removes trailing whitespace. See: `trim_end`.
pub function rtrim(s: string) -> string
    return trim_end(s)
end

## Decodes a base64 string. See: `base64_decode`.
pub function str__base64_decode(s: string) -> string
    return base64_decode(s)
end

## Encodes a string with base64. See: `base64_encode`.
pub function str__base64_encode(s: string) -> string
    return base64_encode(s)
end

## Encodes the string with base64. See: `base64_encode`.
pub function to_base64(s: string) -> string
    return base64_encode(s)
end

## Encodes the string as hex. See: `hex_encode`.
pub function to_hex(s: string) -> string
    return hex_encode(s)
end
