# Alya Standard Library - Filesystem Module
# Provides high-level file and directory I/O operations.

pub function fs_exists(path)
    return file_exists(path)
end

pub function fs_read(path)
    return read_file(path)
end

pub function fs_write(path, content)
    return write_file(path, content)
end

pub function fs_append(path, content)
    return append_file(path, content)
end

pub function fs_remove(path)
    return remove_file(path)
end

pub function fs_size(path)
    return file_size(path)
end

pub function fs_mkdir(path)
    return make_dir(path)
end

pub function fs_rmdir(path)
    return rmdir(path)
end

pub function fs_is_dir(path)
    return is_dir(path)
end

pub function fs_list_dir(path)
    return list_dir(path)
end

pub function fs_read_dir(path)
    return list_dir(path)
end

pub function copy_file(src, dst)
    if file_exists(src) == 0
        return 0
    end
    let content = read_file(src)
    return write_file(dst, content)
end

pub function move_file(src, dst)
    if copy_file(src, dst)
        return remove_file(src)
    end
    return 0
end

pub function ensure_dir(path)
    if len(path) == 0 or is_dir(path) == 1
        return 1
    end
    let parent = file_parent(path)
    if parent != "." and parent != "/" and parent != path and len(parent) > 0
        ensure_dir(parent)
    end
    return make_dir(path)
end

pub function list_dir_recursive(path)
    let res = []
    let entries = list_dir(path)
    let i = 0
    while i < len(entries)
        let entry = entries[i]
        let full_path = path + "/" + entry
        res.push(full_path)
        if is_dir(full_path) == 1
            let sub = list_dir_recursive(full_path)
            let j = 0
            while j < len(sub)
                res.push(sub[j])
                j += 1
            end
        end
        i += 1
    end
    return res
end

pub function fs_list_dir_recursive(path)
    return list_dir_recursive(path)
end

pub function copy_dir_recursive(src, dst)
    if is_dir(src) == 0
        return 0
    end
    ensure_dir(dst)
    let entries = list_dir(src)
    let i = 0
    while i < len(entries)
        let entry = entries[i]
        let s = src + "/" + entry
        let d = dst + "/" + entry
        if is_dir(s) == 1
            copy_dir_recursive(s, d)
        else
            copy_file(s, d)
        end
        i += 1
    end
    return 1
end

pub function remove_dir_recursive(path)
    if is_dir(path) == 0
        return 0
    end
    let entries = list_dir(path)
    let i = 0
    while i < len(entries)
        let entry = entries[i]
        let full_path = path + "/" + entry
        if is_dir(full_path) == 1
            remove_dir_recursive(full_path)
        else
            remove_file(full_path)
        end
        i += 1
    end
    return rmdir(path)
end

# Line-by-line file I/O
pub function read_lines(path)
    let res = []
    if file_exists(path) == 0
        return res
    end
    let content = read_file(path)
    let slen = len(content)
    if slen == 0
        return res
    end
    let current = ""
    let i = 0
    let ch = ""
    while i < slen
        ch = char_at(content, i)
        when ch
            is "\r" then
                if i + 1 < slen and char_at(content, i + 1) == "\n"
                    i += 1
                end
                res.push(current)
                current = ""
            is "\n" then
                res.push(current)
                current = ""
            else
                current += ch
        end
        i += 1
    end
    if len(current) > 0
        res.push(current)
    end
    return res
end

pub function write_lines(path, lines)
    let content = ""
    let count = len(lines)
    let i = 0
    while i < count
        content += lines[i] + "\n"
        i += 1
    end
    return write_file(path, content)
end

pub function append_line(path, line)
    return append_file(path, line + "\n")
end

pub function append_lines(path, lines)
    let content = ""
    let count = len(lines)
    let i = 0
    while i < count
        content += lines[i] + "\n"
        i += 1
    end
    return append_file(path, content)
end

# File helpers
pub function touch(path)
    if file_exists(path)
        return 1
    end
    return write_file(path, "")
end

pub function clear_file(path)
    return write_file(path, "")
end

pub function is_empty_file(path)
    if file_exists(path) == 0
        return 0
    end
    return file_size(path) == 0
end

pub function read_file_or(path, default_val)
    if file_exists(path) == 0
        return default_val
    end
    return read_file(path)
end

pub function file_lines_count(path)
    let lines = read_lines(path)
    return len(lines)
end

pub function file_basename(path)
    let slen = len(path)
    if slen == 0
        return ""
    end
    let i = slen - 1
    while i >= 0
        let ch = char_at(path, i)
        if ch == "/" or ch == "\\"
            return substring(path, i + 1, slen - (i + 1))
        end
        i -= 1
    end
    return path
end

pub function file_extension(path)
    let base = file_basename(path)
    let blen = len(base)
    let i = blen - 1
    while i >= 0
        if char_at(base, i) == "."
            if i == 0
                return ""
            end
            return substring(base, i + 1, blen - (i + 1))
        end
        i -= 1
    end
    return ""
end

pub function file_parent(path)
    let slen = len(path)
    if slen == 0
        return "."
    end
    let end_idx = slen
    if end_idx > 1 and (char_at(path, end_idx - 1) == "/" or char_at(path, end_idx - 1) == "\\")
        end_idx -= 1
    end
    let i = end_idx - 1
    while i >= 0
        let ch = char_at(path, i)
        if ch == "/" or ch == "\\"
            if i == 0
                return "/"
            end
            if i == 2 and char_at(path, 1) == ":"
                return substring(path, 0, 3)
            end
            return substring(path, 0, i)
        end
        i -= 1
    end
    return "."
end
