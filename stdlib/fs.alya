# Alya Standard Library - Filesystem Module (std/fs)
# Provides high-level file and directory I/O operations.
# Covers line-oriented file helpers, recursive directory utilities, and globbing.

import "std/path"

# --- File Reading and Writing ---

## Appends a single line plus a newline to a file.
pub function append_line(path: string, line: string) -> int
    return append_file(path, line + "\n")
end

## Appends multiple lines to a file, each terminated by a newline.
pub function append_lines(path: string, lines: string[]) -> int
    let content: string = ""
    let count: int = len(lines)
    let i: int = 0
    while i < count
        content += lines[i] + "\n"
        i += 1
    end
    return append_file(path, content)
end

## Appends raw content to a file.
pub function append_string(path: string, content: string) -> int
    return append_file(path, content)
end

## Truncates a file to zero length.
pub function clear_file(path: string) -> int
    return write_file(path, "")
end

## Appends raw content to a file.
pub function fs_append(path: string, content: string) -> int
    return append_file(path, content)
end

## Reads a whole file as a string.
pub function fs_read(path: string) -> string
    return read_file(path)
end

## Removes a file.
pub function fs_remove(path: string) -> int
    return remove_file(path)
end

## Writes content to a file, overwriting it.
pub function fs_write(path: string, content: string) -> int
    return write_file(path, content)
end

## Reads a file, returning a default value when it is missing.
pub function read_file_or(path: string, default_val: string) -> string
    if file_exists(path) == 0
        return default_val
    end
    return read_file(path)
end

## Reads a file split into lines, handling LF and CRLF.
pub function read_lines(path: string) -> string[]
    let res: string[] = []
    if file_exists(path) == 0
        return res
    end
    let content: string = read_file(path)
    let slen: int = len(content)
    if slen == 0
        return res
    end
    let current: string = ""
    let i: int = 0
    let ch: string = ""
    while i < slen
        ch = char_at(content, i)
        when ch
            is "\r" then
                if i + 1 < slen and char_at(content, i + 1) == "\n"
                    i += 1
                end
                res.push(current)
                current = ""
            is "\n" then
                res.push(current)
                current = ""
            else
                current += ch
        end
        i += 1
    end
    if len(current) > 0
        res.push(current)
    end
    return res
end

## Reads a whole file as a string.
pub function read_string(path: string) -> string
    return read_file(path)
end

## Creates an empty file when it does not exist.
pub function touch(path: string) -> int
    if file_exists(path) == 1
        return 1
    end
    return write_file(path, "")
end

## Writes lines to a file, each terminated by a newline.
pub function write_lines(path: string, lines: string[]) -> int
    let content: string = ""
    let count: int = len(lines)
    let i: int = 0
    while i < count
        content += lines[i] + "\n"
        i += 1
    end
    return write_file(path, content)
end

## Writes content to a file, overwriting it.
pub function write_string(path: string, content: string) -> int
    return write_file(path, content)
end

# --- Path and Metadata ---

## Returns 1 when a path exists on the filesystem.
pub function exists(path: string) -> int
    return file_exists(path)
end

## Returns the final path component after the last separator.
pub function file_basename(path: string) -> string
    let slen: int = len(path)
    if slen == 0
        return ""
    end
    let i: int = slen - 1
    while i >= 0
        let ch: string = char_at(path, i)
        if ch == "/" or ch == "\\"
            return substring(path, i + 1, slen - (i + 1))
        end
        i -= 1
    end
    return path
end

## Returns the extension after the last dot of the basename.
pub function file_extension(path: string) -> string
    let base: string = file_basename(path)
    let blen: int = len(base)
    let i: int = blen - 1
    while i >= 0
        if char_at(base, i) == "."
            if i == 0
                return ""
            end
            return substring(base, i + 1, blen - (i + 1))
        end
        i -= 1
    end
    return ""
end

## Returns the number of lines in a file.
pub function file_lines_count(path: string) -> int
    let lines: string[] = read_lines(path)
    return len(lines)
end

## Returns the parent directory portion of a path.
pub function file_parent(path: string) -> string
    let slen: int = len(path)
    if slen == 0
        return "."
    end
    let end_idx: int = slen
    if end_idx > 1 and (char_at(path, end_idx - 1) == "/" or char_at(path, end_idx - 1) == "\\")
        end_idx -= 1
    end
    let i: int = end_idx - 1
    while i >= 0
        let ch: string = char_at(path, i)
        if ch == "/" or ch == "\\"
            if i == 0
                return "/"
            end
            if i == 2 and char_at(path, 1) == ":"
                return substring(path, 0, 3)
            end
            return substring(path, 0, i)
        end
        i -= 1
    end
    return "."
end

## Returns 1 when a path exists on the filesystem.
pub function fs_exists(path: string) -> int
    return file_exists(path)
end

## Returns 1 when a path is a directory.
pub function fs_is_dir(path: string) -> int
    return is_dir(path)
end

## Returns the size of a file in bytes.
pub function fs_size(path: string) -> int
    return file_size(path)
end

## Returns 1 when a file exists and has zero size.
pub function is_empty_file(path: string) -> int
    if file_exists(path) == 0
        return 0
    end
    if file_size(path) == 0
        return 1
    end
    return 0
end

# --- Directory Operations ---

## Recursively copies a directory tree from src to dst.
pub function copy_dir_recursive(src: string, dst: string) -> int
    if is_dir(src) == 0
        return 0
    end
    ensure_dir(dst)
    let entries: string[] = list_dir(src)
    let i: int = 0
    while i < len(entries)
        let entry: string = entries[i]
        let s: string = src + "/" + entry
        let d: string = dst + "/" + entry
        if is_dir(s) == 1
            copy_dir_recursive(s, d)
        else
            copy_file(s, d)
        end
        i += 1
    end
    return 1
end

## Copies a file by reading its content and writing it to dst.
pub function copy_file(src: string, dst: string) -> int
    if file_exists(src) == 0
        return 0
    end
    let content: string = read_file(src)
    return write_file(dst, content)
end

## Creates a directory and all missing parents, like mkdir -p.
pub function ensure_dir(path: string) -> int
    if len(path) == 0 or is_dir(path) == 1
        return 1
    end
    let parent: string = file_parent(path)
    if parent != "." and parent != "/" and parent != path and len(parent) > 0
        ensure_dir(parent)
    end
    return make_dir(path)
end

## Lists entry names directly inside a directory.
pub function fs_list_dir(path: string) -> string[]
    return list_dir(path)
end

## Creates a single directory.
pub function fs_mkdir(path: string) -> int
    return make_dir(path)
end

## Removes an empty directory.
pub function fs_rmdir(path: string) -> int
    return rmdir(path)
end

## Recursively lists all paths under a directory.
pub function list_dir_recursive(path: string) -> string[]
    let res: string[] = []
    let entries: string[] = list_dir(path)
    let i: int = 0
    while i < len(entries)
        let entry: string = entries[i]
        let full_path: string = path + "/" + entry
        res.push(full_path)
        if is_dir(full_path) == 1
            let sub: string[] = list_dir_recursive(full_path)
            let j: int = 0
            while j < len(sub)
                res.push(sub[j])
                j += 1
            end
        end
        i += 1
    end
    return res
end

## Moves a file by copying it and removing the source.
pub function move_file(src: string, dst: string) -> int
    if copy_file(src, dst) == 1
        return remove_file(src)
    end
    return 0
end

## Recursively removes a directory tree.
pub function remove_dir_recursive(path: string) -> int
    if is_dir(path) == 0
        return 0
    end
    let entries: string[] = list_dir(path)
    let i: int = 0
    while i < len(entries)
        let entry: string = entries[i]
        let full_path: string = path + "/" + entry
        if is_dir(full_path) == 1
            remove_dir_recursive(full_path)
        else
            remove_file(full_path)
        end
        i += 1
    end
    return rmdir(path)
end

# --- Globbing (Merged from std/glob) ---

## Returns paths under the pattern parent that match a glob pattern.
pub function fs_glob(pattern: string) -> string[]
    let parent_dir: string = file_parent(pattern)
    let files: string[] = fs_list_dir(parent_dir)
    let matches: string[] = []
    let i: int = 0
    let total: int = len(files)
    while i < total
        let f: string = files[i]
        let full: string = f
        if parent_dir != "."
            full = parent_dir + "/" + f
        end
        if glob_match(pattern, full) or glob_match(pattern, f)
            push(matches, full)
        end
        i += 1
    end
    return matches
end

# --- Legacy Aliases ---

## Legacy alias appending content to a file.
pub function fs__append_string(path: string, content: string) -> int
    return append_file(path, content)
end

## Legacy alias reporting whether a path exists.
pub function fs__exists(path: string) -> int
    return exists(path)
end

## Legacy directory creation with an optional recursive flag.
pub function fs__mkdir(path: string, recursive: bool = false) -> int
    if recursive
        return ensure_dir(path)
    end
    return make_dir(path)
end

## Legacy alias reading a whole file as a string.
pub function fs__read_string(path: string) -> string
    return read_file(path)
end

## Legacy alias writing content to a file.
pub function fs__write_string(path: string, content: string) -> int
    return write_file(path, content)
end

## Legacy alias recursively listing paths under a directory.
pub function fs_list_dir_recursive(path: string) -> string[]
    return list_dir_recursive(path)
end

## Legacy alias listing entry names inside a directory.
pub function fs_read_dir(path: string) -> string[]
    return list_dir(path)
end
