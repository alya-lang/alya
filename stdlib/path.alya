# Alya Standard Library - Path Module (std/path)
# Cross-platform path parsing, joining, normalization and glob matching utilities.
# Usage: import "std/path"

# --- Separators ---

## Returns the OS-native path separator.
##
## ### Parameters
## None.
##
## ### Returns
## The OS-native separator: backslash on Windows, forward slash elsewhere.
pub function native_separator() -> string
    return when target_os()
        is "windows" => "\\"
        else => "/"
    end
end

## Returns the canonical forward-slash separator.
##
## ### Parameters
## None.
##
## ### Returns
## A single forward slash.
pub function path_separator() -> string
    return "/"
end

# --- Classification ---

## Returns 1 when the path is absolute.
##
## ### Parameters
## - `path`: Path to classify.
##
## ### Returns
## 1 when the path starts with a slash or a drive-letter slash, otherwise 0.
pub function is_absolute(path: string) -> int
    let plen: int = len(path)
    if plen == 0
        return 0
    end
    let c0: string = char_at(path, 0)
    if c0 == "/" or c0 == "\\"
        return 1
    end
    if plen >= 3 and char_at(path, 1) == ":"
        let c2: string = char_at(path, 2)
        if c2 == "/" or c2 == "\\"
            return 1
        end
    end
    return 0
end

## Returns 1 when the path is not absolute.
##
## ### Parameters
## - `path`: Path to classify.
##
## ### Returns
## 1 when `is_absolute` reports 0, otherwise 0.
pub function is_relative(path: string) -> int
    if is_absolute(path)
        return 0
    end
    return 1
end

## Returns 1 when the path is a filesystem root.
##
## ### Parameters
## - `path`: Path to classify.
##
## ### Returns
## 1 for a lone slash, a drive name, or a drive-letter slash, otherwise 0.
pub function is_root(path: string) -> int
    let plen: int = len(path)
    if plen == 1
        let c0: string = char_at(path, 0)
        if c0 == "/" or c0 == "\\"
            return 1
        end
    end
    if plen == 2 and char_at(path, 1) == ":"
        return 1
    end
    if plen == 3 and char_at(path, 1) == ":"
        let c2: string = char_at(path, 2)
        if c2 == "/" or c2 == "\\"
            return 1
        end
    end
    return 0
end

# --- Components ---

## Returns the extension (with dot) of the final component.
##
## ### Parameters
## - `path`: Path whose final component is inspected.
##
## ### Returns
## The extension including the dot, or "" when there is none.
pub function file_ext(path: string) -> string
    let name: string = file_name(path)
    let nlen: int = len(name)
    if nlen <= 1
        return ""
    end
    let i: int = nlen - 1
    while i > 0
        if char_at(name, i) == "."
            return substring(name, i, nlen - i)
        end
        i -= 1
    end
    return ""
end

## Returns the final component of the path.
##
## ### Parameters
## - `path`: Path to inspect.
##
## ### Returns
## The final component with trailing slashes trimmed.
pub function file_name(path: string) -> string
    let plen: int = len(path)
    if plen == 0
        return ""
    end
    let end_idx: int = plen
    while end_idx > 1 and (char_at(path, end_idx - 1) == "/" or char_at(path, end_idx - 1) == "\\")
        end_idx -= 1
    end
    let i: int = end_idx - 1
    let ch: string = ""
    while i >= 0
        ch = char_at(path, i)
        if ch == "/" or ch == "\\"
            return substring(path, i + 1, end_idx - (i + 1))
        end
        i -= 1
    end
    return substring(path, 0, end_idx)
end

## Returns the final component without its extension.
##
## ### Parameters
## - `path`: Path to inspect.
##
## ### Returns
## The final component minus the extension returned by `file_ext`.
pub function file_stem(path: string) -> string
    let name: string = file_name(path)
    let ext: string = file_ext(name)
    let elen: int = len(ext)
    if elen == 0
        return name
    end
    return substring(name, 0, len(name) - elen)
end

## Returns 1 when the final component has an extension.
##
## ### Parameters
## - `path`: Path to inspect.
##
## ### Returns
## 1 when `file_ext` is non-empty, otherwise 0.
pub function has_extension(path: string) -> int
    if len(file_ext(path)) > 0
        return 1
    end
    return 0
end

## Returns the directory portion of the path.
##
## ### Parameters
## - `path`: Path to inspect.
##
## ### Returns
## The parent directory, "/" for a top-level entry, or "." when there is no directory part.
pub function parent_dir(path: string) -> string
    let plen: int = len(path)
    if plen == 0
        return "."
    end
    let end_idx: int = plen
    while end_idx > 1 and (char_at(path, end_idx - 1) == "/" or char_at(path, end_idx - 1) == "\\")
        end_idx -= 1
    end
    let i: int = end_idx - 1
    let ch: string = ""
    while i >= 0
        ch = char_at(path, i)
        if ch == "/" or ch == "\\"
            if i == 0
                return "/"
            end
            if i == 2 and char_at(path, 1) == ":"
                return substring(path, 0, 3)
            end
            return substring(path, 0, i)
        end
        i -= 1
    end
    return "."
end

# --- Transformation ---

## Converts separators to the OS-native form.
##
## ### Parameters
## - `path`: Path to convert.
##
## ### Returns
## The path with OS-native separators.
pub function to_native_separators(path: string) -> string
    if target_os() == "windows"
        let plen: int = len(path)
        let res: string = ""
        let i: int = 0
        let ch: string = ""
        while i < plen
            ch = char_at(path, i)
            if ch == "/"
                res = res + "\\"
            else
                res = res + ch
            end
            i += 1
        end
        return res
    end
    return to_slash(path)
end

## Converts backslashes to forward slashes.
##
## ### Parameters
## - `path`: Path to convert.
##
## ### Returns
## The path with every backslash replaced by a forward slash.
pub function to_slash(path: string) -> string
    let plen: int = len(path)
    let res: string = ""
    let i: int = 0
    let ch: string = ""
    while i < plen
        ch = char_at(path, i)
        if ch == "\\"
            res = res + "/"
        else
            res = res + ch
        end
        i += 1
    end
    return res
end

## Replaces the extension of the final component.
##
## ### Parameters
## - `path`: Path whose extension is replaced.
## - `new_ext`: New extension; a leading dot is added when missing.
##
## ### Returns
## The path with the final component carrying the new extension.
pub function with_extension(path: string, new_ext: string) -> string
    let pdir: string = parent_dir(path)
    let st: string = file_stem(path)
    let ext: string = new_ext
    if len(ext) > 0 and char_at(ext, 0) != "."
        ext = "." + ext
    end
    let new_file: string = st + ext
    if pdir == "."
        let has_slash: int = 0
        let i: int = 0
        let plen: int = len(path)
        let ch: string = ""
        while i < plen
            ch = char_at(path, i)
            if ch == "/" or ch == "\\"
                has_slash = 1
            end
            i += 1
        end
        if has_slash == 0
            return new_file
        end
    end
    return path_join(pdir, new_file)
end

## Replaces the final component with a new file name.
##
## ### Parameters
## - `path`: Path whose final component is replaced.
## - `new_name`: Replacement file name.
##
## ### Returns
## The path with the final component replaced.
pub function with_file_name(path: string, new_name: string) -> string
    let pdir: string = parent_dir(path)
    if pdir == "."
        let has_slash: int = 0
        let i: int = 0
        let plen: int = len(path)
        let ch: string = ""
        while i < plen
            ch = char_at(path, i)
            if ch == "/" or ch == "\\"
                has_slash = 1
            end
            i += 1
        end
        if has_slash == 0
            return new_name
        end
    end
    return path_join(pdir, new_name)
end

# --- Joining ---

## Joins two path segments with a single slash.
##
## ### Parameters
## - `a`: Left path segment.
## - `b`: Right path segment.
##
## ### Returns
## Both segments joined with exactly one forward slash at the boundary.
pub function path_join(a: string, b: string) -> string
    let alen: int = len(a)
    let blen: int = len(b)
    if alen == 0
        return b
    end
    if blen == 0
        return a
    end
    let last_a: string = char_at(a, alen - 1)
    let a_slash: int = (last_a == "/" or last_a == "\\")
    let first_b: string = char_at(b, 0)
    let b_slash: int = (first_b == "/" or first_b == "\\")

    return when
        a_slash and b_slash => substring(a, 0, alen - 1) + "/" + substring(b, 1, blen - 1)
        a_slash => substring(a, 0, alen - 1) + "/" + b
        b_slash => a + "/" + substring(b, 1, blen - 1)
        else => a + "/" + b
    end
end

## Joins three path segments.
##
## ### Parameters
## - `a`: First path segment.
## - `b`: Second path segment.
## - `c`: Third path segment.
##
## ### Returns
## `a`, `b`, and `c` joined via `path_join`.
pub function path_join3(a: string, b: string, c: string) -> string
    return path_join(path_join(a, b), c)
end

## Joins an array of path segments.
##
## ### Parameters
## - `parts`: Path segments to join in order.
##
## ### Returns
## All segments folded through `path_join`, or "" when the array is empty.
pub function path_join_all(parts: string[]) -> string
    let total: int = len(parts)
    if total == 0
        return ""
    end
    let res: string = parts[0]
    let i: int = 1
    while i < total
        res = path_join(res, parts[i])
        i += 1
    end
    return res
end

# --- Glob Matching ---

function _glob_find(s: string, target: string, start_idx: int) -> int
    let slen: int = len(s)
    let tlen: int = len(target)
    if tlen == 0 return start_idx end
    let i: int = start_idx
    while i + tlen <= slen
        if substring(s, i, tlen) == target
            return i
        end
        i += 1
    end
    return -1
end

function _glob_match_class(content: string, ch: string) -> int
    let clen: int = len(content)
    if clen == 0 return 0 end

    let negated: int = 0
    let start: int = 0
    if char_at(content, 0) == "!" or char_at(content, 0) == "^"
        negated = 1
        start = 1
    end

    let ch_code: int = ord(ch)
    let matched: int = 0
    let i: int = start
    while i < clen
        if i + 2 < clen and char_at(content, i + 1) == "-"
            let r_start: int = ord(char_at(content, i))
            let r_end: int = ord(char_at(content, i + 2))
            if ch_code >= r_start and ch_code <= r_end
                matched = 1
                break
            end
            i += 3
        else
            if char_at(content, i) == ch
                matched = 1
                break
            end
            i += 1
        end
    end

    if negated == 1
        if matched == 1 return 0 else return 1 end
    end
    return matched
end

function _glob_match_path_rec(p: string, p_idx: int, s: string, s_idx: int) -> int
    let plen: int = len(p)
    let slen: int = len(s)

    while p_idx < plen
        let pch: string = char_at(p, p_idx)

        # Check for ** (double star) in path mode
        if pch == "*" and p_idx + 1 < plen and char_at(p, p_idx + 1) == "*"
            let next_p: int = p_idx + 2
            if next_p < plen and char_at(p, next_p) == "/"
                next_p += 1
            end

            let try_s: int = s_idx
            while try_s <= slen
                if _glob_match_path_rec(p, next_p, s, try_s) == 1
                    return 1
                end
                try_s += 1
            end
            return 0
        end

        # Check for * (single star - does NOT cross /)
        if pch == "*"
            let next_p: int = p_idx + 1
            let try_s: int = s_idx
            while try_s <= slen
                let res: int = _glob_match_path_rec(p, next_p, s, try_s)
                if res == 1
                    return 1
                end
                if try_s < slen
                    let cur_ch: string = char_at(s, try_s)
                    if cur_ch == "/"
                        return 0
                    end
                end
                try_s += 1
            end
            return 0
        end

        if s_idx >= slen
            return 0
        end

        let sch: string = char_at(s, s_idx)

        when pch
            is "?"
                if sch == "/"
                    return 0
                end
                p_idx += 1
                s_idx += 1
            is "["
                let close_bracket: int = _glob_find(p, "]", p_idx + 1)
                if close_bracket < 0
                    if pch != sch return 0 end
                    p_idx += 1
                    s_idx += 1
                else
                    let class_content: string = substring(p, p_idx + 1, close_bracket - (p_idx + 1))
                    let matched_class: int = _glob_match_class(class_content, sch)
                    if matched_class == 0
                        return 0
                    end
                    p_idx = close_bracket + 1
                    s_idx += 1
                end
            is "\\"
                p_idx += 1
                if p_idx >= plen return 0 end
                pch = char_at(p, p_idx)
                if pch != sch return 0 end
                p_idx += 1
                s_idx += 1
            else
                if pch != sch
                    return 0
                end
                p_idx += 1
                s_idx += 1
        end
    end

    if s_idx == slen
        return 1
    end
    return 0
end

function _glob_match_simple_rec(p: string, p_idx: int, s: string, s_idx: int) -> int
    let plen: int = len(p)
    let slen: int = len(s)

    while p_idx < plen
        let pch: string = char_at(p, p_idx)

        if pch == "*"
            let next_p: int = p_idx + 1
            let try_s: int = s_idx
            while try_s <= slen
                if _glob_match_simple_rec(p, next_p, s, try_s) == 1
                    return 1
                end
                try_s += 1
            end
            return 0
        end

        if s_idx >= slen
            return 0
        end

        let sch: string = char_at(s, s_idx)

        when pch
            is "?"
                p_idx += 1
                s_idx += 1
            is "["
                let close_bracket: int = _glob_find(p, "]", p_idx + 1)
                if close_bracket < 0
                    if pch != sch return 0 end
                    p_idx += 1
                    s_idx += 1
                else
                    let class_content: string = substring(p, p_idx + 1, close_bracket - (p_idx + 1))
                    let matched_class: int = _glob_match_class(class_content, sch)
                    if matched_class == 0
                        return 0
                    end
                    p_idx = close_bracket + 1
                    s_idx += 1
                end
            is "\\"
                p_idx += 1
                if p_idx >= plen return 0 end
                pch = char_at(p, p_idx)
                if pch != sch return 0 end
                p_idx += 1
                s_idx += 1
            else
                if pch != sch
                    return 0
                end
                p_idx += 1
                s_idx += 1
        end
    end

    if s_idx == slen
        return 1
    end
    return 0
end

## Lists the current directory filtered by a glob pattern.
##
## ### Parameters
## - `pattern`: Glob pattern to match entry names against.
##
## ### Returns
## The matching entry names from the current directory.
pub function glob(pattern: string) -> string[]
    return glob_dir(pattern, ".")
end

## Lists a directory filtered by a glob pattern.
##
## ### Parameters
## - `pattern`: Glob pattern to match entry names against.
## - `dir_path`: Directory whose entries are listed.
##
## ### Returns
## The entries of `dir_path` matching the pattern.
pub function glob_dir(pattern: string, dir_path: string) -> string[]
    let d: string = str_from_ptr(dir_path)
    let raw_lines = list_dir(d)
    return glob_filter(pattern, raw_lines)
end

## Escapes glob metacharacters in a literal string.
##
## ### Parameters
## - `s`: Literal text to escape.
##
## ### Returns
## The text with glob metacharacters backslash-escaped.
pub function glob_escape(s: string) -> string
    let text: string = str_from_ptr(s)
    let tlen: int = len(text)
    let res: string = ""
    let i: int = 0
    while i < tlen
        let ch: string = char_at(text, i)
        when ch
            is "*", "?", "[", "]", "{", "}", "\\" then res = res + "\\" + ch
            else res = res + ch
        end
        i += 1
    end
    return res
end

## Keeps list items matching a glob pattern.
##
## ### Parameters
## - `pattern`: Glob pattern to match against.
## - `list`: Candidate entry names.
##
## ### Returns
## The items of `list` matching the pattern via `glob_match`.
pub function glob_filter(pattern: string, list: string[]) -> string[]
    let res: string[] = []
    let total: int = array_len(list)
    let i: int = 0
    while i < total
        let item: string = str_from_ptr(list[i])
        if glob_match(pattern, item) == 1
            res.push(item)
        end
        i += 1
    end
    return res
end

## Returns 1 when the string holds glob metacharacters.
##
## ### Parameters
## - `pattern`: String to inspect.
##
## ### Returns
## 1 when the string contains a glob metacharacter, otherwise 0.
pub function glob_is_pattern(pattern: string) -> int
    let s: string = str_from_ptr(pattern)
    let slen: int = len(s)
    let i: int = 0
    while i < slen
        let ch: string = char_at(s, i)
        when ch
            is "*", "?", "[", "{" then return 1
        end
        i += 1
    end
    return 0
end

## Matches text against a path-aware glob pattern.
##
## ### Parameters
## - `pattern`: Glob pattern supporting star, double star, question mark, classes, and escapes.
## - `text`: Text to test.
##
## ### Returns
## 1 on a match, otherwise 0.
pub function glob_match(pattern: string, text: string) -> int
    return _glob_match_path_rec(str_from_ptr(pattern), 0, str_from_ptr(text), 0)
end

## Matches text against a glob where star crosses slashes.
##
## ### Parameters
## - `pattern`: Glob pattern in which star matches across slashes.
## - `text`: Text to test.
##
## ### Returns
## 1 on a match, otherwise 0.
pub function glob_match_simple(pattern: string, text: string) -> int
    return _glob_match_simple_rec(str_from_ptr(pattern), 0, str_from_ptr(text), 0)
end

# --- Legacy Aliases ---

## Returns the final component. See: `file_name`.
pub function basename(path: string) -> string
    return file_name(path)
end

## Returns the directory portion. See: `parent_dir`.
pub function dirname(path: string) -> string
    return parent_dir(path)
end

## Returns the extension. See: `file_ext`.
pub function ext(path: string) -> string
    return file_ext(path)
end

## Returns the extension. See: `file_ext`.
pub function extname(path: string) -> string
    return file_ext(path)
end

## Matches text against a glob. See: `glob_match_simple`.
pub function fnmatch(pattern: string, text: string) -> int
    return glob_match_simple(pattern, text)
end

## Converts backslashes to slashes. See: `to_slash`.
pub function normalize_slashes(path: string) -> string
    return to_slash(path)
end

## Returns the final component. See: `file_name`.
pub function path__basename(path: string) -> string
    return file_name(path)
end

## Returns the directory portion. See: `parent_dir`.
pub function path__dirname(path: string) -> string
    return parent_dir(path)
end

## Returns the extension. See: `file_ext`.
pub function path__ext(path: string) -> string
    return file_ext(path)
end

## Joins up to three path segments with optional parts.
##
## ### Parameters
## - `a`: First path segment.
## - `b`: Second path segment; ignored when empty.
## - `c`: Third path segment; ignored when empty.
##
## ### Returns
## `a` joined with `b` and `c` through `path_join`.
pub function path__join(a: string, b: string = "", c: string = "") -> string
    if len(c) > 0
        return path_join3(a, b, c)
    elif len(b) > 0
        return path_join(a, b)
    else
        return a
    end
end

## Matches text against a glob pattern. See: `glob_match`.
pub function path_glob_match(pattern: string, text: string) -> int
    return glob_match(pattern, text)
end

## Returns the stem component. See: `file_stem`.
pub function stem(path: string) -> string
    return file_stem(path)
end
