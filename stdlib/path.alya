# Alya Standard Library - Path Module
# Provides cross-platform filesystem path manipulation utilities.

# --- Separators ---

pub function path_separator() -> string
    return "/"
end

pub function native_separator() -> string
    if target_os() == "windows"
        return "\\"
    end
    return "/"
end

# --- Path Classification ---

pub function is_absolute(path: string) -> int
    let plen: int = len(path)
    if plen == 0
        return 0
    end
    let c0: string = char_at(path, 0)
    if c0 == "/" or c0 == "\\"
        return 1
    end
    if plen >= 3 and char_at(path, 1) == ":"
        let c2: string = char_at(path, 2)
        if c2 == "/" or c2 == "\\"
            return 1
        end
    end
    return 0
end

pub function is_relative(path: string) -> int
    if is_absolute(path)
        return 0
    end
    return 1
end

pub function is_root(path: string) -> int
    let plen: int = len(path)
    if plen == 1
        let c0: string = char_at(path, 0)
        if c0 == "/" or c0 == "\\"
            return 1
        end
    end
    if plen == 2 and char_at(path, 1) == ":"
        return 1
    end
    if plen == 3 and char_at(path, 1) == ":"
        let c2: string = char_at(path, 2)
        if c2 == "/" or c2 == "\\"
            return 1
        end
    end
    return 0
end

# --- Component Extraction ---

pub function file_name(path: string) -> string
    let plen: int = len(path)
    if plen == 0
        return ""
    end
    let end_idx: int = plen
    while end_idx > 1 and (char_at(path, end_idx - 1) == "/" or char_at(path, end_idx - 1) == "\\")
        end_idx -= 1
    end
    let i: int = end_idx - 1
    let ch: string = ""
    while i >= 0
        ch = char_at(path, i)
        if ch == "/" or ch == "\\"
            return substring(path, i + 1, end_idx - (i + 1))
        end
        i -= 1
    end
    return substring(path, 0, end_idx)
end

pub function basename(path: string) -> string
    return file_name(path)
end

pub function file_ext(path: string) -> string
    let name: string = file_name(path)
    let nlen: int = len(name)
    if nlen <= 1
        return ""
    end
    let i: int = nlen - 1
    while i > 0
        if char_at(name, i) == "."
            return substring(name, i, nlen - i)
        end
        i -= 1
    end
    return ""
end

pub function extname(path: string) -> string
    return file_ext(path)
end

pub function has_extension(path: string) -> int
    if len(file_ext(path)) > 0
        return 1
    end
    return 0
end

pub function file_stem(path: string) -> string
    let name: string = file_name(path)
    let ext: string = file_ext(name)
    let elen: int = len(ext)
    if elen == 0
        return name
    end
    return substring(name, 0, len(name) - elen)
end

pub function stem(path: string) -> string
    return file_stem(path)
end

pub function parent_dir(path: string) -> string
    let plen: int = len(path)
    if plen == 0
        return "."
    end
    let end_idx: int = plen
    while end_idx > 1 and (char_at(path, end_idx - 1) == "/" or char_at(path, end_idx - 1) == "\\")
        end_idx -= 1
    end
    let i: int = end_idx - 1
    let ch: string = ""
    while i >= 0
        ch = char_at(path, i)
        if ch == "/" or ch == "\\"
            if i == 0
                return "/"
            end
            if i == 2 and char_at(path, 1) == ":"
                return substring(path, 0, 3)
            end
            return substring(path, 0, i)
        end
        i -= 1
    end
    return "."
end

pub function dirname(path: string) -> string
    return parent_dir(path)
end

# --- Path Transformations ---

pub function with_file_name(path: string, new_name: string) -> string
    let pdir: string = parent_dir(path)
    if pdir == "."
        let has_slash: int = 0
        let i: int = 0
        let plen: int = len(path)
        let ch: string = ""
        while i < plen
            ch = char_at(path, i)
            if ch == "/" or ch == "\\"
                has_slash = 1
            end
            i += 1
        end
        if has_slash == 0
            return new_name
        end
    end
    return path_join(pdir, new_name)
end

pub function with_extension(path: string, new_ext: string) -> string
    let pdir: string = parent_dir(path)
    let st: string = file_stem(path)
    let ext: string = new_ext
    if len(ext) > 0 and char_at(ext, 0) != "."
        ext = "." + ext
    end
    let new_file: string = st + ext
    if pdir == "."
        let has_slash: int = 0
        let i: int = 0
        let plen: int = len(path)
        let ch: string = ""
        while i < plen
            ch = char_at(path, i)
            if ch == "/" or ch == "\\"
                has_slash = 1
            end
            i += 1
        end
        if has_slash == 0
            return new_file
        end
    end
    return path_join(pdir, new_file)
end

# --- Joining & Normalization ---

pub function path_join(a: string, b: string) -> string
    let alen: int = len(a)
    let blen: int = len(b)
    if alen == 0
        return b
    end
    if blen == 0
        return a
    end
    let last_a: string = char_at(a, alen - 1)
    let a_slash: int = (last_a == "/" or last_a == "\\")
    let first_b: string = char_at(b, 0)
    let b_slash: int = (first_b == "/" or first_b == "\\")

    if a_slash and b_slash
        return substring(a, 0, alen - 1) + "/" + substring(b, 1, blen - 1)
    elif a_slash
        return substring(a, 0, alen - 1) + "/" + b
    elif b_slash
        return a + "/" + substring(b, 1, blen - 1)
    else
        return a + "/" + b
    end
end

pub function path_join3(a: string, b: string, c: string) -> string
    return path_join(path_join(a, b), c)
end

pub function path_join_all(parts: string[]) -> string
    let total: int = len(parts)
    if total == 0
        return ""
    end
    let res: string = parts[0]
    let i: int = 1
    while i < total
        res = path_join(res, parts[i])
        i += 1
    end
    return res
end

pub function to_slash(path: string) -> string
    let plen: int = len(path)
    let res: string = ""
    let i: int = 0
    let ch: string = ""
    while i < plen
        ch = char_at(path, i)
        if ch == "\\"
            res = res + "/"
        else
            res = res + ch
        end
        i += 1
    end
    return res
end

pub function normalize_slashes(path: string) -> string
    return to_slash(path)
end

pub function to_native_separators(path: string) -> string
    if target_os() == "windows"
        let plen: int = len(path)
        let res: string = ""
        let i: int = 0
        let ch: string = ""
        while i < plen
            ch = char_at(path, i)
            if ch == "/"
                res = res + "\\"
            else
                res = res + ch
            end
            i += 1
        end
        return res
    end
    return to_slash(path)
end
