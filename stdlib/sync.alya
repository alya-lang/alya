# Alya Standard Library - Synchronization Module (std/sync)
# Thread synchronization primitives: Mutex, Channel, WaitGroup, Once, and RwLock.

# --- Mutex (Mutual Exclusion Lock) ---

pub struct Mutex
    handle: int
end

# Creates a new mutex lock.
# Returns a mutex handle.
pub function mutex_new() -> int
    return __native_mutex_new()
end

# Locks the mutex `m`. Blocks until acquired.
pub function mutex_lock(m: int) -> int
    return __native_mutex_lock(m)
end

# Unlocks the mutex `m`.
pub function mutex_unlock(m: int) -> int
    return __native_mutex_unlock(m)
end

# Frees the mutex `m` and releases its OS resources.
pub function mutex_free(m: int) -> int
    return __native_mutex_free(m)
end

pub function Mutex.new() -> Mutex
    return Mutex { handle: mutex_new() }
end

pub function Mutex.lock(self: Mutex) -> int
    return mutex_lock(self.handle)
end

pub function Mutex.unlock(self: Mutex) -> int
    return mutex_unlock(self.handle)
end

pub function Mutex.free(self: Mutex) -> int
    return mutex_free(self.handle)
end

# --- Channel (Thread-Safe FIFO Queue) ---

pub struct Channel
    q
    lock: int
    closed: int
    capacity: int
    rendezvous: int
end

# Creates a new thread-safe FIFO channel.
# If capacity > 0, the channel is bounded (sends block when queue size >= capacity).
# If capacity <= 0, the channel is unbounded.
pub function channel_new(capacity: int = 0) -> Channel
    return Channel { q: [1], lock: mutex_new(), closed: 0, capacity: capacity, rendezvous: 0 }
end

# Creates an unbuffered rendezvous channel where sends block until consumed by a receiver.
pub function channel_rendezvous() -> Channel
    return Channel { q: [1], lock: mutex_new(), closed: 0, capacity: 0, rendezvous: 1 }
end

# Sends a value into the channel. Returns 1 on success, 0 if closed.
# Blocks if capacity > 0 and queue is full, or if unbuffered rendezvous.
pub function channel_send(ch: Channel, val) -> int
    if ch.rendezvous == 1
        while 1
            mutex_lock(ch.lock)
            if ch.closed == 1
                mutex_unlock(ch.lock)
                return 0
            end
            let head: int = ch.q[0]
            let total: int = arr_len(ch.q)
            let sz: int = total - head
            if sz <= 0
                ch.q.push(val)
                while 1
                    let cur_head: int = ch.q[0]
                    let cur_total: int = arr_len(ch.q)
                    let cur_sz: int = cur_total - cur_head
                    if cur_sz <= 0 or ch.closed == 1
                        break
                    end
                    mutex_unlock(ch.lock)
                    __native_fiber_yield()
                    sleep(1)
                    mutex_lock(ch.lock)
                end
                let was_closed: int = ch.closed
                let final_head: int = ch.q[0]
                let final_total: int = arr_len(ch.q)
                let rem: int = final_total - final_head
                mutex_unlock(ch.lock)
                if was_closed == 1 and rem > 0
                    return 0
                end
                return 1
            end
            mutex_unlock(ch.lock)
            __native_fiber_yield()
            sleep(1)
        end
    end

    while 1
        mutex_lock(ch.lock)
        if ch.closed == 1
            mutex_unlock(ch.lock)
            return 0
        end
        let head: int = ch.q[0]
        let total: int = arr_len(ch.q)
        let sz: int = total - head
        if sz < 0
            sz = 0
        end
        if ch.capacity > 0 and sz >= ch.capacity
            mutex_unlock(ch.lock)
            __native_fiber_yield()
            sleep(1)
        else
            ch.q.push(val)
            mutex_unlock(ch.lock)
            return 1
        end
    end
    return 0
end

# Tries to send a value without blocking.
# Returns 1 on success, 0 if channel is full, unbuffered rendezvous, or closed.
pub function channel_try_send(ch: Channel, val) -> int
    mutex_lock(ch.lock)
    if ch.closed == 1
        mutex_unlock(ch.lock)
        return 0
    end
    if ch.rendezvous == 1
        mutex_unlock(ch.lock)
        return 0
    end
    let head: int = ch.q[0]
    let total: int = arr_len(ch.q)
    let sz: int = total - head
    if sz < 0
        sz = 0
    end
    if ch.capacity > 0 and sz >= ch.capacity
        mutex_unlock(ch.lock)
        return 0
    end
    ch.q.push(val)
    mutex_unlock(ch.lock)
    return 1
end

# Tries to receive a value without blocking.
# Returns value if present, or null if empty.
pub function channel_try_recv(ch: Channel)
    mutex_lock(ch.lock)
    let head: int = ch.q[0]
    let total: int = arr_len(ch.q)
    if head >= total
        mutex_unlock(ch.lock)
        return null
    end
    let val = ch.q[head]
    head += 1
    ch.q[0] = head
    if head > 32 and (head * 2) >= total
        let count: int = total - head
        let i: int = 0
        while i < count
            ch.q[i + 1] = ch.q[head + i]
            i += 1
        end
        ch.q[0] = 1
        while arr_len(ch.q) > count + 1
            ch.q.pop()
        end
    end
    mutex_unlock(ch.lock)
    return val
end

# Receives a value from the channel, waiting up to timeout_ms (default: 5000ms).
# Returns the received value, or null on timeout/close.
pub function channel_recv(ch: Channel, timeout_ms: int = 5000)
    let start: int = clock_ms()
    while 1
        let val = channel_try_recv(ch)
        if val != null
            return val
        end
        mutex_lock(ch.lock)
        let is_closed: int = ch.closed
        mutex_unlock(ch.lock)
        if is_closed == 1
            return null
        end
        if timeout_ms > 0 and (clock_ms() - start) >= timeout_ms
            return null
        end
        __native_fiber_yield()
        sleep(1)
    end
    return null
end

# Returns the number of items currently waiting in the channel.
pub function channel_size(ch: Channel) -> int
    mutex_lock(ch.lock)
    let head: int = ch.q[0]
    let total: int = arr_len(ch.q)
    let sz: int = total - head
    if sz < 0
        sz = 0
    end
    mutex_unlock(ch.lock)
    return sz
end

# Returns the configured capacity of the channel (0 if unbounded).
pub function channel_capacity(ch: Channel) -> int
    return ch.capacity
end

# Returns 1 if the channel is closed, 0 otherwise.
pub function channel_is_closed(ch: Channel) -> int
    mutex_lock(ch.lock)
    let c: int = ch.closed
    mutex_unlock(ch.lock)
    return c
end

# Returns 1 if the channel is unbuffered rendezvous, 0 otherwise.
pub function channel_is_rendezvous(ch: Channel) -> int
    return ch.rendezvous
end

# Closes the channel. No more items can be sent.
pub function channel_close(ch: Channel) -> int
    mutex_lock(ch.lock)
    ch.closed = 1
    mutex_unlock(ch.lock)
    return 1
end

# Closes and releases channel mutex resources.
pub function channel_free(ch: Channel)
    channel_close(ch)
    mutex_free(ch.lock)
end

# --- WaitGroup (Thread-Safe Counter Synchronization) ---

pub struct WaitGroup
    count: int
    lock: int
end

# Creates a new WaitGroup initialized with counter = 0.
pub function wait_group_new() -> WaitGroup
    return WaitGroup { count: 0, lock: mutex_new() }
end

# Increments the WaitGroup counter by delta (default: 1).
pub function wait_group_add(wg: WaitGroup, delta: int = 1)
    mutex_lock(wg.lock)
    wg.count += delta
    mutex_unlock(wg.lock)
end

# Decrements the WaitGroup counter by 1.
pub function wait_group_done(wg: WaitGroup)
    mutex_lock(wg.lock)
    if wg.count > 0
        wg.count -= 1
    end
    mutex_unlock(wg.lock)
end

# Blocks until the WaitGroup counter becomes 0 or timeout_ms expires.
# Returns 1 if counter reached 0, 0 if timed out.
pub function wait_group_wait(wg: WaitGroup, timeout_ms: int = 0) -> int
    let start: int = clock_ms()
    while 1
        mutex_lock(wg.lock)
        let cur: int = wg.count
        mutex_unlock(wg.lock)
        if cur <= 0
            return 1
        end
        if timeout_ms > 0 and (clock_ms() - start) >= timeout_ms
            return 0
        end
        sleep(2)
    end
    return 1
end

# Frees the WaitGroup's mutex resources.
pub function wait_group_free(wg: WaitGroup)
    mutex_free(wg.lock)
end

# --- Once (Execute Exactly Once Primitive) ---

pub struct Once
    done: int
    lock: int
end

# Creates a new Once primitive.
pub function once_new() -> Once
    return Once(0, mutex_new())
end

# Atomically checks if the Once instance has already run.
# Returns 1 if this is the first invocation (caller proceeds with action), 0 otherwise.
pub function once_check(o: Once) -> int
    mutex_lock(o.lock)
    if o.done == 0
        o.done = 1
        mutex_unlock(o.lock)
        return 1
    end
    mutex_unlock(o.lock)
    return 0
end

# Frees the Once primitive's mutex resources.
pub function once_free(o: Once)
    mutex_free(o.lock)
end

# --- RwLock (Reader-Writer Lock) ---

pub struct RwLock
    readers: int
    writing: int
    lock: int
end

# Creates a new Reader-Writer lock.
pub function rwlock_new() -> RwLock
    return RwLock(0, 0, mutex_new())
end

# Acquires a shared read lock. Blocks if a writer is active.
pub function rwlock_read_lock(rw: RwLock, timeout_ms: int = 5000) -> int
    let start: int = clock_ms()
    while 1
        mutex_lock(rw.lock)
        if rw.writing == 0
            rw.readers += 1
            mutex_unlock(rw.lock)
            return 1
        end
        mutex_unlock(rw.lock)
        if timeout_ms > 0 and (clock_ms() - start) >= timeout_ms
            return 0
        end
        sleep(1)
    end
    return 0
end

# Releases a shared read lock.
pub function rwlock_read_unlock(rw: RwLock)
    mutex_lock(rw.lock)
    if rw.readers > 0
        rw.readers -= 1
    end
    mutex_unlock(rw.lock)
end

# Acquires an exclusive write lock. Blocks if readers or another writer is active.
pub function rwlock_write_lock(rw: RwLock, timeout_ms: int = 5000) -> int
    let start: int = clock_ms()
    while 1
        mutex_lock(rw.lock)
        if rw.writing == 0 and rw.readers == 0
            rw.writing = 1
            mutex_unlock(rw.lock)
            return 1
        end
        mutex_unlock(rw.lock)
        if timeout_ms > 0 and (clock_ms() - start) >= timeout_ms
            return 0
        end
        sleep(1)
    end
    return 0
end

# Releases an exclusive write lock.
pub function rwlock_write_unlock(rw: RwLock)
    mutex_lock(rw.lock)
    rw.writing = 0
    mutex_unlock(rw.lock)
end

# Frees the RwLock resources.
pub function rwlock_free(rw: RwLock)
    mutex_free(rw.lock)
end

# --- Struct Methods for Synchronization Primitives ---

pub function Channel.new(capacity: int = 0) -> Channel
    return channel_new(capacity)
end

pub function Channel.rendezvous() -> Channel
    return channel_rendezvous()
end

pub function Channel.send(self: Channel, val) -> int
    return channel_send(self, val)
end

pub function Channel.try_send(self: Channel, val) -> int
    return channel_try_send(self, val)
end

pub function Channel.recv(self: Channel)
    return channel_recv(self, 5000)
end

pub function Channel.recv_timeout(self: Channel, timeout_ms: int)
    return channel_recv(self, timeout_ms)
end

pub function Channel.try_recv(self: Channel)
    return channel_try_recv(self)
end

pub function Channel.size(self: Channel) -> int
    return channel_size(self)
end

pub function Channel.capacity(self: Channel) -> int
    return channel_capacity(self)
end

pub function Channel.is_closed(self: Channel) -> int
    return channel_is_closed(self)
end

pub function Channel.is_rendezvous(self: Channel) -> int
    return channel_is_rendezvous(self)
end

pub function Channel.close(self: Channel) -> int
    return channel_close(self)
end

pub function Channel.free(self: Channel)
    channel_free(self)
end

pub function WaitGroup.new() -> WaitGroup
    return wait_group_new()
end

pub function WaitGroup.add(self: WaitGroup, delta: int = 1)
    wait_group_add(self, delta)
end

pub function WaitGroup.done(self: WaitGroup)
    wait_group_done(self)
end

pub function WaitGroup.wait(self: WaitGroup, timeout_ms: int = 0) -> int
    return wait_group_wait(self, timeout_ms)
end

pub function WaitGroup.free(self: WaitGroup)
    wait_group_free(self)
end

pub function Once.check(self: Once) -> int
    return once_check(self)
end

pub function Once.free(self: Once)
    once_free(self)
end

pub function RwLock.read_lock(self: RwLock, timeout_ms: int = 5000) -> int
    return rwlock_read_lock(self, timeout_ms)
end

pub function RwLock.read_unlock(self: RwLock)
    rwlock_read_unlock(self)
end

pub function RwLock.write_lock(self: RwLock, timeout_ms: int = 5000) -> int
    return rwlock_write_lock(self, timeout_ms)
end

pub function RwLock.write_unlock(self: RwLock)
    rwlock_write_unlock(self)
end

pub function RwLock.free(self: RwLock)
    rwlock_free(self)
end

# --- Native OS Worker Threads (Merged from std/thread) ---

pub function sync_spawn(func, arg = null) -> int
    return __native_thread_spawn(func, arg)
end

pub function sync__spawn(func, arg = null) -> int
    return sync_spawn(func, arg)
end

pub function spawn(func, arg = null) -> int
    return sync_spawn(func, arg)
end

pub function join(h: int)
    return sync_join(h)
end

pub function sync_join(h: int)
    return __native_thread_join(h)
end

pub function sync_thread_id() -> int
    return __native_thread_id()
end

pub function sync_sleep(ms: int)
    sleep(ms)
end

# --- Thread Module Aliases ---
pub function thread_spawn(func, arg = null) -> int
    return sync_spawn(func, arg)
end

pub function thread_join(h: int)
    return sync_join(h)
end

pub function thread_id() -> int
    return sync_thread_id()
end

pub function thread_sleep(ms: int)
    sync_sleep(ms)
end

# --- M:N Lightweight Green Fibers ("Colorless Concurrency") ---

pub function fiber_spawn(func, arg = null) -> int
    return __native_fiber_spawn(func, arg)
end

pub function fiber_yield() -> int
    return __native_fiber_yield()
end

pub function fiber_join(h: int) -> int
    return __native_fiber_join(h)
end

pub function fiber_id() -> int
    return __native_fiber_id()
end

pub function fiber_count() -> int
    return __native_fiber_count()
end

pub function fiber_drain()
    __native_fiber_drain()
end

pub function fiber_sleep(ms: int)
    __native_fiber_sleep(ms)
end

# Cooperative Yield Keyword Alias for Colorless Concurrency:
pub function yield() -> int
    return __native_fiber_yield()
end
