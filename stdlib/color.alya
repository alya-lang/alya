# Alya Standard Library - Color & Terminal Styling Module (std/color)
# Provides ANSI escape codes, foreground and background colors, text styling,
# 24-bit TrueColor (RGB), 256-color palette, and ANSI stripping utilities.

function _esc(code, s)
    return "\e[" + code + "m" + str(s) + "\e[0m"
end

# --- Color & Style Enums ---

pub enum Color
    Black = 30
    Red = 31
    Green = 32
    Yellow = 33
    Blue = 34
    Magenta = 35
    Cyan = 36
    White = 37
    Gray = 90
    BrightRed = 91
    BrightGreen = 92
    BrightYellow = 93
    BrightBlue = 94
    BrightMagenta = 95
    BrightCyan = 96
    BrightWhite = 97
end

pub enum BgColor
    Black = 40
    Red = 41
    Green = 42
    Yellow = 43
    Blue = 44
    Magenta = 45
    Cyan = 46
    White = 47
end

pub enum Style
    Reset = 0
    Bold = 1
    Dim = 2
    Italic = 3
    Underline = 4
    Inverse = 7
    Strikethrough = 9
end

# Applies an ANSI code directly to a string.
pub function color_fg(code, s) return _esc(str(code), s) end
pub function color_bg(code, s) return _esc(str(code), s) end
pub function color_style(code, s) return _esc(str(code), s) end

# --- Foreground Colors ---
pub function color_black(s) return _esc(str(Color.Black), s) end
pub function color_red(s) return _esc(str(Color.Red), s) end
pub function color_green(s) return _esc(str(Color.Green), s) end
pub function color_yellow(s) return _esc(str(Color.Yellow), s) end
pub function color_blue(s) return _esc(str(Color.Blue), s) end
pub function color_magenta(s) return _esc(str(Color.Magenta), s) end
pub function color_cyan(s) return _esc(str(Color.Cyan), s) end
pub function color_white(s) return _esc(str(Color.White), s) end
pub function color_gray(s) return _esc(str(Color.Gray), s) end

# --- Bright Foreground Colors ---
pub function color_bright_red(s) return _esc(str(Color.BrightRed), s) end
pub function color_bright_green(s) return _esc(str(Color.BrightGreen), s) end
pub function color_bright_yellow(s) return _esc(str(Color.BrightYellow), s) end
pub function color_bright_blue(s) return _esc(str(Color.BrightBlue), s) end
pub function color_bright_magenta(s) return _esc(str(Color.BrightMagenta), s) end
pub function color_bright_cyan(s) return _esc(str(Color.BrightCyan), s) end
pub function color_bright_white(s) return _esc(str(Color.BrightWhite), s) end

# --- Background Colors ---
pub function bg_black(s) return _esc(str(BgColor.Black), s) end
pub function bg_red(s) return _esc(str(BgColor.Red), s) end
pub function bg_green(s) return _esc(str(BgColor.Green), s) end
pub function bg_yellow(s) return _esc(str(BgColor.Yellow), s) end
pub function bg_blue(s) return _esc(str(BgColor.Blue), s) end
pub function bg_magenta(s) return _esc(str(BgColor.Magenta), s) end
pub function bg_cyan(s) return _esc(str(BgColor.Cyan), s) end
pub function bg_white(s) return _esc(str(BgColor.White), s) end

# --- Text Styles ---
pub function style_bold(s) return _esc(str(Style.Bold), s) end
pub function style_dim(s) return _esc(str(Style.Dim), s) end
pub function style_italic(s) return _esc(str(Style.Italic), s) end
pub function style_underline(s) return _esc(str(Style.Underline), s) end
pub function style_inverse(s) return _esc(str(Style.Inverse), s) end
pub function style_strikethrough(s) return _esc(str(Style.Strikethrough), s) end

pub function color_bold(s) return style_bold(s) end
pub function color_underline(s) return style_underline(s) end
pub function color_italic(s) return style_italic(s) end

# --- 24-bit TrueColor RGB (r, g, b in range 0-255) ---
pub function color_rgb(s, r, g, b)
    let rc = str(r)
    let gc = str(g)
    let bc = str(b)
    return "\e[38;2;" + rc + ";" + gc + ";" + bc + "m" + str(s) + "\e[0m"
end

pub function bg_rgb(s, r, g, b)
    let rc = str(r)
    let gc = str(g)
    let bc = str(b)
    return "\e[48;2;" + rc + ";" + gc + ";" + bc + "m" + str(s) + "\e[0m"
end

# --- 256-Color Palette ---
pub function color_256(s, code)
    let c = str(code)
    return "\e[38;5;" + c + "m" + str(s) + "\e[0m"
end

pub function bg_256(s, code)
    let c = str(code)
    return "\e[48;5;" + c + "m" + str(s) + "\e[0m"
end

# --- Raw ANSI Code Snippets ---
pub function ansi_reset() return "\e[0m" end
pub function ansi_bold() return "\e[1m" end
pub function ansi_dim() return "\e[2m" end
pub function ansi_italic() return "\e[3m" end
pub function ansi_underline() return "\e[4m" end

# Strips all ANSI CSI escape sequences from text
pub function ansi_strip(text)
    let s = str(text)
    let slen = len(s)
    let res = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ord(ch) == 27 and i + 1 < slen and char_at(s, i + 1) == "["
            i += 2
            while i < slen
                let c = char_at(s, i)
                let o = ord(c)
                if o >= 64 and o <= 126
                    break
                end
                i += 1
            end
        else
            res = res + ch
        end
        i += 1
    end
    return res
end
