# Alya Standard Library - Thread and Concurrency Module (std/thread)
# Cross-platform OS thread creation and execution lifecycle.
# For synchronization primitives (Mutex, Channel, WaitGroup, Once, RwLock), import "std/sync".

import "std/sync"

# Spawns a new OS-level thread running `func(arg)` concurrently.
# `func` is a function reference.
# `arg` is an optional argument passed to `func` (default: null).
# Returns a thread handle.
function thread_spawn(func, arg = null)
    return __native_thread_spawn(func, arg)
end

# Waits for the thread with handle `h` to complete.
# Returns the return value of the thread's function.
# Cleans up the thread handle and resources.
function thread_join(h)
    return __native_thread_join(h)
end

# Returns the current OS thread ID as an integer.
function thread_id()
    return __native_thread_id()
end

# Suspends the calling thread for `ms` milliseconds.
function thread_sleep(ms)
    sleep(ms)
end
