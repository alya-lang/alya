# --- Statistics ---

## Returns the arithmetic mean of an array.
##
## ### Parameters
## - `arr`: Array of numbers to average.
##
## ### Returns
## The arithmetic mean as a float, or 0.0 for an empty array.
pub function mean(arr) -> float
    let count: int = len(arr)
    if count == 0
        return 0.0
    end
    return float(sum(arr)) / float(count)
end

## Returns the median of an array.
##
## ### Parameters
## - `arr`: Array of numbers; the input is copied and left unmodified.
##
## ### Returns
## The middle value of the sorted copy for an odd-length array, the average of the two middle values for an even-length array, or 0 for an empty array.
pub function median(arr)
    let count: int = len(arr)
    if count == 0
        return 0
    end
    let sorted = []
    for x in arr
        sorted.push(x)
    end
    let j: int = 1
    let key, k = 0
    while j < count
        key = sorted[j]
        k = j - 1
        while k >= 0 and sorted[k] > key
            sorted[k + 1] = sorted[k]
            k -= 1
        end
        sorted[k + 1] = key
        j += 1
    end
    let mid: int = count / 2
    if count % 2 != 0
        return sorted[mid]
    else
        return (sorted[mid - 1] + sorted[mid]) / 2
    end
end

## Returns the standard deviation of an array.
##
## ### Parameters
## - `arr`: Array of numbers.
##
## ### Returns
## The population standard deviation as a float.
pub function std_dev(arr) -> float
    return native_sqrt(variance(arr))
end

## Returns the sum of an array.
##
## ### Parameters
## - `arr`: Array of numbers to add up.
##
## ### Returns
## The total of all items, or 0 for an empty array.
pub function sum(arr)
    let total = 0
    for x in arr
        total += x
    end
    return total
end

## Returns the population variance of an array.
##
## ### Parameters
## - `arr`: Array of numbers.
##
## ### Returns
## The population variance (mean squared deviation) as a float, or 0.0 for an empty array.
pub function variance(arr) -> float
    let count: int = len(arr)
    if count == 0
        return 0.0
    end
    let m: float = mean(arr)
    let sum_sq: float = 0.0
    let diff: float = 0.0
    for x in arr
        diff = float(x) - m
        sum_sq += diff * diff
    end
    return sum_sq / float(count)
end

# --- Interpolation ---

## Linearly interpolates between a and b by t.
##
## ### Parameters
## - `a`: Start value returned when `t` is 0.
## - `b`: End value returned when `t` is 1.
## - `t`: Blend factor; 0 yields `a`, 1 yields `b`, with no clamping applied.
##
## ### Returns
## The interpolated value `a + (b - a) * t` as a float.
pub function lerp(a: float, b: float, t: float) -> float
    return a + (b - a) * t
end

## Normalizes a value into the 0 to 1 range of the given span.
##
## ### Parameters
## - `val`: Value to normalize.
## - `min_val`: Lower bound of the span.
## - `max_val`: Upper bound of the span.
##
## ### Returns
## The position of `val` within the span as a float, or 0.0 when the span is zero.
pub function norm(val: float, min_val: float, max_val: float) -> float
    let span: float = max_val - min_val
    if span == 0.0 or span == 0
        return 0.0
    end
    return (val - min_val) / span
end

## Smoothly interpolates between two edges with Hermite smoothing.
##
## ### Parameters
## - `edge0`: Lower edge of the transition.
## - `edge1`: Upper edge of the transition.
## - `x`: Input value to smooth.
##
## ### Returns
## 0.0 when `x` is at or below `edge0`, 1.0 when `x` is at or above `edge1`, the Hermite curve `t * t * (3 - 2 * t)` in between, or 0.0 when both edges are equal.
pub function smoothstep(edge0: float, edge1: float, x: float) -> float
    let span: float = edge1 - edge0
    if span == 0.0 or span == 0
        return 0.0
    end
    let t: float = (x - edge0) / span
    if t < 0.0
        return 0.0
    end
    if t > 1.0
        return 1.0
    end
    return t * t * (3.0 - 2.0 * t)
end

# --- Number Theory ---

## Returns the factorial of n.
##
## ### Parameters
## - `n`: Integer whose factorial is computed; values of 1 or less yield 1.
##
## ### Returns
## The product of all integers from 2 to `n`, or 1 when `n` is 1 or less.
pub function factorial(n: int) -> int
    if n <= 1
        return 1
    end
    let res: int = 1
    let i: int = 2
    while i <= n
        res *= i
        i += 1
    end
    return res
end

## Returns the greatest common divisor of two integers.
##
## ### Parameters
## - `a`: First integer; its absolute value is used.
## - `b`: Second integer; its absolute value is used.
##
## ### Returns
## The greatest common divisor as a non-negative integer.
pub function gcd(a: int, b: int) -> int
    let x: int = abs(a)
    let y: int = abs(b)
    let temp: int = 0
    while y != 0
        temp = y
        y = x % y
        x = temp
    end
    return x
end

## Tests whether a number is prime, returning 1 or 0.
##
## ### Parameters
## - `n`: Integer to test for primality.
##
## ### Returns
## 1 when `n` is prime, 0 otherwise; values of 1 or less yield 0.
pub function is_prime(n: int) -> int
    if n <= 1
        return 0
    end
    if n <= 3
        return 1
    end
    if n % 2 == 0 or n % 3 == 0
        return 0
    end
    let i: int = 5
    while i * i <= n
        if n % i == 0 or n % (i + 2) == 0
            return 0
        end
        i += 6
    end
    return 1
end

## Returns the least common multiple of two integers.
##
## ### Parameters
## - `a`: First integer; its absolute value is used.
## - `b`: Second integer; its absolute value is used.
##
## ### Returns
## The least common multiple as a non-negative integer, or 0 when either input is 0.
pub function lcm(a: int, b: int) -> int
    if a == 0 or b == 0
        return 0
    end
    let g: int = gcd(a, b)
    let x: int = abs(a)
    let y: int = abs(b)
    return (x / g) * y
end

# --- Random Numbers ---

## Reseeds the PRNG from the current time.
##
## ### Parameters
## None.
##
## ### Returns
## No return value; reseeds the global PRNG from the current time combined with the raw PRNG output.
pub function rand_auto_seed()
    let s: int = (time() * 1000) + (clock_ms() % 1000) + rand()
    rand_seed(s)
end

## Returns 1 or 0 with 50 percent probability.
##
## ### Parameters
## None.
##
## ### Returns
## 1 or 0 with roughly even probability, taken from the global PRNG.
pub function rand_bool() -> int
    return rand_next() % 2
end

## Returns 1 if an event with probability pct (0..100) occurs, else 0.
##
## ### Parameters
## - `pct`: Chance in percent from 0 to 100; values at or below 0 always yield 0 and values at or above 100 always yield 1.
##
## ### Returns
## 1 when the random draw falls below `pct`, else 0.
pub function rand_chance(pct: int) -> int
    if pct <= 0
        return 0
    end
    if pct >= 100
        return 1
    end
    return (rand_next() % 100) < pct
end

## Returns a randomly selected element from arr.
##
## ### Parameters
## - `arr`: Array to pick an element from.
##
## ### Returns
## A randomly selected element of `arr`, or 0 for an empty array.
pub function rand_choice(arr)
    let n: int = len(arr)
    if n == 0
        return 0
    end
    let idx: int = rand_int(0, n - 1)
    return arr[idx]
end

## Generates a pseudo-random float in the range [min_val, max_val).
##
## ### Parameters
## - `min_val`: Lower bound of the range (inclusive); returned as-is when it is not below `max_val`.
## - `max_val`: Upper bound of the range (exclusive).
##
## ### Returns
## A pseudo-random float from `min_val` (inclusive) to `max_val` (exclusive), or `min_val` when `min_val` is greater than or equal to `max_val`.
pub function rand_float_range(min_val: float, max_val: float) -> float
    if min_val >= max_val
        return min_val
    end
    let f: float = rand_float()
    return min_val + (f * (max_val - min_val))
end

## Generates an inclusive random integer in [min_val, max_val].
##
## ### Parameters
## - `min_val`: Lower bound of the range (inclusive); returned as-is when it is not below `max_val`.
## - `max_val`: Upper bound of the range (inclusive).
##
## ### Returns
## A pseudo-random integer from `min_val` to `max_val` inclusive, drawn from the non-negative global PRNG output.
pub function rand_int(min_val: int, max_val: int) -> int
    if min_val >= max_val
        return min_val
    end
    let r: int = rand_next()
    let range: int = (max_val - min_val) + 1
    return min_val + (r % range)
end

## Generates a pseudo-random integer in the range [0, 2147483647] using the global PRNG.
##
## ### Parameters
## None.
##
## ### Returns
## The absolute value of the raw global PRNG output as a non-negative integer.
pub function rand_next() -> int
    let r: int = rand()
    if r < 0
        r = 0 - r
    end
    return r
end

## Returns a random integer in [min_val, max_val] using the raw PRNG.
##
## ### Parameters
## - `min_val`: Lower bound of the range; returned as-is when it is not below `max_val`.
## - `max_val`: Upper bound of the range.
##
## ### Returns
## `min_val` plus the raw PRNG output modulo the span size, or `min_val` when `min_val` is greater than or equal to `max_val`.
pub function rand_range(min_val: int, max_val: int) -> int
    if min_val >= max_val
        return min_val
    end
    let r: int = rand()
    let span: int = max_val - min_val + 1
    return min_val + (r % span)
end

## Seeds the global PRNG with the given value.
##
## ### Parameters
## - `s`: Seed value passed to the global PRNG.
##
## ### Returns
## No return value; reseeds the global PRNG with `s`.
pub function rand_seed_state(s: int)
    rand_seed(s)
end

## Returns a pseudo-random float in the 0.0 to 1.0 range.
##
## ### Parameters
## None.
##
## ### Returns
## A pseudo-random float from 0.0 (inclusive) up to but not including 1.0, scaled from the global PRNG output.
pub function random() -> float
    let r: int = rand_next() % 1000000000
    return r / 1000000000.0
end

# --- Vector Operations ---

## Cosine similarity between two vectors for AI embeddings / semantic search: (A . B) / (|A| * |B|).
##
## ### Parameters
## - `a`: First vector as an array of numbers.
## - `b`: Second vector as an array of numbers.
##
## ### Returns
## The cosine similarity from -1.0 to 1.0, or 0.0 when either vector has zero magnitude.
pub function cosine_similarity(a, b) -> float
    let dot: float = dot_product(a, b)
    let norm_a: float = vector_norm(a)
    let norm_b: float = vector_norm(b)
    let denom: float = norm_a * norm_b
    if denom == 0.0
        return 0.0
    end
    return dot / denom
end

## Hardware-friendly 4-wide unrolled dot product of two vectors.
##
## ### Parameters
## - `a`: First vector as an array of numbers.
## - `b`: Second vector as an array of numbers.
##
## ### Returns
## The sum of pairwise products over the overlapping prefix of both vectors as a float.
pub function dot_product(a, b) -> float
    let n: int = len(a)
    let nb: int = len(b)
    let limit: int = n
    if nb < n
        limit = nb
    end
    let sum: float = 0.0
    let i: int = 0
    let unroll_limit: int = limit - 3
    while i < unroll_limit
        let a0: float = a[i]
        let b0: float = b[i]
        let a1: float = a[i + 1]
        let b1: float = b[i + 1]
        let a2: float = a[i + 2]
        let b2: float = b[i + 2]
        let a3: float = a[i + 3]
        let b3: float = b[i + 3]
        sum += (a0 * b0) + (a1 * b1) + (a2 * b2) + (a3 * b3)
        i += 4
    end
    while i < limit
        let ai: float = a[i]
        let bi: float = b[i]
        sum += ai * bi
        i += 1
    end
    return sum
end

## High-throughput 4-way unrolled summation of float array elements.
##
## ### Parameters
## - `arr`: Array of numbers to add up.
##
## ### Returns
## The total of all elements as a float, or 0.0 for an empty array.
pub function sum_f64(arr) -> float
    let n: int = len(arr)
    let total: float = 0.0
    let i: int = 0
    let unroll_limit: int = n - 3
    while i < unroll_limit
        let e0: float = arr[i]
        let e1: float = arr[i + 1]
        let e2: float = arr[i + 2]
        let e3: float = arr[i + 3]
        total += (e0 + e1) + (e2 + e3)
        i += 4
    end
    while i < n
        let ei: float = arr[i]
        total += ei
        i += 1
    end
    return total
end

## Euclidean L2 norm (magnitude) of a vector: sqrt(sum(v_i^2)).
##
## ### Parameters
## - `v`: Vector as an array of numbers.
##
## ### Returns
## The Euclidean magnitude of `v` as a float.
pub function vector_norm(v) -> float
    let dot: float = dot_product(v, v)
    return native_sqrt(dot)
end

# --- Legacy Aliases ---

## Converts radians to degrees.
##
## ### Parameters
## - `rad`: Angle in radians.
##
## ### Returns
## The equivalent angle in degrees.
##
## See: `rad_to_deg`.
pub function degrees(rad: float) -> float
    return rad * (180.0 / 3.141592653589793)
end

## Alias for rand_int generating an inclusive random integer.
##
## See: `rand_int`.
pub function math__rand_int(min_val: int, max_val: int) -> int
    return rand_int(min_val, max_val)
end

## Alias for random generating a float in 0.0 to 1.0.
##
## See: `random`.
pub function math__random() -> float
    return random()
end

## Returns the square root of the value.
##
## ### Parameters
## - `x`: Value to take the square root of.
##
## ### Returns
## The square root of `x` as a float.
##
## See: `sqrt_f`.
pub function math__sqrt(x: float) -> float
    return native_sqrt(x)
end

## Converts degrees to radians.
##
## ### Parameters
## - `deg`: Angle in degrees.
##
## ### Returns
## The equivalent angle in radians.
##
## See: `deg_to_rad`.
pub function radians(deg: float) -> float
    return deg * (3.141592653589793 / 180.0)
end

## Alias for random generating a float in 0.0 to 1.0.
##
## See: `random`.
pub function rand_float() -> float
    return random()
end
