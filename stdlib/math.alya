# Alya Standard Library - Math Module (std/math)
# Provides mathematical constants, trigonometry, statistics, random numbers, and vector utilities.
# Usage: import "std/math"

# --- Constants ---

## Base of the natural logarithm.
##
## The constant e (approximately 2.71828), used as the base for `exp_f` and `log_n`.
pub let E: float = 2.718281828459045

## Natural logarithm of 10.
##
## The value ln(10) (approximately 2.30259), used to convert between natural and base-10 logarithms.
pub let LN10: float = 2.302585092994046

## Natural logarithm of 2.
##
## The value ln(2) (approximately 0.69315), used to convert between natural and base-2 logarithms.
pub let LN2: float = 0.6931471805599453

## Golden ratio.
##
## The value phi (approximately 1.61803), used in proportional scaling and aesthetic ratios.
pub let PHI: float = 1.618033988749895

## Ratio of a circle's circumference to its diameter.
##
## The constant pi (approximately 3.14159), used by the angle-conversion and trigonometry functions.
pub let PI: float = 3.141592653589793

## Square root of 2.
##
## The value sqrt(2) (approximately 1.41421), used as the diagonal scale of a unit square.
pub let SQRT2: float = 1.4142135623730951

## Ratio of a circle's circumference to its radius (2 times PI).
##
## The constant tau (approximately 6.28319), used for full-circle angles in radians.
pub let TAU: float = 6.283185307179586

# --- Angle Conversion ---

## Converts degrees to radians.
##
## ### Parameters
## - `deg`: Angle in degrees.
##
## ### Returns
## The equivalent angle in radians.
pub function deg_to_rad(deg: float) -> float
    return deg * (3.141592653589793 / 180.0)
end

## Converts radians to degrees.
##
## ### Parameters
## - `rad`: Angle in radians.
##
## ### Returns
## The equivalent angle in degrees.
pub function rad_to_deg(rad: float) -> float
    return rad * (180.0 / 3.141592653589793)
end

# --- Basic Utilities ---

## Clamps a value into the given inclusive range.
##
## ### Parameters
## - `val`: Value to clamp.
## - `min_val`: Lower bound of the range (inclusive).
## - `max_val`: Upper bound of the range (inclusive).
##
## ### Returns
## `min_val` when `val` is below it, `max_val` when `val` is above it, otherwise `val` unchanged.
pub function clamp(val, min_val, max_val)
    return when val
        is < min_val => min_val
        is > max_val => max_val
        else => val
    end
end

## Returns the floating-point remainder of a divided by b.
##
## ### Parameters
## - `a`: Dividend, converted to float.
## - `b`: Divisor, converted to float.
##
## ### Returns
## The floating-point remainder of `a` divided by `b`.
pub function fmod(a, b) -> float
    return native_fmod(float(a), float(b))
end

## Tests whether a number is even.
##
## ### Parameters
## - `n`: Integer to test.
##
## ### Returns
## 1 when `n` is even, 0 otherwise.
pub function is_even(n: int) -> int
    return n % 2 == 0
end

## Tests whether a number is odd.
##
## ### Parameters
## - `n`: Integer to test.
##
## ### Returns
## 1 when `n` is odd, 0 otherwise.
pub function is_odd(n: int) -> int
    return n % 2 != 0
end

## Returns 1, -1, or 0 for positive, negative, or zero input.
##
## ### Parameters
## - `val`: Value whose sign is tested.
##
## ### Returns
## 1 for a positive input, -1 for a negative input, or 0 for zero.
pub function sign(val) -> int
    return when val
        is > 0 => 1
        is < 0 => -1
        else => 0
    end
end

# --- Roots and Powers ---

## Returns the hypotenuse length for sides a and b.
##
## ### Parameters
## - `a`: Length of the first side, converted to float.
## - `b`: Length of the second side, converted to float.
##
## ### Returns
## The hypotenuse length `sqrt(a^2 + b^2)` as a float.
pub function hypot(a, b) -> float
    let fa: float = float(a)
    let fb: float = float(b)
    return native_sqrt(fa * fa + fb * fb)
end

## Returns the square root of the value.
##
## ### Parameters
## - `x`: Value to take the square root of, converted to float.
##
## ### Returns
## The square root of `x` as a float.
pub function sqrt_f(x) -> float
    return native_sqrt(float(x))
end

# --- Rounding ---

## Rounds a float up to the nearest integer.
##
## ### Parameters
## - `val`: Float value to round up.
##
## ### Returns
## The smallest integer greater than or equal to `val`.
pub function ceil(val: float) -> int
    let iv: int = int(val)
    if val <= 0.0 or float(iv) == val
        return iv
    else
        return iv + 1
    end
end

## Rounds a float down to the nearest integer.
##
## ### Parameters
## - `val`: Float value to round down.
##
## ### Returns
## The largest integer less than or equal to `val`.
pub function floor(val: float) -> int
    let iv: int = int(val)
    if val >= 0.0 or float(iv) == val
        return iv
    else
        return iv - 1
    end
end

## Rounds a float to the nearest integer, with halves away from zero.
##
## ### Parameters
## - `val`: Float value to round.
##
## ### Returns
## The nearest integer to `val`; a non-negative input rounds up at .5 and a negative input rounds down at .5.
pub function round(val: float) -> int
    return when val
        is >= 0.0 => int(val + 0.5)
        else => int(val - 0.5)
    end
end

## Truncates a float toward zero.
##
## ### Parameters
## - `val`: Float value to truncate.
##
## ### Returns
## The integer part of `val`, with any fractional part discarded toward zero.
pub function trunc(val: float) -> int
    return int(val)
end

# --- Trigonometry ---

# Private helper that wraps an angle in radians into the [-PI, PI] range.
function _normalize_angle(rad: float) -> float
    let two_pi: float = 6.283185307179586
    let pi: float = 3.141592653589793
    let cycles: int = int(rad / two_pi)
    let rem: float = rad - float(cycles) * two_pi
    while rem > pi
        rem = rem - two_pi
    end
    while rem < -pi
        rem = rem + two_pi
    end
    return rem
end

## Returns the arc cosine of the value in radians.
##
## ### Parameters
## - `x`: Cosine value, converted to float.
##
## ### Returns
## The arc cosine of `x` in radians.
pub function acos(x) -> float
    return native_acos(float(x))
end

## Returns the arc sine of the value in radians.
##
## ### Parameters
## - `x`: Sine value, converted to float.
##
## ### Returns
## The arc sine of `x` in radians.
pub function asin(x) -> float
    return native_asin(float(x))
end

## Returns the arc tangent of the value in radians.
##
## ### Parameters
## - `x`: Tangent value, converted to float.
##
## ### Returns
## The arc tangent of `x` in radians.
pub function atan(x) -> float
    return native_atan(float(x))
end

## Returns the angle of point (y, x) in radians.
##
## ### Parameters
## - `y`: Y coordinate of the point, converted to float.
## - `x`: X coordinate of the point, converted to float.
##
## ### Returns
## The angle of the point in radians, measured from the positive X axis.
pub function atan2(y, x) -> float
    return native_atan2(float(y), float(x))
end

## Returns the cosine of the angle in radians.
##
## ### Parameters
## - `x`: Angle in radians, converted to float.
##
## ### Returns
## The cosine of the angle.
pub function cos(x) -> float
    return native_cos(float(x))
end

## Returns the sine of the angle in radians.
##
## ### Parameters
## - `x`: Angle in radians, converted to float.
##
## ### Returns
## The sine of the angle.
pub function sin(x) -> float
    return native_sin(float(x))
end

## Returns the tangent of the angle in radians.
##
## ### Parameters
## - `x`: Angle in radians, converted to float.
##
## ### Returns
## The tangent of the angle.
pub function tan(x) -> float
    return native_tan(float(x))
end

