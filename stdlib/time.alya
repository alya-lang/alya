# Alya Standard Library - Time Module (std/time)
# Provides time querying, delay routines, and UTC calendar conversions.
# Durations are expressed in seconds unless a name says otherwise.
# Usage: import "std/time"

# --- Clock Queries ---

## Returns the current epoch time in seconds.
##
## ### Parameters
## None.
##
## ### Returns
## The current Unix epoch time in seconds.
pub function now() -> int
    return time()
end

## Returns the current monotonic clock in milliseconds.
##
## ### Parameters
## None.
##
## ### Returns
## The current monotonic clock reading in milliseconds.
pub function now_millis() -> int
    return clock_ms()
end

## Returns the current monotonic clock in milliseconds.
##
## ### Parameters
## None.
##
## ### Returns
## The current monotonic clock reading in milliseconds.
pub function now_ms() -> int
    return clock_ms()
end

## Returns the current monotonic clock in nanoseconds.
##
## ### Parameters
## None.
##
## ### Returns
## The current monotonic clock reading in nanoseconds (millisecond resolution, scaled from the millisecond clock).
pub function now_nanos() -> int
    return clock_ms() * 1000000
end

## Returns the current epoch time in seconds.
##
## ### Parameters
## None.
##
## ### Returns
## The current Unix epoch time in seconds.
pub function timestamp() -> int
    return time()
end

# --- Delays ---

## Sleeps for the given number of milliseconds.
##
## ### Parameters
## - `ms`: Sleep duration in milliseconds.
##
## ### Returns
## Nothing.
pub function delay(ms: int)
    return sleep(ms)
end

## Sleeps for the given number of seconds.
##
## ### Parameters
## - `seconds`: Sleep duration in seconds (converted to milliseconds internally).
##
## ### Returns
## Nothing.
pub function sleep_sec(seconds: int)
    return sleep(seconds * 1000)
end

# --- Elapsed Time ---

## Returns seconds elapsed since a start time taken from time().
##
## ### Parameters
## - `start_time`: Earlier reading from `time()` in epoch seconds.
##
## ### Returns
## Seconds elapsed since `start_time`.
pub function elapsed(start_time: int) -> int
    return time() - start_time
end

## Returns milliseconds elapsed since a start time taken from clock_ms().
##
## ### Parameters
## - `start_time_ms`: Earlier reading from `clock_ms()` in milliseconds.
##
## ### Returns
## Milliseconds elapsed since `start_time_ms`.
pub function elapsed_ms(start_time_ms: int) -> int
    return clock_ms() - start_time_ms
end

# --- Duration Units ---

## Converts a day count to seconds.
##
## ### Parameters
## - `d`: Day count.
##
## ### Returns
## The matching duration in seconds.
pub function days(d: int) -> int
    return d * 86400
end

## Converts an hour count to seconds.
##
## ### Parameters
## - `h`: Hour count.
##
## ### Returns
## The matching duration in seconds.
pub function hours(h: int) -> int
    return h * 3600
end

## Converts a minute count to seconds.
##
## ### Parameters
## - `m`: Minute count.
##
## ### Returns
## The matching duration in seconds.
pub function minutes(m: int) -> int
    return m * 60
end

## Returns the value unchanged as seconds.
##
## ### Parameters
## - `s`: Value in seconds.
##
## ### Returns
## The value unchanged, in seconds.
pub function seconds(s: int) -> int
    return s
end

# --- Calendar Calculations ---

## Converts a date map with year, month, day, and optional time fields to epoch seconds.
##
## ### Parameters
## - `d`: Calendar map with `year`, `month`, and `day` fields plus optional `hour`, `minute`, and `second` fields (missing time fields default to 0).
##
## ### Returns
## The matching UTC epoch time in seconds.
pub function date_to_epoch(d) -> int
    let ymd_sec: int = date_ymd_to_epoch(d["year"], d["month"], d["day"])
    let h: int = 0
    let m: int = 0
    let s: int = 0
    if d.has("hour") h = d["hour"] end
    if d.has("minute") m = d["minute"] end
    if d.has("second") s = d["second"] end
    return ymd_sec + (h * 3600) + (m * 60) + s
end

## Converts a year, month, and day to epoch seconds at 00:00:00 UTC.
##
## ### Parameters
## - `year`: Gregorian year.
## - `month`: Month number.
## - `day`: Day of the month.
##
## ### Returns
## The epoch time in seconds for the given date at 00:00:00 UTC.
pub function date_ymd_to_epoch(year: int, month: int, day: int) -> int
    let y: int = year
    if month <= 2
        y -= 1
    end
    let era: int = y / 400
    if y < 0 and y % 400 != 0
        era -= 1
    end
    let yoe: int = y - (era * 400)
    let m_adj: int = 0
    if month > 2
        m_adj = month - 3
    else
        m_adj = month + 9
    end
    let doy: int = (((153 * m_adj) + 2) / 5) + day - 1
    let doe: int = (yoe * 365) + (yoe / 4) - (yoe / 100) + doy
    let days: int = (era * 146097) + doe - 719468
    return days * 86400
end

## Returns the number of days in a month for a given year.
##
## ### Parameters
## - `month`: Month number (1-12).
## - `year`: Gregorian year (decides the February length in leap years).
##
## ### Returns
## The day count (31, 30, 29, or 28), or 0 when the month is out of range.
pub function days_in_month(month: int, year: int) -> int
    when month
        is 1, 3, 5, 7, 8, 10, 12 then return 31
        is 4, 6, 9, 11 then return 30
        is 2 then
            if is_leap_year(year)
                return 29
            end
            return 28
        else
            return 0
    end
end

## Converts UTC epoch seconds to a calendar map with year, month, day, hour, minute, second, and weekday.
##
## ### Parameters
## - `epoch_sec`: UTC epoch time in seconds (may be negative for pre-1970 dates).
##
## ### Returns
## A calendar map with `year`, `month`, `day`, `hour`, `minute`, `second`, and `weekday` fields (Sunday is 0).
pub function epoch_to_date(epoch_sec: int)
    let days: int = epoch_sec / 86400
    let rem: int = epoch_sec % 86400
    if rem < 0
        rem += 86400
        days -= 1
    end
    let hour: int = rem / 3600
    let minute: int = (rem % 3600) / 60
    let second: int = rem % 60
    let weekday: int = (days + 4) % 7
    if weekday < 0
        weekday += 7
    end

    let z: int = days + 719468
    let era: int = z / 146097
    if z < 0 and z % 146097 != 0
        era -= 1
    end
    let doe: int = z - (era * 146097)
    let yoe: int = (doe - (doe / 1460) + (doe / 36524) - (doe / 146096)) / 365
    let y: int = yoe + (era * 400)
    let doy: int = doe - ((365 * yoe) + (yoe / 4) - (yoe / 100))
    let mp: int = ((5 * doy) + 2) / 153
    let d: int = doy - (((153 * mp) + 2) / 5) + 1
    let m: int = 0
    if mp < 10
        m = mp + 3
    else
        m = mp - 9
    end
    let year: int = y
    if m <= 2
        year = y + 1
    end
    return {
        "year": year,
        "month": m,
        "day": d,
        "hour": hour,
        "minute": minute,
        "second": second,
        "weekday": weekday
    }
end

## Returns true when a Gregorian year is a leap year.
##
## ### Parameters
## - `year`: Gregorian year.
##
## ### Returns
## True when the year is a leap year, else false.
pub function is_leap_year(year: int) -> bool
    if year % 400 == 0
        return true
    elif year % 100 == 0
        return false
    end
    return year % 4 == 0
end

# --- Formatting and Names ---

function _time_pad2(n: int) -> string
    if n < 10
        return f"0{n}"
    end
    return str(n)
end

## Formats epoch seconds as YYYY-MM-DD.
##
## ### Parameters
## - `epoch_sec`: UTC epoch time in seconds.
##
## ### Returns
## The date formatted as YYYY-MM-DD.
pub function format_date(epoch_sec: int) -> string
    let d = epoch_to_date(epoch_sec)
    let yr = d["year"]
    let mo = _time_pad2(d["month"])
    let dy = _time_pad2(d["day"])
    return f"{yr}-{mo}-{dy}"
end

## Formats a calendar date/time map as an ISO 8601 UTC string.
##
## ### Parameters
## - `d`: Calendar map with `year`, `month`, `day`, `hour`, `minute`, and `second` fields (all six are read directly).
##
## ### Returns
## The date/time formatted as an ISO 8601 UTC string (YYYY-MM-DDTHH:MM:SSZ).
pub function format_date_map(d) -> string
    let yr = d["year"]
    let mo = _time_pad2(d["month"])
    let dy = _time_pad2(d["day"])
    let hr = _time_pad2(d["hour"])
    let mn = _time_pad2(d["minute"])
    let sc = _time_pad2(d["second"])
    return f"{yr}-{mo}-{dy}T{hr}:{mn}:{sc}Z"
end

## Formats seconds as a human-readable duration like 1h 2m 3s.
##
## ### Parameters
## - `sec`: Duration in seconds.
##
## ### Returns
## The human-readable duration string (hours shown only when nonzero; minutes shown when nonzero or hours are present; seconds always shown).
pub function format_duration(sec: int) -> string
    let h: int = sec / 3600
    let rem: int = sec % 3600
    let m: int = rem / 60
    let s: int = rem % 60
    let res: string = ""
    if h > 0
        res = f"{res}{h}h "
    end
    if m > 0 or h > 0
        res = f"{res}{m}m "
    end
    return f"{res}{s}s"
end

## Formats epoch seconds as an ISO 8601 UTC string.
##
## ### Parameters
## - `epoch_sec`: UTC epoch time in seconds.
##
## ### Returns
## The date/time formatted as an ISO 8601 UTC string (YYYY-MM-DDTHH:MM:SSZ).
pub function format_iso(epoch_sec: int) -> string
    let d = epoch_to_date(epoch_sec)
    let yr = d["year"]
    let mo = _time_pad2(d["month"])
    let dy = _time_pad2(d["day"])
    let hr = _time_pad2(d["hour"])
    let mn = _time_pad2(d["minute"])
    let sc = _time_pad2(d["second"])
    return f"{yr}-{mo}-{dy}T{hr}:{mn}:{sc}Z"
end

## Formats epoch seconds as HH:MM:SS.
##
## ### Parameters
## - `epoch_sec`: UTC epoch time in seconds.
##
## ### Returns
## The time of day formatted as HH:MM:SS.
pub function format_time_hhmmss(epoch_sec: int) -> string
    let d = epoch_to_date(epoch_sec)
    let hr = _time_pad2(d["hour"])
    let mn = _time_pad2(d["minute"])
    let sc = _time_pad2(d["second"])
    return f"{hr}:{mn}:{sc}"
end

## Returns the full English month name.
##
## ### Parameters
## - `month`: Month number (1-12).
##
## ### Returns
## The full English month name, or "Unknown" when out of range.
pub function month_name(month: int) -> string
    return when month
        is 1 => "January"
        is 2 => "February"
        is 3 => "March"
        is 4 => "April"
        is 5 => "May"
        is 6 => "June"
        is 7 => "July"
        is 8 => "August"
        is 9 => "September"
        is 10 => "October"
        is 11 => "November"
        is 12 => "December"
        else => "Unknown"
    end
end

## Returns the abbreviated English month name.
##
## ### Parameters
## - `month`: Month number (1-12).
##
## ### Returns
## The abbreviated English month name, or "Unk" when out of range.
pub function month_short_name(month: int) -> string
    return when month
        is 1 => "Jan"
        is 2 => "Feb"
        is 3 => "Mar"
        is 4 => "Apr"
        is 5 => "May"
        is 6 => "Jun"
        is 7 => "Jul"
        is 8 => "Aug"
        is 9 => "Sep"
        is 10 => "Oct"
        is 11 => "Nov"
        is 12 => "Dec"
        else => "Unk"
    end
end

## Returns the full English weekday name with Sunday as 0.
##
## ### Parameters
## - `weekday`: Weekday number with Sunday as 0.
##
## ### Returns
## The full English weekday name, or "Unknown" when out of range.
pub function weekday_name(weekday: int) -> string
    return when weekday
        is 0 => "Sunday"
        is 1 => "Monday"
        is 2 => "Tuesday"
        is 3 => "Wednesday"
        is 4 => "Thursday"
        is 5 => "Friday"
        is 6 => "Saturday"
        else => "Unknown"
    end
end

## Returns the abbreviated English weekday name with Sunday as 0.
##
## ### Parameters
## - `weekday`: Weekday number with Sunday as 0.
##
## ### Returns
## The abbreviated English weekday name, or "Unk" when out of range.
pub function weekday_short_name(weekday: int) -> string
    return when weekday
        is 0 => "Sun"
        is 1 => "Mon"
        is 2 => "Tue"
        is 3 => "Wed"
        is 4 => "Thu"
        is 5 => "Fri"
        is 6 => "Sat"
        else => "Unk"
    end
end

# --- Current Time Shortcuts ---

## Returns the current UTC date as YYYY-MM-DD.
##
## ### Parameters
## None.
##
## ### Returns
## The current UTC date formatted as YYYY-MM-DD.
pub function date_now() -> string
    return format_date(time())
end

## Returns the current UTC time as an ISO 8601 string.
##
## ### Parameters
## None.
##
## ### Returns
## The current UTC date/time formatted as an ISO 8601 string.
pub function iso_now() -> string
    return format_iso(time())
end

## Returns the current UTC time as HH:MM:SS.
##
## ### Parameters
## None.
##
## ### Returns
## The current UTC time of day formatted as HH:MM:SS.
pub function time_now() -> string
    return format_time_hhmmss(time())
end

# --- Durations (millisecond-based) ---

## Builds a millisecond duration from a second count.
##
## ### Parameters
## - `s`: Duration in seconds.
##
## ### Returns
## The matching duration in milliseconds.
pub function duration_from_seconds(s: int) -> int
    return s * 1000
end

## Builds a millisecond duration from a minute count.
##
## ### Parameters
## - `m`: Duration in minutes.
##
## ### Returns
## The matching duration in milliseconds.
pub function duration_from_minutes(m: int) -> int
    return m * 60000
end

## Builds a millisecond duration from an hour count.
##
## ### Parameters
## - `h`: Duration in hours.
##
## ### Returns
## The matching duration in milliseconds.
pub function duration_from_hours(h: int) -> int
    return h * 3600000
end

## Builds a millisecond duration from a day count.
##
## ### Parameters
## - `d`: Duration in days.
##
## ### Returns
## The matching duration in milliseconds.
pub function duration_from_days(d: int) -> int
    return d * 86400000
end

## Converts a millisecond duration to whole seconds (truncated).
##
## ### Parameters
## - `ms`: Duration in milliseconds.
##
## ### Returns
## Whole seconds in the duration.
pub function duration_to_seconds(ms: int) -> int
    return ms / 1000
end

## Converts a millisecond duration to whole minutes (truncated).
##
## ### Parameters
## - `ms`: Duration in milliseconds.
##
## ### Returns
## Whole minutes in the duration.
pub function duration_to_minutes(ms: int) -> int
    return ms / 60000
end

## Converts a millisecond duration to whole hours (truncated).
##
## ### Parameters
## - `ms`: Duration in milliseconds.
##
## ### Returns
## Whole hours in the duration.
pub function duration_to_hours(ms: int) -> int
    return ms / 3600000
end

## Converts a millisecond duration to whole days (truncated).
##
## ### Parameters
## - `ms`: Duration in milliseconds.
##
## ### Returns
## Whole days in the duration.
pub function duration_to_days(ms: int) -> int
    return ms / 86400000
end

## Formats a millisecond duration as a human-readable string.
## Hours render as `H:MM:SS`, minutes as `M:SS.mmm`, seconds as `S.mmm s`,
## and sub-second values as `Nms` (negative durations keep a `-` prefix).
##
## ### Parameters
## - `ms`: Duration in milliseconds (may be negative).
##
## ### Returns
## The human-readable duration string.
pub function duration_str(ms: int) -> string
    let sign: string = ""
    let t: int = ms
    if t < 0
        sign = "-"
        t = 0 - t
    end
    let hr: int = t / 3600000
    let rem: int = t - hr * 3600000
    let mn: int = rem / 60000
    rem -= mn * 60000
    let sc: int = rem / 1000
    let msl: int = rem - sc * 1000
    if hr > 0
        return f"{sign}{hr}:{_time_pad2(mn)}:{_time_pad2(sc)}"
    end
    if mn > 0
        return f"{sign}{mn}:{_time_pad2(sc)}.{_time_pad3(msl)}"
    end
    if sc > 0
        return f"{sign}{sc}.{_time_pad3(msl)}s"
    end
    return f"{sign}{t}ms"
end

function _time_pad3(n: int) -> string
    if n < 10
        return f"00{n}"
    end
    if n < 100
        return f"0{n}"
    end
    return str(n)
end

# --- Stopwatch ---

## Monotonic stopwatch handle: the `clock_ms()` reading at creation.
##
## ### Fields
## - `start_ms`: Monotonic clock reading in milliseconds taken by `stopwatch_new`.
pub struct Stopwatch
    start_ms: int
end

## Starts a new monotonic stopwatch.
##
## ### Parameters
## None.
##
## ### Returns
## A Stopwatch capturing the current monotonic clock reading.
pub function stopwatch_new() -> Stopwatch
    return Stopwatch { start_ms: clock_ms() }
end

## Returns milliseconds elapsed since the stopwatch was started (or restarted).
##
## ### Parameters
## - `self`: Stopwatch measured.
##
## ### Returns
## Milliseconds elapsed since `start_ms`.
pub function Stopwatch.elapsed(self: Stopwatch) -> int
    return clock_ms() - self.start_ms
end

## Restarts the stopwatch from the current monotonic clock reading.
##
## ### Parameters
## - `self`: Stopwatch restarted.
##
## ### Returns
## Nothing.
pub function Stopwatch.restart(self: Stopwatch)
    self.start_ms = clock_ms()
end

# --- Parsing (ISO 8601 / RFC 3339) ---

## Error thrown when a date/time string cannot be parsed.
##
## ### Fields
## - `message`: Human-readable parse failure description.
pub struct TimeParseError
    message: string
end

function _time_is_digits(s: string) -> bool
    if len(s) == 0
        return false
    end
    let i: int = 0
    while i < len(s)
        let c: int = ord(char_at(s, i))
        if c < 48 or c > 57
            return false
        end
        i += 1
    end
    return true
end

function _time_num(s: string, pos: int, count: int) -> int
    if pos < 0 or count <= 0 or pos + count > len(s)
        return -1
    end
    let part: string = substring(s, pos, count)
    if _time_is_digits(part) == false
        return -1
    end
    return to_int(part)
end

function _time_parse_datetime(s: string, allow_bare: int) -> int
    let n: int = len(s)
    if n < 10
        throw TimeParseError { message: f"Invalid datetime (too short): {s}" }
    end
    let year: int = _time_num(s, 0, 4)
    let month: int = _time_num(s, 5, 2)
    let day: int = _time_num(s, 8, 2)
    if year < 0 or char_at(s, 4) != "-" or char_at(s, 7) != "-"
        throw TimeParseError { message: f"Invalid date (expected YYYY-MM-DD): {s}" }
    end
    if month < 0 or day < 0
        throw TimeParseError { message: f"Invalid date (expected YYYY-MM-DD): {s}" }
    end
    if day < 1 or day > days_in_month(month, year)
        throw TimeParseError { message: f"Invalid calendar date: {s}" }
    end
    if n == 10
        if allow_bare == false
            throw TimeParseError { message: f"Missing time and zone (RFC 3339 requires full timestamp): {s}" }
        end
        return date_ymd_to_epoch(year, month, day)
    end
    let sep: string = char_at(s, 10)
    if sep != "T" and sep != "t" and sep != " "
        throw TimeParseError { message: f"Invalid separator (expected T): {s}" }
    end
    if n < 19
        throw TimeParseError { message: f"Invalid time (expected HH:MM:SS): {s}" }
    end
    let hour: int = _time_num(s, 11, 2)
    let minute: int = _time_num(s, 14, 2)
    let second: int = _time_num(s, 17, 2)
    if hour < 0 or char_at(s, 13) != ":" or char_at(s, 16) != ":"
        throw TimeParseError { message: f"Invalid time (expected HH:MM:SS): {s}" }
    end
    if minute < 0 or second < 0
        throw TimeParseError { message: f"Invalid time (expected HH:MM:SS): {s}" }
    end
    if hour > 23 or minute > 59 or second > 59
        throw TimeParseError { message: f"Time out of range: {s}" }
    end
    let pos: int = 19
    if pos < n and char_at(s, pos) == "."
        pos += 1
        let frac_start: int = pos
        while pos < n and _time_is_digits(char_at(s, pos)) == true
            pos += 1
        end
        if pos == frac_start
            throw TimeParseError { message: f"Invalid fraction (digits expected after .): {s}" }
        end
    end
    let offset_sec: int = 0
    if pos >= n
        if allow_bare == false
            throw TimeParseError { message: f"Missing zone (RFC 3339 requires Z or offset): {s}" }
        end
    else
        let z: string = char_at(s, pos)
        if z == "Z" or z == "z"
            pos += 1
        elif z == "+" or z == "-"
            let sign: int = 1
            if z == "-"
                sign = 0 - 1
            end
            let oh: int = _time_num(s, pos + 1, 2)
            if oh < 0
                throw TimeParseError { message: f"Invalid zone offset hour: {s}" }
            end
            if oh > 23
                throw TimeParseError { message: f"Zone offset hour out of range: {s}" }
            end
            let om: int = 0
            let rest: int = n - (pos + 3)
            if rest == 0
                om = 0
                pos = n
            elif rest == 3 and char_at(s, pos + 3) == ":"
                om = _time_num(s, pos + 4, 2)
                if om < 0 or om > 59
                    throw TimeParseError { message: f"Invalid zone offset minute: {s}" }
                end
                pos = n
            elif rest == 2
                om = _time_num(s, pos + 3, 2)
                if om < 0 or om > 59
                    throw TimeParseError { message: f"Invalid zone offset minute: {s}" }
                end
                pos = n
            else
                throw TimeParseError { message: f"Invalid zone offset (expected HH, HHMM or HH:MM): {s}" }
            end
            offset_sec = sign * (oh * 3600 + om * 60)
        else
            throw TimeParseError { message: f"Invalid zone (expected Z or offset): {s}" }
        end
    end
    if pos != n
        throw TimeParseError { message: f"Trailing characters: {s}" }
    end
    return date_ymd_to_epoch(year, month, day) + (hour * 3600) + (minute * 60) + second - offset_sec
end

## Parses an ISO 8601 string into UTC epoch seconds.
## Accepts `YYYY-MM-DD`, `YYYY-MM-DDTHH:MM:SS` (UTC when the zone is
## absent), an optional fraction (`.mmm`, ignored beyond seconds), and a
## zone of `Z` or `+-HH[:][MM]`. The `T` may be lowercase or a space.
##
## ### Parameters
## - `s`: ISO 8601 date/time string.
##
## ### Returns
## UTC epoch seconds.
##
## ### Throws
## `TimeParseError` when the string is not a supported ISO 8601 shape.
pub function parse_iso8601(s: string) -> int
    return _time_parse_datetime(s, 1)
end

## Parses an RFC 3339 string into UTC epoch seconds.
## Requires a full timestamp with a zone: `YYYY-MM-DDTHH:MM:SSZ` or
## `YYYY-MM-DDTHH:MM:SS+-HH:MM` (lowercase `t`/`z` accepted, `+-HHMM` and
## `+-HH` also accepted). Calendar fields keep wall time; the result is the
## absolute UTC instant, so `format_rfc3339` of it renders in UTC.
##
## ### Parameters
## - `s`: RFC 3339 date/time string.
##
## ### Returns
## UTC epoch seconds.
##
## ### Throws
## `TimeParseError` when the string is not RFC 3339 (bare or zone-less
## inputs are rejected, unlike `parse_iso8601`).
pub function parse_rfc3339(s: string) -> int
    return _time_parse_datetime(s, 0)
end

## Formats epoch seconds as an RFC 3339 UTC string.
## UTC profile (`YYYY-MM-DDTHH:MM:SSZ`); identical to `format_iso` because
## epoch resolution is seconds (see `parse_rfc3339` for the reverse).
##
## ### Parameters
## - `epoch_sec`: UTC epoch time in seconds.
##
## ### Returns
## The date/time formatted as an RFC 3339 UTC string.
pub function format_rfc3339(epoch_sec: int) -> string
    return format_iso(epoch_sec)
end

# --- Legacy Aliases ---

## Legacy alias returning the monotonic clock in milliseconds.
## See: `now_millis`.
pub function time__now_millis() -> int
    return now_millis()
end

## Legacy alias sleeping for the given number of milliseconds.
## See: `delay`.
pub function time__sleep(ms: int)
    sleep(ms)
end
