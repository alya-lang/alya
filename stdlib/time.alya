# Alya Standard Library - Time Module (std/time)
# Provides time querying, delay routines, and UTC calendar conversions.
# Durations are expressed in seconds unless a name says otherwise.
# Usage: import "std/time"

# --- Clock Queries ---

## Returns the current epoch time in seconds.
##
## ### Parameters
## None.
##
## ### Returns
## The current Unix epoch time in seconds.
pub function now() -> int
    return time()
end

## Returns the current monotonic clock in milliseconds.
##
## ### Parameters
## None.
##
## ### Returns
## The current monotonic clock reading in milliseconds.
pub function now_millis() -> int
    return clock_ms()
end

## Returns the current monotonic clock in milliseconds.
##
## ### Parameters
## None.
##
## ### Returns
## The current monotonic clock reading in milliseconds.
pub function now_ms() -> int
    return clock_ms()
end

## Returns the current monotonic clock in nanoseconds.
##
## ### Parameters
## None.
##
## ### Returns
## The current monotonic clock reading in nanoseconds (millisecond resolution, scaled from the millisecond clock).
pub function now_nanos() -> int
    return clock_ms() * 1000000
end

## Returns the current epoch time in seconds.
##
## ### Parameters
## None.
##
## ### Returns
## The current Unix epoch time in seconds.
pub function timestamp() -> int
    return time()
end

# --- Delays ---

## Sleeps for the given number of milliseconds.
##
## ### Parameters
## - `ms`: Sleep duration in milliseconds.
##
## ### Returns
## Nothing.
pub function delay(ms: int)
    return sleep(ms)
end

## Sleeps for the given number of seconds.
##
## ### Parameters
## - `seconds`: Sleep duration in seconds (converted to milliseconds internally).
##
## ### Returns
## Nothing.
pub function sleep_sec(seconds: int)
    return sleep(seconds * 1000)
end

# --- Elapsed Time ---

## Returns seconds elapsed since a start time taken from time().
##
## ### Parameters
## - `start_time`: Earlier reading from `time()` in epoch seconds.
##
## ### Returns
## Seconds elapsed since `start_time`.
pub function elapsed(start_time: int) -> int
    return time() - start_time
end

## Returns milliseconds elapsed since a start time taken from clock_ms().
##
## ### Parameters
## - `start_time_ms`: Earlier reading from `clock_ms()` in milliseconds.
##
## ### Returns
## Milliseconds elapsed since `start_time_ms`.
pub function elapsed_ms(start_time_ms: int) -> int
    return clock_ms() - start_time_ms
end

# --- Duration Units ---

## Converts a day count to seconds.
##
## ### Parameters
## - `d`: Day count.
##
## ### Returns
## The matching duration in seconds.
pub function days(d: int) -> int
    return d * 86400
end

## Converts an hour count to seconds.
##
## ### Parameters
## - `h`: Hour count.
##
## ### Returns
## The matching duration in seconds.
pub function hours(h: int) -> int
    return h * 3600
end

## Converts a minute count to seconds.
##
## ### Parameters
## - `m`: Minute count.
##
## ### Returns
## The matching duration in seconds.
pub function minutes(m: int) -> int
    return m * 60
end

## Returns the value unchanged as seconds.
##
## ### Parameters
## - `s`: Value in seconds.
##
## ### Returns
## The value unchanged, in seconds.
pub function seconds(s: int) -> int
    return s
end

# --- Calendar Calculations ---

## Converts a date map with year, month, day, and optional time fields to epoch seconds.
##
## ### Parameters
## - `d`: Calendar map with `year`, `month`, and `day` fields plus optional `hour`, `minute`, and `second` fields (missing time fields default to 0).
##
## ### Returns
## The matching UTC epoch time in seconds.
pub function date_to_epoch(d) -> int
    let ymd_sec: int = date_ymd_to_epoch(d["year"], d["month"], d["day"])
    let h: int = 0
    let m: int = 0
    let s: int = 0
    if d.has("hour") h = d["hour"] end
    if d.has("minute") m = d["minute"] end
    if d.has("second") s = d["second"] end
    return ymd_sec + (h * 3600) + (m * 60) + s
end

## Converts a year, month, and day to epoch seconds at 00:00:00 UTC.
##
## ### Parameters
## - `year`: Gregorian year.
## - `month`: Month number.
## - `day`: Day of the month.
##
## ### Returns
## The epoch time in seconds for the given date at 00:00:00 UTC.
pub function date_ymd_to_epoch(year: int, month: int, day: int) -> int
    let y: int = year
    if month <= 2
        y = y - 1
    end
    let era: int = y / 400
    if y < 0 and y % 400 != 0
        era = era - 1
    end
    let yoe: int = y - (era * 400)
    let m_adj: int = 0
    if month > 2
        m_adj = month - 3
    else
        m_adj = month + 9
    end
    let doy: int = (((153 * m_adj) + 2) / 5) + day - 1
    let doe: int = (yoe * 365) + (yoe / 4) - (yoe / 100) + doy
    let days: int = (era * 146097) + doe - 719468
    return days * 86400
end

## Returns the number of days in a month for a given year.
##
## ### Parameters
## - `month`: Month number (1-12).
## - `year`: Gregorian year (decides the February length in leap years).
##
## ### Returns
## The day count (31, 30, 29, or 28), or 0 when the month is out of range.
pub function days_in_month(month: int, year: int) -> int
    when month
        is 1, 3, 5, 7, 8, 10, 12 then return 31
        is 4, 6, 9, 11 then return 30
        is 2 then
            if is_leap_year(year)
                return 29
            end
            return 28
        else
            return 0
    end
end

## Converts UTC epoch seconds to a calendar map with year, month, day, hour, minute, second, and weekday.
##
## ### Parameters
## - `epoch_sec`: UTC epoch time in seconds (may be negative for pre-1970 dates).
##
## ### Returns
## A calendar map with `year`, `month`, `day`, `hour`, `minute`, `second`, and `weekday` fields (Sunday is 0).
pub function epoch_to_date(epoch_sec: int)
    let days: int = epoch_sec / 86400
    let rem: int = epoch_sec % 86400
    if rem < 0
        rem = rem + 86400
        days = days - 1
    end
    let hour: int = rem / 3600
    let minute: int = (rem % 3600) / 60
    let second: int = rem % 60
    let weekday: int = (days + 4) % 7
    if weekday < 0
        weekday = weekday + 7
    end

    let z: int = days + 719468
    let era: int = z / 146097
    if z < 0 and z % 146097 != 0
        era = era - 1
    end
    let doe: int = z - (era * 146097)
    let yoe: int = (doe - (doe / 1460) + (doe / 36524) - (doe / 146096)) / 365
    let y: int = yoe + (era * 400)
    let doy: int = doe - ((365 * yoe) + (yoe / 4) - (yoe / 100))
    let mp: int = ((5 * doy) + 2) / 153
    let d: int = doy - (((153 * mp) + 2) / 5) + 1
    let m: int = 0
    if mp < 10
        m = mp + 3
    else
        m = mp - 9
    end
    let year: int = y
    if m <= 2
        year = y + 1
    end
    return {
        "year": year,
        "month": m,
        "day": d,
        "hour": hour,
        "minute": minute,
        "second": second,
        "weekday": weekday
    }
end

## Returns 1 when a Gregorian year is a leap year.
##
## ### Parameters
## - `year`: Gregorian year.
##
## ### Returns
## 1 when the year is a leap year, else 0.
pub function is_leap_year(year: int) -> int
    if year % 400 == 0
        return 1
    elif year % 100 == 0
        return 0
    end
    return year % 4 == 0
end

# --- Formatting and Names ---

function _time_pad2(n: int) -> string
    if n < 10
        return f"0{n}"
    end
    return str(n)
end

## Formats epoch seconds as YYYY-MM-DD.
##
## ### Parameters
## - `epoch_sec`: UTC epoch time in seconds.
##
## ### Returns
## The date formatted as YYYY-MM-DD.
pub function format_date(epoch_sec: int) -> string
    let d = epoch_to_date(epoch_sec)
    let yr = d["year"]
    let mo = _time_pad2(d["month"])
    let dy = _time_pad2(d["day"])
    return f"{yr}-{mo}-{dy}"
end

## Formats a calendar date/time map as an ISO 8601 UTC string.
##
## ### Parameters
## - `d`: Calendar map with `year`, `month`, `day`, `hour`, `minute`, and `second` fields (all six are read directly).
##
## ### Returns
## The date/time formatted as an ISO 8601 UTC string (YYYY-MM-DDTHH:MM:SSZ).
pub function format_date_map(d) -> string
    let yr = d["year"]
    let mo = _time_pad2(d["month"])
    let dy = _time_pad2(d["day"])
    let hr = _time_pad2(d["hour"])
    let mn = _time_pad2(d["minute"])
    let sc = _time_pad2(d["second"])
    return f"{yr}-{mo}-{dy}T{hr}:{mn}:{sc}Z"
end

## Formats seconds as a human-readable duration like 1h 2m 3s.
##
## ### Parameters
## - `sec`: Duration in seconds.
##
## ### Returns
## The human-readable duration string (hours shown only when nonzero; minutes shown when nonzero or hours are present; seconds always shown).
pub function format_duration(sec: int) -> string
    let h: int = sec / 3600
    let rem: int = sec % 3600
    let m: int = rem / 60
    let s: int = rem % 60
    let res: string = ""
    if h > 0
        res = f"{res}{h}h "
    end
    if m > 0 or h > 0
        res = f"{res}{m}m "
    end
    return f"{res}{s}s"
end

## Formats epoch seconds as an ISO 8601 UTC string.
##
## ### Parameters
## - `epoch_sec`: UTC epoch time in seconds.
##
## ### Returns
## The date/time formatted as an ISO 8601 UTC string (YYYY-MM-DDTHH:MM:SSZ).
pub function format_iso(epoch_sec: int) -> string
    let d = epoch_to_date(epoch_sec)
    let yr = d["year"]
    let mo = _time_pad2(d["month"])
    let dy = _time_pad2(d["day"])
    let hr = _time_pad2(d["hour"])
    let mn = _time_pad2(d["minute"])
    let sc = _time_pad2(d["second"])
    return f"{yr}-{mo}-{dy}T{hr}:{mn}:{sc}Z"
end

## Formats epoch seconds as HH:MM:SS.
##
## ### Parameters
## - `epoch_sec`: UTC epoch time in seconds.
##
## ### Returns
## The time of day formatted as HH:MM:SS.
pub function format_time_hhmmss(epoch_sec: int) -> string
    let d = epoch_to_date(epoch_sec)
    let hr = _time_pad2(d["hour"])
    let mn = _time_pad2(d["minute"])
    let sc = _time_pad2(d["second"])
    return f"{hr}:{mn}:{sc}"
end

## Returns the full English month name.
##
## ### Parameters
## - `month`: Month number (1-12).
##
## ### Returns
## The full English month name, or "Unknown" when out of range.
pub function month_name(month: int) -> string
    return when month
        is 1 => "January"
        is 2 => "February"
        is 3 => "March"
        is 4 => "April"
        is 5 => "May"
        is 6 => "June"
        is 7 => "July"
        is 8 => "August"
        is 9 => "September"
        is 10 => "October"
        is 11 => "November"
        is 12 => "December"
        else => "Unknown"
    end
end

## Returns the abbreviated English month name.
##
## ### Parameters
## - `month`: Month number (1-12).
##
## ### Returns
## The abbreviated English month name, or "Unk" when out of range.
pub function month_short_name(month: int) -> string
    return when month
        is 1 => "Jan"
        is 2 => "Feb"
        is 3 => "Mar"
        is 4 => "Apr"
        is 5 => "May"
        is 6 => "Jun"
        is 7 => "Jul"
        is 8 => "Aug"
        is 9 => "Sep"
        is 10 => "Oct"
        is 11 => "Nov"
        is 12 => "Dec"
        else => "Unk"
    end
end

## Returns the full English weekday name with Sunday as 0.
##
## ### Parameters
## - `weekday`: Weekday number with Sunday as 0.
##
## ### Returns
## The full English weekday name, or "Unknown" when out of range.
pub function weekday_name(weekday: int) -> string
    return when weekday
        is 0 => "Sunday"
        is 1 => "Monday"
        is 2 => "Tuesday"
        is 3 => "Wednesday"
        is 4 => "Thursday"
        is 5 => "Friday"
        is 6 => "Saturday"
        else => "Unknown"
    end
end

## Returns the abbreviated English weekday name with Sunday as 0.
##
## ### Parameters
## - `weekday`: Weekday number with Sunday as 0.
##
## ### Returns
## The abbreviated English weekday name, or "Unk" when out of range.
pub function weekday_short_name(weekday: int) -> string
    return when weekday
        is 0 => "Sun"
        is 1 => "Mon"
        is 2 => "Tue"
        is 3 => "Wed"
        is 4 => "Thu"
        is 5 => "Fri"
        is 6 => "Sat"
        else => "Unk"
    end
end

# --- Current Time Shortcuts ---

## Returns the current UTC date as YYYY-MM-DD.
##
## ### Parameters
## None.
##
## ### Returns
## The current UTC date formatted as YYYY-MM-DD.
pub function date_now() -> string
    return format_date(time())
end

## Returns the current UTC time as an ISO 8601 string.
##
## ### Parameters
## None.
##
## ### Returns
## The current UTC date/time formatted as an ISO 8601 string.
pub function iso_now() -> string
    return format_iso(time())
end

## Returns the current UTC time as HH:MM:SS.
##
## ### Parameters
## None.
##
## ### Returns
## The current UTC time of day formatted as HH:MM:SS.
pub function time_now() -> string
    return format_time_hhmmss(time())
end

# --- Legacy Aliases ---

## Legacy alias returning the monotonic clock in milliseconds.
## See: `now_millis`.
pub function time__now_millis() -> int
    return now_millis()
end

## Legacy alias sleeping for the given number of milliseconds.
## See: `delay`.
pub function time__sleep(ms: int)
    sleep(ms)
end
