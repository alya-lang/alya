import "std/test"
import "std/fs"
import "std/os"
import "std/path"
import "std/str"

test_suite("Alya std/fs Test Suite")

# Hermetic scratch file inside the OS temp dir; always cleaned up.
let f = path_join(temp_dir(), "alya_std_fs_test.txt")
let f2 = path_join(temp_dir(), "alya_std_fs_test_moved.txt")
if exists(f)
    fs_remove(f)
end
if exists(f2)
    fs_remove(f2)
end

# 1. Missing files fail soft
assert_false(exists(f), "missing file absent")
assert_str_eq(read_file_or(f, "dflt"), "dflt", "read_file_or default")
assert_false(fs_exists(f), "fs_exists missing")

# 2. Write / read round-trip
assert_true(write_string(f, "hello"), "write_string")
assert_str_eq(read_string(f), "hello", "read_string")
assert_str_eq(fs_read(f), "hello", "fs_read alias")
assert_true(fs_size(f) >= 5, "fs_size")
assert_false(is_empty_file(f), "not empty")

# 3. Append and lines
assert_true(append_string(f, " world"), "append_string")
assert_str_eq(read_string(f), "hello world", "appended content")
assert_true(write_lines(f, ["a", "b", "c"]), "write_lines")
assert_eq(len(read_lines(f)), 3, "read_lines count")
assert_str_eq(read_lines(f)[0], "a", "read_lines first")
assert_eq(file_lines_count(f), 3, "lines count")
assert_true(append_line(f, "d"), "append_line")
assert_eq(file_lines_count(f), 4, "lines count after append")

# 4. Pure path helpers on the scratch name
assert_str_eq(file_extension(f), "txt", "file_extension")
assert_str_eq(file_basename(f), "alya_std_fs_test.txt", "file_basename")
# Trailing separators differ per platform (macOS temp_dir ends with `/`
# while file_parent trims it): compare separator-normalized forms.
let parent_norm = trim_char(to_slash(file_parent(f)), "/")
let tmp_norm = trim_char(to_slash(temp_dir()), "/")
assert_str_eq(parent_norm, tmp_norm, "file_parent")

# 5. Copy, move, remove
assert_true(copy_file(f, f2), "copy_file")
assert_true(exists(f2), "copy target exists")
assert_true(move_file(f2, f), "move_file")
assert_false(exists(f2), "move source gone")
assert_true(touch(f), "touch existing")
assert_true(clear_file(f), "clear_file")
assert_true(is_empty_file(f), "empty after clear")
assert_true(fs_remove(f), "fs_remove")
assert_false(exists(f), "removed file absent")

# 6. Directory helpers on the temp dir itself
assert_true(fs_is_dir(temp_dir()), "temp is dir")
assert_true(len(fs_list_dir(temp_dir())) > 0, "list dir non-empty")

say "All std/fs tests passed successfully!"
