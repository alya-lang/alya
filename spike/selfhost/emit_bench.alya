# Spike 1a: 1 MB emission benchmark (array+join vs ByteBuffer vs +=).
#
# Each mode builds the same deterministic asm-like text (~1 MB at
# N=30000) and prints one stats line:
#   mode|len|checksum|ms
# byte-exactness = same len + checksum across modes (checksum = sum of
# bytes). Timing is internal ms (coarse, ~15.6 ms quantum on Windows)
# plus external wall timing by the harness.
#
# Coding rules from FINDINGS.md / CODEGEN_FEASIBILITY.md:
# - aliased imports only, concatenation only (never feed runtime text
#   through "..."/f"..." interpolation, never literal {{).
# - homogeneous arrays only (string[] here).
# - emitted text avoids { and } entirely.

import "std/os" as os
import "std/time" as time
import "std/str" as str
import "std/mem" as mem

function int_to_dec(v: int) -> string
    if v == 0
        return "0"
    end
    let neg = 0
    let x = v
    if x < 0
        neg = 1
        x = 0 - x
    end
    let digs = []
    while x > 0
        digs.push(x % 10)
        x = x / 10
    end
    let s = ""
    if neg == true
        s = "-"
    end
    let i = len(digs) - 1
    while i >= 0
        s = s + chr(48 + digs[i])
        i -= 1
    end
    return s
end

# One deterministic asm-like line. No braces in any template.
function make_chunk(i: int) -> string
    let r = i % 4
    if r == 0
        return "    push rbp ; frame L" + int_to_dec(i) + "\n"
    end
    if r == 1
        return "    mov rbp, rsp ; frame L" + int_to_dec(i) + "\n"
    end
    if r == 2
        return "    mov rax, qword ptr [rbp-" + int_to_dec(8 * (i % 64 + 1)) + "] ; L" + int_to_dec(i) + "\n"
    end
    return "    add rax, " + int_to_dec(i) + " ; L" + int_to_dec(i) + "\n"
end

function checksum_of(s: string) -> int
    let bs = str.bytes_from_string(s)
    let sum = 0
    let i = 0
    let n = len(bs)
    while i < n
        sum += bs[i]
        i += 1
    end
    return sum
end

function bench_plus(n: int) -> string
    let out = ""
    let i = 0
    while i < n
        out = out + make_chunk(i)
        i += 1
    end
    return out
end

function bench_join(n: int) -> string
    let parts: string[] = []
    let i = 0
    while i < n
        parts.push(make_chunk(i))
        i += 1
    end
    return parts.join("")
end

function bench_buffer(n: int) -> string
    let buf = mem.buffer_new(1048576)
    let i = 0
    while i < n
        mem.buffer_write_string(buf, make_chunk(i))
        i += 1
    end
    let s = mem.buffer_to_string(buf)
    # NOTE: intentionally no buffer_free here. buffer_to_string exposes
    # the buffer memory as a string; freeing first would risk dangling
    # the result if str_from_ptr does not copy. Process exits right
    # after, OS reclaims the 1 MB.
    return s
end

function run_one(mode: string, n: int)
    let t0 = time.now_ms()
    let out = ""
    if mode == "plus"
        out = bench_plus(n)
    elif mode == "join"
        out = bench_join(n)
    elif mode == "buffer"
        out = bench_buffer(n)
    else
        say "unknown mode: " + mode
        os.exit_process(2)
    end
    let ms = time.now_ms() - t0
    let sum = checksum_of(out)
    say mode + "|" + int_to_dec(len(out)) + "|" + int_to_dec(sum) + "|" + int_to_dec(ms)
end

function main()
    let args = os.cli_args()
    let mode = "all"
    let n = 30000
    if len(args) >= 1
        mode = args[0]
    end
    if len(args) >= 2
        n = int(args[1])
    end
    if mode == "all"
        run_one("plus", n)
        run_one("join", n)
        run_one("buffer", n)
    else
        run_one(mode, n)
    end
end

main()
