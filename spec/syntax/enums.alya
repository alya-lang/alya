# ==============================================================================
# Alya Language Specification: Chapter 09 - Enums & Discriminants
# File: syntax/enums.alya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sequential Enum (Auto-indexed from 0)
# ------------------------------------------------------------------------------
enum Direction
    North # 0
    East  # 1
    South # 2
    West  # 3
end

let heading = Direction.North
say f"Heading numeric value: {heading as int}"

# ------------------------------------------------------------------------------
# 2. Explicit Integer Discriminants
# ------------------------------------------------------------------------------
enum HttpStatus
    Ok = 200
    Created = 201
    Accepted = 202
    BadRequest = 400
    Unauthorized = 401
    NotFound = 404
    InternalServerError = 500
end

let current_status = HttpStatus.NotFound

# Associated UFCS Method on Enum
function HttpStatus.is_success(self) -> bool
    let val = self as int
    return val >= 200 and val < 300
end

function HttpStatus.is_client_error(self) -> bool
    let val = self as int
    return val >= 400 and val < 500
end

say f"Status: {current_status as int}"
say f"Is success: {current_status.is_success()}"           # false
say f"Is client error: {current_status.is_client_error()}" # true

# ------------------------------------------------------------------------------
# 3. String-Backed Enums
# ------------------------------------------------------------------------------
enum Environment
    Development = "dev"
    Staging = "staging"
    Production = "prod"
end

let active_env = Environment.Production
say f"Active environment: {active_env as string}"

# ------------------------------------------------------------------------------
# 4. Pattern Matching on Enums via 'when'
# ------------------------------------------------------------------------------
let current_dir = Direction.East

let movement_advice = when current_dir
    is Direction.North => "Heading towards the northern pole"
    is Direction.East  => "Heading towards the sunrise"
    is Direction.South => "Heading towards the equator"
    is Direction.West  => "Heading towards the sunset"
end

say f"Navigation advice: {movement_advice}"

# Matching HTTP statuses with multi-arms
let response_verdict = when current_status
    is HttpStatus.Ok, HttpStatus.Created, HttpStatus.Accepted => "Request fulfilled"
    is HttpStatus.BadRequest, HttpStatus.NotFound             => "Client correction required"
    is HttpStatus.InternalServerError                         => "Server failure reported"
    else                                                      => "Other status code"
end

say f"Response verdict: {response_verdict}"

# ------------------------------------------------------------------------------
# 5. Auto-Increment After Explicit Discriminants (Chapter 09 §1.3)
# ------------------------------------------------------------------------------
enum BuildStep
    Fetch = 10
    Compile     # 11
    Link        # 12
end

assert_eq(BuildStep.Fetch as int, 10)
assert_eq(BuildStep.Compile as int, 11)
assert_eq(BuildStep.Link as int, 12)

say f"Auto-increment: {BuildStep.Fetch as int},{BuildStep.Compile as int},{BuildStep.Link as int}"

# ------------------------------------------------------------------------------
# 6. Exhaustive Matching Without 'else' (Chapter 09 §1.5)
# ------------------------------------------------------------------------------
# When every variant is covered, the fallback may be omitted.
enum Toggle
    Off
    On
end

function toggle_name(t: Toggle) -> string
    return when t
        is Toggle.Off => "off"
        is Toggle.On => "on"
    end
end

assert_eq(toggle_name(Toggle.Off), "off")
assert_eq(toggle_name(Toggle.On), "on")

let typed_toggle: Toggle = Toggle.On
assert_eq(typed_toggle as int, 1)

say "Exhaustive matching without else OK"

# ------------------------------------------------------------------------------
# 7. Native Test Blocks for Chapter 09
# ------------------------------------------------------------------------------
test "sequential enums start at zero"
    assert_eq(Direction.North as int, 0)
    assert_eq(Direction.West as int, 3)
end

test "string enums cast back to strings"
    assert_eq(Environment.Development as string, "dev")
    assert_eq(Environment.Staging as string, "staging")
end

@test
function test_enum_methods()
    let ok_status = HttpStatus.Ok
    let nf_status = HttpStatus.NotFound
    assert_eq(ok_status.is_success(), true)
    assert_eq(nf_status.is_success(), false)
    # NOTE: calling a method directly on an enum variant literal
    # (`HttpStatus.Ok.is_success()`) is a known codegen gap (unresolvable
    # symbol); bind to a variable first.
end
