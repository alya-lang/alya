# ==============================================================================
# Alya Language Specification: Chapter 17 - Concurrency, Fibers & Channels
# File: syntax/concurrency.alya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spawning Lightweight Fibers
# ------------------------------------------------------------------------------
function worker_fiber(worker_id: int, jobs_channel: Channel[int])
    say f"Worker fiber #{worker_id} ready"
    for job in jobs_channel
        say f"Worker fiber #{worker_id} processing job #{job}"
    end
    say f"Worker fiber #{worker_id} completed jobs"
end

# ------------------------------------------------------------------------------
# 2. Buffered Channel Pipeline (CSP Pattern)
# ------------------------------------------------------------------------------
let jobs = Channel[int].new(capacity: 5)

# Spawn worker fibers (M:N cooperative green threads)
spawn worker_fiber(1, jobs)
spawn worker_fiber(2, jobs)

# Feed jobs from current fiber
for j in 1..=5
    jobs.send(j)
end

# Close channel to gracefully terminate receiver loops
jobs.close()

# ------------------------------------------------------------------------------
# 3. Multiplexing Channels with 'select'
# ------------------------------------------------------------------------------
let ch_a = Channel[string].new(capacity: 1)
let ch_b = Channel[string].new(capacity: 1)

spawn || =>
ch_a.send("Packet from Sensor A")
end

spawn || =>
ch_b.send("Packet from Sensor B")
end

# Multiplex incoming messages with non-blocking fallback
select
    case packet_a = ch_a.recv()
        say f"Multiplexer received: {packet_a}"
    case packet_b = ch_b.recv()
        say f"Multiplexer received: {packet_b}"
    timeout 1000
        say "Timeout: No sensor packet received within 1000ms"
    else
        say "Non-blocking check: No immediate data pending"
end

# ------------------------------------------------------------------------------
# 4. Native OS Threads & Synchronization Primitives (std/sync)
# ------------------------------------------------------------------------------
import "std/sync"

let wg = sync.WaitGroup.new()
let mut = sync.Mutex.new()
let shared_counter = 0

wg.add(2)

# Spawn OS worker threads
sync.spawn(|| =>
defer wg.done()
mut.lock()
shared_counter += 10
mut.unlock()
)

sync.spawn(|| =>
defer wg.done()
mut.lock()
shared_counter += 20
mut.unlock()
)

# Await both threads
wg.wait()
say f"Thread-safe shared counter result: {shared_counter}" # 30

# ------------------------------------------------------------------------------
# 5. Unbuffered Rendezvous & Timeout-Only Select (Chapter 17 §1.3, §1.4)
# ------------------------------------------------------------------------------
# NOTE: `Channel` methods resolve only when `std/sync` is imported somewhere
# in the program (the implementation lives there; section 4's import covers
# this file). Chapter 17 §1.3 shows import-free usage; that does not link.

let rendezvous_ch = Channel[int].new()   # No capacity: rendezvous
spawn || =>
rendezvous_ch.send(42)
end
let rendezvous_got = rendezvous_ch.recv()
assert_eq(rendezvous_got, 42)
say f"Rendezvous exchange: {rendezvous_got}"

let quiet_ch = Channel[int].new(capacity: 1)
let picked = 0
select
    case v = quiet_ch.recv()
        picked = v
    timeout 100
        picked = -1
end
assert_eq(picked, -1)
say "Timeout-only select OK"

# NOTE (channel operators): the EBNF documents `ch <- data` and `<-ch`, but
# `ch <- 7` silently sends nothing (recv observes 0) and `<-ch` is a parse
# error. Use `.send()`/`.recv()` until the operator forms are implemented.

# ------------------------------------------------------------------------------
# 6. WaitGroup Aggregation Across Three Threads
# ------------------------------------------------------------------------------
# NOTE: method calls do not resolve inside `test` blocks (same limitation as
# nested function definitions: `m.lock()` emits unresolvable `fn_lock`), so
# this scenario runs at top level with plain asserts.
let w3 = sync.WaitGroup.new()
let m3 = sync.Mutex.new()
let total3 = 0
w3.add(3)
sync.spawn(|| =>
defer w3.done()
m3.lock()
total3 += 1
m3.unlock()
)
sync.spawn(|| =>
defer w3.done()
m3.lock()
total3 += 10
m3.unlock()
)
sync.spawn(|| =>
defer w3.done()
m3.lock()
total3 += 100
m3.unlock()
)
w3.wait()
assert_eq(total3, 111)
say f"Three-thread aggregate: {total3}"
