# ==============================================================================
# Alya Language Specification: Chapter 20 - Operator Overloading & Special Methods
# File: syntax/operators_overloading.alya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 2D Vector with Overloaded Arithmetic, Relational & Equality Operators
# ------------------------------------------------------------------------------
struct Vector2D
    x: float
    y: float
end

# Vector addition: v1 + v2
function Vector2D.operator+(self, other: Vector2D) -> Vector2D
    return Vector2D {
        x: self.x + other.x,
        y: self.y + other.y
    }
end

# Vector subtraction: v1 - v2
function Vector2D.operator-(self, other: Vector2D) -> Vector2D
    return Vector2D {
        x: self.x - other.x,
        y: self.y - other.y
    }
end

# Vector scalar multiplication: v * scalar
function Vector2D.operator*(self, scalar: float) -> Vector2D
    return Vector2D {
        x: self.x * scalar,
        y: self.y * scalar
    }
end

# Unary negation: -v
function Vector2D.operator-neg(self) -> Vector2D
    return Vector2D {
        x: -self.x,
        y: -self.y
    }
end

# Structural equality: v1 == v2
function Vector2D.operator==(self, other: Vector2D) -> bool
    return self.x == other.x and self.y == other.y
end

# Magnitude comparison: v1 < v2
function Vector2D.operator<(self, other: Vector2D) -> bool
    let mag1 = self.x * self.x + self.y * self.y
    let mag2 = other.x * other.x + other.y * other.y
    return mag1 < mag2
end

# Special string representation
function Vector2D.to_string(self) -> string
    return f"Vector2D({self.x}, {self.y})"
end

let v1 = Vector2D { x: 3.0, y: 4.0 }
let v2 = Vector2D { x: 1.0, y: 2.0 }

let v3 = v1 + v2
let v_sub = v1 - v2
let v4 = v1 * 2.0
let v5 = -v1

say f"v1: {v1}"
say f"v2: {v2}"
say f"v1 + v2: {v3}"
say f"v1 - v2: {v_sub}"
say f"v1 * 2: {v4}"
say f"-v1: {v5}"

if v1 + v2 == v3
    say "Vector equality verified successfully"
end

if v2 < v1
    say "v2 has smaller magnitude than v1"
end

# ------------------------------------------------------------------------------
# 2. Custom Collection with Overloaded Index Operators ([] and []=)
# ------------------------------------------------------------------------------
struct FixedRingBuffer
    data: int[]
    head: int = 0
end

# Read indexing: buf[i]
function FixedRingBuffer.operator[](self, index: int) -> int
    let actual_idx = (self.head + index) % self.data.length()
    return self.data[actual_idx]
end

# Write indexing: buf[i] = val
function FixedRingBuffer.operator[]=(self, index: int, value: int)
    let actual_idx = (self.head + index) % self.data.length()
    self.data[actual_idx] = value
end

let ring = FixedRingBuffer { data: [100, 200, 300], head: 1 }
say f"Element at ring[0] (actual offset 1): {ring[0]}"

ring[0] = 999
say f"Updated element at ring[0]: {ring[0]}"

# ------------------------------------------------------------------------------
# 3. Division, Modulo & Derived Comparisons (Chapter 20 §1.2, §1.3)
# ------------------------------------------------------------------------------
struct Fraction
    num: float
end

function Fraction.operator/(self, other: Fraction) -> Fraction
    return Fraction { num: self.num / other.num }
end

function Fraction.operator%(self, other: Fraction) -> Fraction
    return Fraction { num: self.num % other.num }
end

function Fraction.operator==(self, other: Fraction) -> bool
    return self.num == other.num
end

let f_half = Fraction { num: 7.0 } / Fraction { num: 2.0 }
let f_rem = Fraction { num: 7.0 } % Fraction { num: 2.0 }
assert_eq(f_half.num, 3.5)
assert_eq(f_rem.num, 1.0)
# `!=` is auto-derived from `==`.
assert Fraction { num: 1.0 } != Fraction { num: 2.0 }
# Same content, distinct instances: derived `!=` must be false (a raw address
# comparison would wrongly report true here).
assert (Fraction { num: 1.0 } != Fraction { num: 1.0 }) == false

say f"Div: {f_half.num}, Mod: {f_rem.num}"

# `<=`, `>`, `>=` derive from `<` + `==` without explicit overloads.
struct Rank
    level: int
end

function Rank.operator<(self, other: Rank) -> bool
    return self.level < other.level
end

function Rank.operator==(self, other: Rank) -> bool
    return self.level == other.level
end

let ra = Rank { level: 1 }
let rb = Rank { level: 2 }
assert ra <= rb
assert (rb >= ra)
assert (rb > ra)
assert (ra == ra)

say "Derived comparisons OK"

# ------------------------------------------------------------------------------
# 4. Native Test Blocks for Chapter 20
# ------------------------------------------------------------------------------
test "vector arithmetic is pure (no mutation)"
    let a = Vector2D { x: 1.0, y: 1.0 }
    let b = Vector2D { x: 2.0, y: 3.0 }
    let c = a + b
    assert_eq(a.x, 1.0)
    assert_eq(c.x, 3.0)
    assert_eq(c.y, 4.0)
end

@test
function test_ring_index_write()
    let r = FixedRingBuffer { data: [1, 2, 3], head: 0 }
    r[1] = 20
    assert_eq(r[1], 20)
end
