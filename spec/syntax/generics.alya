# ==============================================================================
# Alya Language Specification: Chapter 15 - Generics & Parametric Polymorphism
# File: syntax/generics.alya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Generic Functions with Inference
# ------------------------------------------------------------------------------
function swap[T](a: T, b: T) -> (T, T)
    return b, a
end

# Explicit and inferred invocations
let n1, n2 = swap(100, 200)
let s1, s2 = swap("Left", "Right")

say f"Swapped integers: {n1}, {n2}"
say f"Swapped strings: {s1}, {s2}"

# ------------------------------------------------------------------------------
# 2. Generic Data Structure (Stack[T])
# ------------------------------------------------------------------------------
struct Stack[T]
    items: T[]
end

function Stack[T].new() -> Stack[T]
    return Stack[T] { items: [] }
end

function Stack[T].push(self, item: T)
    self.items.push(item)
end

function Stack[T].pop(self) -> T
    return self.items.pop()
end

function Stack[T].size(self) -> int
    return self.items.length()
end

let int_stack = Stack[int].new()
int_stack.push(10)
int_stack.push(20)
int_stack.push(30)

say f"Stack size: {int_stack.size()}"
say f"Popped top element: {int_stack.pop()}"

# ------------------------------------------------------------------------------
# 3. Multiple Type Parameters
# ------------------------------------------------------------------------------
struct KeyValuePair[K, V]
    key: K
    value: V
end

let entry = KeyValuePair[string, int] {
    key: "HTTP_STATUS",
    value: 200
}

say f"Entry pair: {entry.key} = {entry.value}"

# ------------------------------------------------------------------------------
# 4. Bounded Generics (Interface Constraints)
# ------------------------------------------------------------------------------
interface Printable
    function to_string(self) -> string
end

struct Book
    title: string
    author: string
end

function Book.to_string(self) -> string
    return f"'{self.title}' by {self.author}"
end

function log_printable[T: Printable](entity: T)
    say f"[LOG] {entity.to_string()}"
end

let b = Book { title: "The Pragmatic Programmer", author: "Hunt & Thomas" }
log_printable(b)

# ------------------------------------------------------------------------------
# 5. Generics Robustness Boundary (READ BEFORE EXTENDING THIS FILE)
# ------------------------------------------------------------------------------
# Verified by probe 2026-09-22: adding ANY further generic function or generic
# struct literal to this file hard-crashes at runtime (silent exit 1, no
# message) at the first new construct, while each construct passes standalone
# and in pairs. Suspected cumulative codegen-state corruption (vtable /
# specialization / CallIndex interaction), NOT shape-specific. Do not extend
# sections 1-4 with new generics until a dedicated debug session with assembly
# inspection fixes the root cause. Known-good in isolation (all verified via
# `alya run` on minimal files, all currently red in full-file context):
# - `first_of[T](items: T[])` with int AND string instantiations;
# - concrete single-param literals (`Box[int]`, `Box[string]`);
# - multi-bound identity (`pass_through[T: A + B]`, parse fix verified).
# Compiler fixes already landed for this chapter (all covered by probes and by
# this file now passing real `alya check`/`run`, which previously REJECTED it):
# type_checker generic erasure, T[] element inference, multi-bound `+` parsing,
# structural interface satisfaction.

# ------------------------------------------------------------------------------
# 8. Native Test Blocks for Chapter 15
# ------------------------------------------------------------------------------
test "swap is symmetric across types"
    let a1, b1 = swap(1, 2)
    assert_eq(a1, 2)
    assert_eq(b1, 1)
end

@test
function test_stack_push_pop()
    let st = Stack[int].new()
    st.push(99)
    assert_eq(st.pop(), 99)
end
