# ==============================================================================
# Alya Language Specification: Chapter 02 - Types & Type System
# File: syntax/types.alya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Boolean Type (bool)
# ------------------------------------------------------------------------------
let is_running: bool = true
let is_completed: bool = false

# Strict boolean evaluation (integers cannot implicitly coerce to bool)
if is_running and not is_completed
    say "System is currently executing task."
end

# ------------------------------------------------------------------------------
# 2. Signed Integer Scalar Primitives
# ------------------------------------------------------------------------------
let num_default: int = 42             # Canonical default signed 64-bit integer
let num_i8: i8 = -128                 # 8-bit signed (-128 to 127)
let num_i16: i16 = -32768             # 16-bit signed
let num_i32: i32 = -2147483648        # 32-bit signed (C int compatible)
let num_i64: i64 = 9223372036854775807# 64-bit signed

say f"Signed scalars: i8={num_i8}, i16={num_i16}, i32={num_i32}, i64={num_i64}"

# ------------------------------------------------------------------------------
# 3. Unsigned Integer Scalar Primitives
# ------------------------------------------------------------------------------
let num_u8: u8 = 255                  # 8-bit unsigned byte (0 to 255)
let num_u16: u16 = 65535              # 16-bit unsigned
let num_u32: u32 = 4294967295         # 32-bit unsigned
let num_u64: u64 = 18446744073709551615 # 64-bit unsigned

# Architecture-dependent pointer size (32-bit on x86, 64-bit on x64/ARM64)
let mem_offset: usize = 0x7FFF_FFFF

say f"Unsigned scalars: u8={num_u8}, u16={num_u16}, u32={num_u32}, usize={mem_offset}"

# ------------------------------------------------------------------------------
# 4. Floating-Point Scalar Primitives
# ------------------------------------------------------------------------------
let num_f32: f32 = 3.14159            # 32-bit single-precision IEEE 754
let num_float: float = 2.718281828459 # Default 64-bit double-precision IEEE 754
let num_f64: f64 = num_float          # f64 is an alias for float

say f"Floats: f32={num_f32}, float/f64={num_f64}"

# ------------------------------------------------------------------------------
# 5. Character & String Primitives
# ------------------------------------------------------------------------------
let codepoint: rune = '⌘'             # 32-bit Unicode codepoint
let text: string = "Alya Language"    # Immutable UTF-8 byte slice backed by ARC

say f"Rune codepoint: {codepoint}, String: '{text}'"

# ------------------------------------------------------------------------------
# 6. Composite Types: Arrays, Maps, and Tuples
# ------------------------------------------------------------------------------
# Dynamic Arrays (T[])
let numbers: int[] = [10, 20, 30, 40]
let matrix: int[][] = [[1, 2], [3, 4]]# Multi-dimensional array

# Hash Maps ([KeyType: ValueType])
let score_board: [string: int] = { "Alice": 100, "Bob": 85 }

# Fixed-Size Tuples (T1, T2, ...)
let user_entry: (int, string, bool) = (101, "Alice", true)

say f"Array len: {numbers.length()}, Matrix row len: {matrix.length()}"
say f"Map keys count: {score_board.length()}, Tuple: ({user_entry.0}, {user_entry.1}, {user_entry.2})"

# ------------------------------------------------------------------------------
# 7. Nullable Optionals (T?) & Raw Pointers (ptr)
# ------------------------------------------------------------------------------
let maybe_number: int? = null         # Can hold an int or null
maybe_number = 500

let raw_c_buffer: ptr = null          # Raw pointer for C FFI bindings

# ------------------------------------------------------------------------------
# 8. Explicit Type Casting with 'as' Keyword
# ------------------------------------------------------------------------------
let source_int: int = 1000
let cast_float = source_int as float  # int to float conversion
let cast_byte = source_int as u8      # Truncating conversion (1000 % 256 = 232)
let cast_i32 = source_int as i32      # 64-bit to 32-bit conversion

let float_pi = 3.99
let truncated_int = float_pi as int   # Truncates to 3

say f"Cast results: float={cast_float}, byte={cast_byte}, truncated={truncated_int}"

# ------------------------------------------------------------------------------
# 9. Dynamic Type Querying with 'is' and 'not is'
# ------------------------------------------------------------------------------
let query_val: any = 42

if query_val is int
    say "query_val is verified as 64-bit integer"
end

if query_val not is string
    say "query_val is confirmed not to be a string"
end

# ------------------------------------------------------------------------------
# 10. Static Gradual Typing & Interoperability
# ------------------------------------------------------------------------------
# Statically typed scalar assignment and reassignment
let typed_score: int = 100
typed_score = 150

# Bidirectional interoperability between 'any' and static types
let dynamic_holder: any = typed_score
let recovered_typed: int = dynamic_holder

# Statically validated typed function
function compute_typed_hash(id: int, label: string) -> int
    let hash_val: int = id * 31 + label.length()
    return hash_val
end

let hash_result: int = compute_typed_hash(typed_score, "spec_test")
say f"Gradual typing OK: score={typed_score}, recovered={recovered_typed}, hash={hash_result}"

# ------------------------------------------------------------------------------
# 11. Explicit SIMD Vector Primitives (Phase 6.4 Specification Contract)
# ------------------------------------------------------------------------------
import "std/simd"

let v1: f64x4 = f64x4_new(1.0, 2.0, 3.0, 4.0)
let v2: f64x4 = f64x4_splat(2.0)
let v_sum: f64x4 = v1 + v2
let v_fma: f64x4 = v1.fma(v2, v_sum)
let dot: float = v1.sum_horizontal()
say f"SIMD 6.4 Vector Specification: v_sum[0]={v_sum.get(0)}, v_fma[0]={v_fma.get(0)}, dot={dot}"
say "SIMD 6.4 Vector Specification: f64x4, f32x8, i32x8, i64x4 ready"

# ------------------------------------------------------------------------------
# 12. Systems Aliases & Pointer-Sized Integers (Chapter 02 §1.1)
# ------------------------------------------------------------------------------
let raw_byte: byte = 65                  # `byte` is an alias for `u8`
let arch_index: isize = -5               # Signed pointer-sized integer
let arch_count: usize = 1024

assert_eq(raw_byte, 65)
assert_eq(arch_index, -5)
assert_eq(arch_count, 1024)

say f"Aliases: byte={raw_byte}, isize={arch_index}, usize={arch_count}"

# ------------------------------------------------------------------------------
# 13. Explicit Conversion Functions (Chapter 02 §1.4)
# ------------------------------------------------------------------------------
let parsed_num = int("42")               # String to int conversion
let rendered = str(25)                   # Int to string conversion
let parsed_float = float("3.5")          # String to float conversion

assert_eq(parsed_num, 42)
assert_eq(rendered, "25")
assert_eq(parsed_float, 3.5)

say f"Conversions: int={parsed_num}, str={rendered}, float={parsed_float}"

# ------------------------------------------------------------------------------
# 14. Negated Type Query & Explicit Dynamic (Chapter 02 §1.3, §1.5)
# ------------------------------------------------------------------------------
let probe: any = 42

if probe is not string
    say "probe is confirmed not to be a string (is-not form)"
end

let explicit_dyn: any = 7               # Explicit `any` annotation
let from_dyn: int = explicit_dyn        # any -> static recovery
assert_eq(from_dyn, 7)

say f"Explicit dynamic: {explicit_dyn}, recovered: {from_dyn}"

# ------------------------------------------------------------------------------
# 15. Native Test Blocks for Chapter 02
# ------------------------------------------------------------------------------
test "sized integer boundaries hold"
    let lo8: i8 = -128
    let hi8: i8 = 127
    let hi_u8: u8 = 255
    assert_eq(lo8, -128)
    assert_eq(hi8, 127)
    assert_eq(hi_u8, 255)
end

test "casts truncate predictably"
    assert_eq(1000 as u8, 232)
    assert_eq(3.99 as int, 3)
end

test "is and is-not queries agree"
    let v: any = "text"
    assert v is string
    assert v is not int
end

@test
function test_type_conversions()
    assert_eq(int("100"), 100)
    assert_eq(str(100), "100")
end
