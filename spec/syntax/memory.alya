# ==============================================================================
# Alya Language Specification: Chapter 16 - Memory Model, ARC & Lifecycle
# File: syntax/memory.alya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Stack Allocation (Value Types)
# ------------------------------------------------------------------------------
function stack_demonstration()
    let a: int = 42
    let b = a        # Bitwise copy on stack
    b += 10

    say f"Original a: {a}" # Still 42
    say f"Copied b: {b}"   # 52
end

stack_demonstration()

# ------------------------------------------------------------------------------
# 2. Heap Allocation & Automatic Reference Counting (ARC)
# ------------------------------------------------------------------------------
struct HeavyPayload
    id: int
    data: string
end

function arc_scope_lifecycle()
    let p1 = HeavyPayload { id: 1, data: "Important Payload" } # Refcount = 1
    say f"Created payload #{p1.id}"

    if true
        let p2 = p1 # Refcount = 2 (p1 and p2 point to same heap payload)
        say f"Alias p2 data: {p2.data}"
        # Leaving scope: p2 is released. Refcount drops back to 1.
    end

    # Leaving function: p1 is released. Refcount reaches 0 -> Memory freed instantly.
end

arc_scope_lifecycle()

# ------------------------------------------------------------------------------
# 3. Weak References for Cycle Prevention
# ------------------------------------------------------------------------------
struct Folder
    name: string
    parent: weak Folder # Prevents cyclical reference memory leaks
    subfolders: Folder[]
end

function build_directory_tree()
    let root = Folder {
        name: "root",
        parent: null,
        subfolders: []
    }

    let bin = Folder {
        name: "bin",
        parent: root, # Assigned as weak reference
        subfolders: []
    }

    root.subfolders.push(bin)
    say f"Created folder '{bin.name}' with parent '{root.name}'"
end

build_directory_tree()

# ------------------------------------------------------------------------------
# 4. Memory Arenas (Batch O(1) Reclaim)
# ------------------------------------------------------------------------------
import "std/mem"

function run_arena_workload()
    # Create arena with 64KB initial chunk
    let arena = mem.Arena.new(65536)
    defer arena.destroy() # Reclaims all allocations in 1 CPU cycle

    say "Allocating temporary scratch buffers inside arena..."
    for i in 0..1000
        let buf = arena.alloc(64) # Fast pointer bump, zero ARC overhead
    end
    say "Arena workload finished, ready for instant bulk deallocation"
end

run_arena_workload()

# ------------------------------------------------------------------------------
# 5. Weak Nulling After Target Deallocation (Chapter 16 §1.4)
# ------------------------------------------------------------------------------
# The core weak guarantee: when the strong owner is freed, the weak reference
# observes null instead of dangling.
struct WeakKid
    name: string
    parent: weak WeakKid
end

function make_orphan() -> WeakKid
    let root = WeakKid { name: "root", parent: null }
    let child = WeakKid { name: "child", parent: root }
    return child
end

let orphan = make_orphan()
assert_eq(orphan.name, "child")
assert orphan.parent is null

say f"Weak nulled after dealloc: {orphan.name} (parent null)"

# ------------------------------------------------------------------------------
# 6. Arena Reset & Reuse (Chapter 16 §1.5)
# ------------------------------------------------------------------------------
let arena2 = mem.Arena.new(4096)
let first_block = arena2.alloc(64)
arena2.reset()
let second_block = arena2.alloc(32)
say "Arena reset and reuse OK"
arena2.destroy()

# ------------------------------------------------------------------------------
# 7. Native Test Blocks for Chapter 16
# ------------------------------------------------------------------------------
test "stack copies are independent"
    let a = 10
    let b = a
    b += 5
    assert_eq(a, 10)
    assert_eq(b, 15)
end

@test
function test_weak_starts_null()
    let lone = WeakKid { name: "lone", parent: null }
    assert lone.parent is null
    assert_eq(lone.name, "lone")
end
