# ==============================================================================
# Alya Language Specification: Chapter 06 - Loops & Iteration
# File: syntax/loops.alya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 'while' Loop
# ------------------------------------------------------------------------------
let countdown = 5

while countdown > 0
    say f"Countdown tick: {countdown}"
    countdown -= 1
end
say "Countdown finished!"

# Multi-condition while loop
let worker_busy = true
let retry_budget = 3

while worker_busy and retry_budget > 0
    say f"Worker polling, retries left: {retry_budget}"
    retry_budget -= 1
    if retry_budget == 1
        worker_busy = false # Job finished
    end
end

# ------------------------------------------------------------------------------
# 2. 'for .. in' Numeric Range Loops (Exclusive & Inclusive)
# ------------------------------------------------------------------------------
# Half-open range (0..5 -> 0, 1, 2, 3, 4)
let sum_exclusive = 0
for i in 0..5
    sum_exclusive += i
end
say f"Sum of 0..5 (exclusive): {sum_exclusive}" # 10

# Inclusive range (1..=5 -> 1, 2, 3, 4, 5)
let product_inclusive = 1
for i in 1..=5
    product_inclusive *= i
end
say f"Product of 1..=5 (factorial 5): {product_inclusive}" # 120

# ------------------------------------------------------------------------------
# 3. 'for item in' Collection Iteration
# ------------------------------------------------------------------------------
let tech_stack = ["Alya", "Assembly", "Rust", "Linux", "Darwin"]

for tech in tech_stack
    say f"Technology: {tech}"
end

# ------------------------------------------------------------------------------
# 4. 'for index, item in' Array Indexed Iteration
# ------------------------------------------------------------------------------
let pipeline_steps = ["Lexer", "Parser", "TypeInference", "TreeShaking", "Codegen"]

for idx, step in pipeline_steps
    say f"Step #{idx + 1}: {step}"
end

# ------------------------------------------------------------------------------
# 5. 'for key, val in' Hash Map Iteration
# ------------------------------------------------------------------------------
let server_headers = {
    "Content-Type": "application/json",
    "Server": "Alya/1.0",
    "Connection": "keep-alive"
}

for header, val in server_headers
    say f"HTTP Header: {header}: {val}"
end

# ------------------------------------------------------------------------------
# 6. 'repeat' Loop (Unconditional) with 'break' and 'continue'
# ------------------------------------------------------------------------------
let tick_count = 0

repeat
    tick_count += 1

    # Skip odd ticks using continue
    if tick_count % 2 != 0
        continue
    end

    say f"Even tick processed: {tick_count}"

    # Exit loop unconditionally when threshold reached
    if tick_count >= 6
        say "Loop threshold reached, breaking out."
        break
    end
end

# ------------------------------------------------------------------------------
# 7. Nested Loops & Matrix Traversal
# ------------------------------------------------------------------------------
let grid = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]

let target = 5
let found = false

for row_idx, row in grid
    for col_idx, cell in row
        if cell == target
            say f"Target {target} located at grid[{row_idx}][{col_idx}]"
            found = true
            break
        end
    end
    if found
        break
    end
end

# ------------------------------------------------------------------------------
# 8. Algorithmic Iteration: Sieve of Eratosthenes
# ------------------------------------------------------------------------------
function count_primes(limit: int) -> int
    let flags: int[] = []
    let i = 0
    while i <= limit
        flags.push(1)
        i += 1
    end

    let p = 2
    while p * p <= limit
        if flags[p] == 1
            let multiple = p * p
            while multiple <= limit
                flags[multiple] = 0
                multiple += p
            end
        end
        p += 1
    end

    let count = 0
    let j = 2
    while j <= limit
        if flags[j] == 1
            count += 1
        end
        j += 1
    end
    return count
end

let primes_under_50 = count_primes(50)
say f"Primes under 50: {primes_under_50}"

# ------------------------------------------------------------------------------
# 9. String Iteration & Variable Bounds (Chapter 06 §1.3, §1.4)
# ------------------------------------------------------------------------------
# Iterating a string yields one single-char string per Unicode scalar.
let spelled = ""
for ch in "abc"
    spelled += ch
end
assert_eq(spelled, "abc")

let lo_b = 2
let hi_b = 5
let var_sum = 0
for i in lo_b..hi_b
    var_sum += i
end
assert_eq(var_sum, 9)                # 2+3+4: bounds may be variables

# Chapter 06 §1.3 (fixed 2026-09-22): `..` is half-open [start, end) in loops,
# matching slicing (`a[1..4]`). `..=` stays inclusive. Previously the loop ran
# the end value too (6 trips for 0..5); that was a spec violation, now fixed
# with an `inclusive` flag threaded from parser to codegen.
let trip_count = 0
for i in 0..5
    trip_count += 1
end
assert_eq(trip_count, 5)
assert_eq(sum_exclusive, 10)         # 0+1+2+3+4

say f"String iter: {spelled}, var bounds sum: {var_sum}, trips: {trip_count}"

# ------------------------------------------------------------------------------
# 10. Flow Control in while/for (Chapter 06 §1.7)
# ------------------------------------------------------------------------------
let odd_sum = 0
let k = 0
while k < 10
    k += 1
    if k % 2 == 0
        continue
    end
    odd_sum += k
end
assert_eq(odd_sum, 25)               # 1+3+5+7+9

let found_break = -1
for n in [5, 6, 7]
    if n == 6
        found_break = n
        break
    end
end
assert_eq(found_break, 6)

say f"while+continue sum: {odd_sum}, for+break: {found_break}"

# ------------------------------------------------------------------------------
# 11. Native Test Blocks for Chapter 06
# ------------------------------------------------------------------------------
test "inclusive range product is factorial"
    let p = 1
    for i in 1..=5
        p *= i
    end
    assert_eq(p, 120)
end

test "empty range body never runs"
    let runs = 0
    for i in 0..0
        runs += 1
    end
    assert_eq(runs, 0)
end

@test
function test_nested_break_exits_inner()
    let hits = 0
    for a in [1, 2]
        for b in [3, 4]
            if b == 3
                hits += 1
                break
            end
        end
    end
    assert_eq(hits, 2)
end
