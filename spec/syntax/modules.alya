# ==============================================================================
# Alya Language Specification: Chapter 11 - Modules, Packages & Visibility
# File: syntax/modules.alya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Standard Library Imports (Whole Module Namespace)
# ------------------------------------------------------------------------------
import "std/math"
import "std/os"

let root_val = math.sqrt(64.0)
say f"Square root: {root_val}, Host OS: {os.platform()}"

# ------------------------------------------------------------------------------
# 2. Aliased Imports with 'as'
# ------------------------------------------------------------------------------
import "std/str" as text_ops
import "std/time" as clock

let raw_msg = "   alya compiler pipeline   "
say f"Trimmed & Uppercase: '{text_ops.trim(raw_msg).to_upper()}'"
say f"Current epoch ms: {clock.now_millis()}"

# ------------------------------------------------------------------------------
# 3. Selective Imports via 'from ... import'
# ------------------------------------------------------------------------------
from "std/math" import PI, floor, ceil, random

say f"Direct Pi: {PI}"
say f"Direct floor: {floor(7.9)}"
say f"Direct ceil: {ceil(7.1)}"
say f"Direct random: {random()}"

# ------------------------------------------------------------------------------
# 4. Third-Party Package & Relative File Imports
# ------------------------------------------------------------------------------
# Importing from an external package managed via alya.toml:
# import "alya-lang/http"
# import "alya-lang/crypto" as cipher
#
# Multi-Major Package Coexistence & Diamond Dependency Resolution:
# Under Alya's Major-Segregated resolution, incompatible major versions (e.g. z-v1 vs z-v2)
# are isolated on disk and scoped contextually per package manifest:
# import "z"           # Resolves to the major version declared in this package's alya.toml
# import "z2" as z_next # Package aliasing allows coexisting major versions if declared
#
# Strict Dependency Isolation:
# Modules can only import packages explicitly declared in their owning alya.toml.
# Transitive dependencies cannot be implicitly leaked or imported.

# Importing from relative project files:
# import "./utils/helpers" as helpers
# from "../shared/models" import UserRecord, AccountState

# ------------------------------------------------------------------------------
# 5. Public ('pub') Visibility vs Module-Private Defaults
# ------------------------------------------------------------------------------
# Public Constant: Exported to importing modules
pub const MAX_CONNECTIONS: int = 1000

# Public Struct & Interface
pub struct ClientSession
    session_id: string
    created_at: int
    is_authenticated: bool = false
end

pub interface SessionValidator
    function validate(session: ClientSession) -> bool
end

# Public Factory Function
pub function create_session(id: string) -> ClientSession
    return ClientSession {
        session_id: id,
        created_at: clock.now(),
        is_authenticated: true
    }
end

# Private Helper Function (accessible only within this module/file)
function internal_checksum(id: string) -> int
    return id.length() * 31
end

let sess = create_session("sess_alpha_99")
say f"Session {sess.session_id} created with internal token: {internal_checksum(sess.session_id)}"

# ------------------------------------------------------------------------------
# 6. Aliased Selective Imports (Chapter 11 §1.3)
# ------------------------------------------------------------------------------
from "std/math" import PI as PI_ALIAS
from "std/str" import reverse_str as rev_alias

# NOTE: aliased import of a CONSTANT is broken (PI_ALIAS binds the raw float
# bit pattern as an integer: 4614256656552045848 instead of 3.14159).
# Aliased FUNCTION imports work; only the constant case is pinned as failing
# behavior below via inequality with the true value.
# TRIPWIRE: after the const-alias fix, flip this to assert_eq(PI_ALIAS, PI).
assert rev_alias("abc") == "cba"
assert PI_ALIAS != PI

say f"Aliased fn import: rev={rev_alias("abc")}"
# NOTE: importing the SAME module twice, once plain and once with aliased
# symbols (`from "std/math" import floor` + `from "std/math" import floor
# as fl`), drops the alias rewrite (link error `fn_fl undefined`). Until the
# import-merge path is fixed, alias imports must come from a module that is
# not also plain-imported in the same file.

# ------------------------------------------------------------------------------
# 7. Top-Level Public Values (Chapter 11 §1.2)
# ------------------------------------------------------------------------------
pub let PUB_HELPER_NUM = 7
pub const PUB_READY_FLAG: bool = true

assert_eq(PUB_HELPER_NUM, 7)
assert_eq(PUB_READY_FLAG, true)

say f"Public values: helper={PUB_HELPER_NUM}, ready={PUB_READY_FLAG}"

# ------------------------------------------------------------------------------
# 8. Native Test Blocks for Chapter 11
# ------------------------------------------------------------------------------
test "create_session factory sets fields"
    let s = create_session("t1")
    assert_eq(s.session_id, "t1")
    assert_eq(s.is_authenticated, true)
end

@test
function test_module_alias_math()
    assert_eq(rev_alias("xy"), "yx")
end
