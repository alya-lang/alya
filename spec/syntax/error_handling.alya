# ==============================================================================
# Alya Language Specification: Chapter 10 - Error Handling
# File: syntax/error_handling.alya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Custom Structured Error Types
# ------------------------------------------------------------------------------
struct NetworkError
    code: int
    endpoint: string
    reason: string
end

struct ValidationError
    field: string
    message: string
end

# ------------------------------------------------------------------------------
# 2. 'throw' Statement with Structured Errors
# ------------------------------------------------------------------------------
function fetch_record(endpoint: string, id: int) -> string
    if id <= 0
        throw ValidationError {
            field: "id",
            message: "Record ID must be positive"
        }
    end

    if endpoint == "offline.service.internal"
        throw NetworkError {
            code: 503,
            endpoint: endpoint,
            reason: "Target gateway unreachable"
        }
    end

    return f"RecordData for {id} from {endpoint}"
end

# ------------------------------------------------------------------------------
# 3. 'try' / 'catch' with Typed Pattern Matching via 'when'
# ------------------------------------------------------------------------------
try
    let data = fetch_record("offline.service.internal", 42)
    say f"Received data: {data}"
catch err
    when err
        is ValidationError =>
            say f"Validation rejected: Field '{err.field}' -> {err.message}"
        is NetworkError =>
            say f"Network failed ({err.code}) at {err.endpoint}: {err.reason}"
        else =>
            say f"Unhandled generic error: {err}"
    end
end

# ------------------------------------------------------------------------------
# 4. 'try' / 'catch' with 'finally' Cleanup Guarantee
# ------------------------------------------------------------------------------
let file_handle_open = false

try
    file_handle_open = true
    say "File handle opened for transaction."
    throw "Disk I/O failure mid-write"
catch err
    say f"Caught write error: {err}"
finally
    file_handle_open = false
    say f"Finally guarantee executed: Handle closed (open={file_handle_open})"
end

# ------------------------------------------------------------------------------
# 5. Guaranteed Interaction: 'defer' and 'try' / 'finally'
# ------------------------------------------------------------------------------
function transaction_pipeline() -> bool
    defer say "Step 4: Function-level defer executed"

    try
        defer say "Step 2: Try-block-level defer executed"
        say "Step 1: Inside try block before throw"
        throw "Simulation failure"
    catch err
        say f"Step 3: Caught simulation error: {err}"
        return false
    finally
        say "Step 3.5: Finally block executed before return"
    end
end

transaction_pipeline()

# ------------------------------------------------------------------------------
# 6. Re-throwing Caught Errors
# ------------------------------------------------------------------------------
function outer_supervisor()
    try
        fetch_record("valid.host", -1)
    catch err
        say "Supervisor logging error before re-throw..."
        throw err
    end
end

try
    outer_supervisor()
catch err
    say "Supervisor re-throw observed at top level"
end

# ------------------------------------------------------------------------------
# 7. Anonymous Catch, Bare Rethrow & Try/Finally (Chapter 10 §1.2, §1.3)
# ------------------------------------------------------------------------------
function failer_eh() -> int
    throw "inner boom"
    return 1
end

# Catch without a variable: error is swallowed anonymously.
try
    failer_eh()
catch
    say "Anonymous catch swallowed the error"
end

# `finally` without `catch`: cleanup still guaranteed.
try
    say "Try body before finally"
finally
    say "Finally-without-catch executed"
end

# Bare `throw` re-raises the currently captured error.
function bare_rethrower()
    try
        throw "bare test"
    catch
        throw
    end
end

try
    bare_rethrower()
catch err
    say f"Bare re-throw observed: {err}"
end

# ------------------------------------------------------------------------------
# 8. Native Test Blocks for Chapter 10
# ------------------------------------------------------------------------------
test "caught struct preserves fields"
    try
        throw ValidationError { field: "email", message: "bad format" }
    catch err
        assert_eq(err.field, "email")
    end
end

@test
function test_error_roundtrip()
    let seen = ""
    try
        throw "roundtrip"
    catch err
        seen = err
    end
    assert_eq(seen, "roundtrip")
end
