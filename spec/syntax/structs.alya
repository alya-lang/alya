# ==============================================================================
# Alya Language Specification: Chapter 08 - Structs & Methods (Object Model)
# File: syntax/structs.alya
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Struct Declaration with Types and Default Values
# ------------------------------------------------------------------------------
struct Point2D
    x: float
    y: float
    label: string = "unnamed"
end

# ------------------------------------------------------------------------------
# 2. Instantiation Patterns (Full, Defaults, Shorthand)
# ------------------------------------------------------------------------------
# All fields explicitly specified
let p1 = Point2D {
    x: 10.5,
    y: 20.0,
    label: "Origin-Offset"
}

# Relying on default value for 'label'
let p2 = Point2D {
    x: 0.0,
    y: 0.0
}

# Field initialization shorthand (when variable names match field names)
let x = 50.0
let y = 75.0
let p_short = Point2D { x, y, label: "ShorthandPoint" }

say f"Point 1: {p1.label} at ({p1.x}, {p1.y})"
say f"Point 2: {p2.label} at ({p2.x}, {p2.y})"
say f"Shorthand: {p_short.label} at ({p_short.x}, {p_short.y})"

# ------------------------------------------------------------------------------
# 3. Instance Methods (UFCS via 'self') & Mutability
# ------------------------------------------------------------------------------
function Point2D.distance_to(self, other: Point2D) -> float
    let dx = self.x - other.x
    let dy = self.y - other.y
    return (dx * dx + dy * dy)
end

function Point2D.shift(self, dx: float, dy: float)
    self.x += dx
    self.y += dy
end

let dist_sq = p1.distance_to(p2)
say f"Distance squared: {dist_sq}"

p2.shift(5.0, 5.0)
say f"Point 2 shifted to ({p2.x}, {p2.y})"

# ------------------------------------------------------------------------------
# 4. Static Factory Methods & Method Chaining
# ------------------------------------------------------------------------------
function Point2D.zero() -> Point2D
    return Point2D {
        x: 0.0,
        y: 0.0,
        label: "Origin"
    }
end

# Fluent Builder Pattern with Method Chaining
struct HttpRequestBuilder
    url: string = ""
    method: string = "GET"
    timeout_ms: int = 3000
end

function HttpRequestBuilder.new(url: string) -> HttpRequestBuilder
    return HttpRequestBuilder { url: url }
end

function HttpRequestBuilder.with_method(self, m: string) -> HttpRequestBuilder
    self.method = m
    return self
end

function HttpRequestBuilder.with_timeout(self, ms: int) -> HttpRequestBuilder
    self.timeout_ms = ms
    return self
end

let req = HttpRequestBuilder.new("https://api.alya.dev/v1/health")
.with_method("POST")
.with_timeout(5000)

say f"Built Request: {req.method} {req.url} (timeout: {req.timeout_ms}ms)"

# ------------------------------------------------------------------------------
# 5. Struct Composition & Nested Access
# ------------------------------------------------------------------------------
struct BoundingBox
    top_left: Point2D
    bottom_right: Point2D
    color_code: int = 0xFFFFFF
end

let box = BoundingBox {
    top_left: Point2D { x: 0.0, y: 100.0, label: "TopLeft" },
    bottom_right: Point2D { x: 100.0, y: 0.0, label: "BottomRight" }
}

say f"Box top-left coordinates: ({box.top_left.x}, {box.top_left.y})"
say f"Box border color: {box.color_code}"

# ------------------------------------------------------------------------------
# 6. Positional Construction (Chapter 02 §1.5 cross-reference)
# ------------------------------------------------------------------------------
# Brace form is canonical (Chapter 08 §1.3); positional call form also works.
let pp = Point2D(1.0, 2.0)
assert_eq(pp.x, 1.0)
assert_eq(pp.y, 2.0)

# Chained call directly on a fresh literal.
assert_eq(Point2D { x: 3.0, y: 4.0 }.distance_to(Point2D.zero()), 25.0)

say f"Positional: ({pp.x}, {pp.y})"

# ------------------------------------------------------------------------------
# 7. Identity Equality & Untyped Fields
# ------------------------------------------------------------------------------
# Struct `==` compares identity, not structural content.
let ident_a = Point2D { x: 1.0, y: 1.0 }
let ident_b = Point2D { x: 1.0, y: 1.0 }
assert ident_a != ident_b
assert ident_a == ident_a

# Fields may omit type annotations (used widely in Lib packages even though
# the Chapter 08 EBNF shows only typed fields).
struct LoosePair
    first,
    second
end

let loose = LoosePair { first: 1, second: "two" }
assert_eq(loose.first, 1)
assert_eq(loose.second, "two")

say "Identity equality and untyped fields OK"

# ------------------------------------------------------------------------------
# 8. Native Test Blocks for Chapter 08
# ------------------------------------------------------------------------------
test "defaults apply when fields omitted"
    let o = Point2D { x: 5.0, y: 5.0 }
    assert_eq(o.label, "unnamed")
end

test "mutation persists on instance"
    let m = Point2D { x: 1.0, y: 1.0 }
    m.shift(2.0, 3.0)
    assert_eq(m.x, 3.0)
    assert_eq(m.y, 4.0)
end

@test
function test_factory_methods()
    let z = Point2D.zero()
    assert_eq(z.x, 0.0)
    assert_eq(z.label, "Origin")
end
