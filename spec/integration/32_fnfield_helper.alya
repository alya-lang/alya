## Fixture helper: function-valued field vs string literal (alya-lang/alya#113).
## Distilled from Lib/http router: `Route.action` holds a function stored
## dynamically, `Match.action` holds a string literal. The bare
## `struct_field_str:action` marker must stay unset; dynamic-base reads
## dispatch at runtime.

pub struct Route
    method: string
    action
    pattern: string
end

pub struct Router
    routes: array
    fallback
end

pub struct Match
    found: int
    action
    note: string
end

pub function router_new(fallback)
    return Router { routes: [], fallback: fallback }
end

pub function router_add(r, pattern: string, action)
    let route = Route { method: "GET", action: action, pattern: pattern }
    push(r.routes, route)
    return r
end

pub function router_match(r, pattern: string)
    return Match { found: 0, action: "missing", note: pattern }
end
