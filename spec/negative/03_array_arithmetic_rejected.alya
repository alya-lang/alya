# EXPECT-FAIL: check: Operator '+' cannot be applied to 'int[]' and 'int[]'
# Chapter 03: arithmetic on arrays is a compile-time error
# (alya-lang/alya#46). Array `+` has no concatenation semantics; accepting it
# emits integer addition on two heap pointers and crashes at runtime.
let a = [4] + [1, 2, 3]
say str(len(a))
