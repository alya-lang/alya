# Destructuring and Spread in Alya
# Demonstrates array destructuring, rest patterns, and spread operators

say "=== Array Destructuring ==="
let coords = [10, 20, 30]
let [x, y, z] = coords
say "x: {x}, y: {y}, z: {z}"

say "\n=== Rest Pattern ==="
let numbers = [1, 2, 3, 4, 5]
let [first, second, ...tail] = numbers
say "First: {first}"
say "Second: {second}"
say "Tail length: " + str(len(tail))

say "\n=== Multiple Returns ==="
function get_dimensions()
    return 1920, 1080
end

let w, h = get_dimensions()
say "Resolution: {w}x{h}"

say "\n=== In and Not In Operators ==="
let fruits = ["apple", "banana", "cherry"]
let has_apple = "apple" in fruits
let has_grape = "grape" not in fruits
say "Has apple: {has_apple}"
say "Grape not in fruits: {has_grape}"
