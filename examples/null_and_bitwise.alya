# Null Literal and Bitwise Operators Demo

# 1. Null literal and comparisons
let value = null
say "Initial value: {value}"

if value is null
    say "Value is null"
end

value = 42
say "Updated value: {value}"

if value is not null
    say "Value is not null"
end

# 2. Bitwise operators
let a = 12
let b = 10

let and_res = a & b
let or_res = a | b
let xor_res = a ^ b
let shl_res = 1 << 4
let shr_res = 32 >> 2

say "Bitwise AND: {and_res}"
say "Bitwise OR:  {or_res}"
say "Bitwise XOR: {xor_res}"
say "Shift left:  {shl_res}"
say "Shift right: {shr_res}"

# 3. Compound assignments
let x = 7
x &= 3
say "After &= 3: {x}"
x |= 8
say "After |= 8: {x}"
x ^= 2
say "After ^= 2: {x}"
x <<= 2
say "After <<= 2: {x}"
x >>= 3
say "After >>= 3: {x}"
