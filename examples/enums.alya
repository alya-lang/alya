# Enums and Enumerations in Alya
# Demonstrates enum declarations, variant values, comparisons, and pattern matching

enum Status
    Pending = 1,
    Active = 2,
    Completed = 3,
    Failed = 4
end

enum Direction
    North = 0,
    East = 90,
    South = 180,
    West = 270
end

function status_label(st)
    when st
        is Status.Pending then return "Pending Review"
        is Status.Active then return "Active / In Progress"
        is Status.Completed then return "Successfully Completed"
        is Status.Failed then return "Operation Failed"
        else return "Unknown Status"
    end
end

say "=== Enums in Alya ==="
say "Status.Pending: {Status.Pending}"
say "Status.Active: {Status.Active}"
say "Status.Completed: {Status.Completed}"
say "Status.Failed: {Status.Failed}"

say "\n=== Pattern Matching with Enums ==="
say status_label(Status.Active)
say status_label(Status.Completed)

say "\n=== Direction Enums ==="
say "Heading East: {Direction.East} degrees"
say "Heading South: {Direction.South} degrees"
