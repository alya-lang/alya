import "std/bench"

function fib(n)
    if n <= 1
        return n
    end
    return fib(n - 1) + fib(n - 2)
end

let runner = bench_runner("Recursive Fibonacci Benchmark")

# fib(20) x 500
runner.start(500)
let i = 0
let res = 0
while i < 500
    res = fib(20)
    i += 1
end
runner.stop("fib(20)")

# fib(24) x 50
runner.start(50)
i = 0
while i < 50
    res = fib(24)
    i += 1
end
runner.stop("fib(24)")

say "Fibonacci result verified: " + str(res)
runner.summary()
