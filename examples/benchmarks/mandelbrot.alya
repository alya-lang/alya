import "std/bench"

function mandelbrot_point(cr, ci, max_iter)
    let zr = 0.0
    let zi = 0.0
    let iter = 0
    while iter < max_iter
        let zr2 = zr * zr
        let zi2 = zi * zi
        if zr2 + zi2 > 4.0
            return iter
        end
        zi = 2.0 * zr * zi + ci
        zr = zr2 - zi2 + cr
        iter += 1
    end
    return max_iter
end

function compute_grid(width, height, max_iter)
    let total_escaped = 0
    let y = 0
    while y < height
        let ci = -1.5 + (3.0 * y) / height
        let x = 0
        while x < width
            let cr = -2.0 + (3.0 * x) / width
            let iters = mandelbrot_point(cr + 0.0, ci + 0.0, max_iter)
            if iters == max_iter
                total_escaped += 1
            end
            x += 1
        end
        y += 1
    end
    return total_escaped
end

let runner = bench_runner("Mandelbrot Fractal Benchmark")

runner.start(10)
let k = 0
let total = 0
while k < 10
    total = compute_grid(80, 40, 100)
    k += 1
end
runner.stop("mandelbrot 80x40 grid (100 iters)")

say "Mandelbrot core points counted: " + str(total)
runner.summary()
