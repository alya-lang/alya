import "std/bench"
import "std/hash"
import "std/str"

let runner = bench_runner("String & Hashing Benchmark")

let sample = "The quick brown fox jumps over the lazy dog! Alya is fast and modern."

runner.start(10000)
let i = 0
let h = 0
while i < 10000
    h = fnv1a(sample)
    i += 1
end
runner.stop("fnv1a string hashing")

runner.start(2000)
let j = 0
let len_acc = 0
while j < 2000
    let s = str_repeat("alya", 10)
    len_acc += len(s)
    j += 1
end
runner.stop("str_repeat 10x allocations")

say "Final hash: " + str(h)
runner.summary()
