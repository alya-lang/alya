import "std/bench"

function count_primes(limit)
    let flags = []
    let i = 0
    while i <= limit
        flags.push(1)
        i += 1
    end

    let p = 2
    while p * p <= limit
        if flags[p] == 1
            let multiple = p * p
            while multiple <= limit
                flags[multiple] = 0
                multiple += p
            end
        end
        p += 1
    end

    let count = 0
    let j = 2
    while j <= limit
        if flags[j] == 1
            count += 1
        end
        j += 1
    end
    return count
end

let runner = bench_runner("Sieve of Eratosthenes Benchmark")

runner.start(20)
let run = 0
let primes = 0
while run < 20
    primes = count_primes(2000)
    run += 1
end
runner.stop("sieve_of_eratosthenes up to 2000")

say "Primes under 2000: " + str(primes)
runner.summary()
