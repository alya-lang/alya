import "std/bench"
import "std/math"

let runner = bench_runner("Alya Builtin Micro-Benchmarks")

runner.start(100000)
let i = 0
while i < 100000
    sin(0.5)
    i += 1
end
runner.stop("sin(0.5) calculation")

runner.start(100000)
i = 0
while i < 100000
    gcd(123456, 7890)
    i += 1
end
runner.stop("gcd(123456, 7890) integer ops")

runner.start(100000)
i = 0
while i < 100000
    let ptr = alloc(64)
    free(ptr)
    i += 1
end
runner.stop("alloc(64) heap allocation")

runner.summary()
