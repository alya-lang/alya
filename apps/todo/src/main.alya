# ═══════════════════════════════════════════════════════════════
# Alya Todo Manager (todo)
# Part of the Alya Apps Collection
#
# Uses Package Manager Dependency:
#   import "term" as ui  (from https://github.com/alya-lang/term)
# ═══════════════════════════════════════════════════════════════

import "term" as ui
import "std/fs"
import "std/str"
import "std/color"
import "std/console"
import "std/time"
import "std/os"

struct Task
    id
    done
    priority
    tag
    title
end

function split_by_char(s, delim)
    let res = []
    let slen = len(s)
    let cur = ""
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch == delim
            res.push(cur)
            cur = ""
        else
            cur += ch
        end
        i += 1
    end
    res.push(cur)
    return res
end

function load_tasks(db_path)
    let tasks = []
    if fs_exists(db_path) == 0
        return tasks
    end

    let raw = fs_read(db_path)
    if is_empty(raw)
        return tasks
    end

    let raw_lines = lines(raw)
    let i = 0
    while i < arr_len(raw_lines)
        let line = trim(raw_lines[i])
        if len(line) > 0 and char_at(line, 0) != "#"
            let parts = split_by_char(line, "|")
            if arr_len(parts) >= 5
                let t_id = to_int(parts[0])
                let t_done = to_int(parts[1])
                let t_pri = parts[2]
                let t_tag = parts[3]
                let t_title = parts[4]
                tasks.push(Task(t_id, t_done, t_pri, t_tag, t_title))
            end
        end
        i += 1
    end
    return tasks
end

function save_tasks(db_path, tasks)
    let content = "# Alya Todo Database\n"
    let i = 0
    while i < arr_len(tasks)
        let t = tasks[i]
        content += str(t.id) + "|" + str(t.done) + "|" + t.priority + "|" + t.tag + "|" + t.title + "\n"
        i += 1
    end
    fs_write(db_path, content)
end

function get_next_id(tasks)
    let max_id = 0
    let i = 0
    while i < arr_len(tasks)
        let t = tasks[i]
        if t.id > max_id
            max_id = t.id
        end
        i += 1
    end
    return max_id + 1
end

function format_priority(pri)
    when pri
        is "HIGH" then return ui::badge("HIGH", "red") + "    "
        is "MED" then return ui::badge("MED", "yellow") + "     "
        is "LOW" then return ui::badge("LOW", "cyan") + "     "
        else return ui::badge(pad_right(pri, 8, " "), "gray")
    end
end

function format_status(done)
    if done == 1
        return ui::badge("[✓]", "green")
    else
        return ui::badge("[ ]", "gray")
    end
end

function print_banner()
    say color_cyan("╔═══════════════════════════════════════════════════════════════╗")
    say color_cyan("║") + "                      " + style_bold(color_bright_white("ALYA TODO MANAGER")) + "                        " + color_cyan("║")
    say color_cyan("║") + "             " + color_gray("Terminal Task & Productivity Suite") + "                " + color_cyan("║")
    say color_cyan("║") + "            " + color_gray("Powered by 'term' Alya Package") + "                     " + color_cyan("║")
    say color_cyan("╚═══════════════════════════════════════════════════════════════╝")
    say ""
end

function cmd_add(db_path, title, priority, tag)
    if is_blank(title)
        say color_red("Error: Task title cannot be empty.")
        return
    end

    let pri_upper = upper(priority)
    if pri_upper != "HIGH" and pri_upper != "MED" and pri_upper != "LOW"
        pri_upper = "MED"
    end

    let clean_tag = lower(tag)
    if is_blank(clean_tag)
        clean_tag = "general"
    end

    let tasks = load_tasks(db_path)
    let new_id = get_next_id(tasks)
    let new_task = Task(new_id, 0, pri_upper, clean_tag, title)
    tasks.push(new_task)
    save_tasks(db_path, tasks)

    say color_green("✓ Added task #") + style_bold(str(new_id)) + ": " + title + " (" + style_bold(pri_upper) + ", #" + clean_tag + ")"
end

function cmd_list(db_path, filter_status, filter_tag)
    let tasks = load_tasks(db_path)
    if arr_len(tasks) == 0
        say "  " + color_gray("No tasks recorded yet. Use 'add \"<title>\"' to create one.")
        say ""
        return
    end

    let matching = []
    let done_count = 0
    let total_count = arr_len(tasks)

    let i = 0
    while i < total_count
        let t = tasks[i]
        if t.done == 1
            done_count += 1
        end

        let pass_status = 1
        if filter_status == 1 and t.done != 1
            pass_status = 0
        elif filter_status == 0 and t.done != 0
            pass_status = 0
        end

        let pass_tag = 1
        if len(filter_tag) > 0 and t.tag != filter_tag
            pass_tag = 0
        end

        if pass_status == 1 and pass_tag == 1
            matching.push(t)
        end
        i += 1
    end

    say "  " + ui::box_top(4, 3, 8, 31, 8)
    say "  " + ui::row(style_bold("ID  "), style_bold("ST "), style_bold("PRIORITY"), style_bold("TASK TITLE                     "), style_bold("TAG     "))
    say "  " + ui::box_mid(4, 3, 8, 31, 8)

    if arr_len(matching) == 0
        say "  │ " + pad_right(color_gray("No matching tasks found."), 61, " ") + " │"
    else
        let m_idx = 0
        while m_idx < arr_len(matching)
            let t = matching[m_idx]
            let id_str = pad_right("#" + str(t.id), 4, " ")
            let st_str = format_status(t.done)
            let pri_str = format_priority(t.priority)
            let title_disp = t.title
            if len(title_disp) > 31
                title_disp = substring(title_disp, 0, 28) + "..."
            end
            let title_pad = pad_right(title_disp, 31, " ")
            if t.done == 1
                title_pad = style_dim(title_pad)
            end
            let tag_pad = pad_right("#" + t.tag, 8, " ")

            say "  " + ui::row(id_str, st_str, pri_str, title_pad, ui::badge(tag_pad, "magenta"))
            m_idx += 1
        end
    end

    say "  " + ui::box_bot(4, 3, 8, 31, 8)

    let pbar = console_progress_bar(done_count, total_count, 16)
    say "  " + style_bold("Progress") + ": " + pbar + " (" + str(done_count) + "/" + str(total_count) + " completed, " + str(total_count - done_count) + " pending)"
    say ""
end

function cmd_set_done(db_path, task_id, is_done)
    let tasks = load_tasks(db_path)
    let found = 0
    let i = 0
    while i < arr_len(tasks)
        let t = tasks[i]
        if t.id == task_id
            t.done = is_done
            found = 1
            if is_done == 1
                say color_green("✓ Marked task #") + str(task_id) + " as completed: " + t.title
            else
                say color_yellow("↺ Reopened task #") + str(task_id) + ": " + t.title
            end
            break
        end
        i += 1
    end

    if found == 0
        say color_red("Error: Task #") + str(task_id) + " not found."
    else
        save_tasks(db_path, tasks)
    end
end

function cmd_delete(db_path, task_id)
    let tasks = load_tasks(db_path)
    let new_tasks = []
    let found = 0
    let i = 0
    while i < arr_len(tasks)
        let t = tasks[i]
        if t.id == task_id
            found = 1
            say color_green("✓ Removed task #") + str(task_id) + ": " + t.title
        else
            new_tasks.push(t)
        end
        i += 1
    end

    if found == 0
        say color_red("Error: Task #") + str(task_id) + " not found."
    else
        save_tasks(db_path, new_tasks)
    end
end

function cmd_clear(db_path)
    let tasks = load_tasks(db_path)
    let active_tasks = []
    let cleared = 0
    let i = 0
    while i < arr_len(tasks)
        let t = tasks[i]
        if t.done == 1
            cleared += 1
        else
            active_tasks.push(t)
        end
        i += 1
    end

    save_tasks(db_path, active_tasks)
    say color_green("✓ Cleared ") + str(cleared) + " completed task(s). " + str(arr_len(active_tasks)) + " active task(s) remaining."
end

function cmd_stats(db_path)
    let tasks = load_tasks(db_path)
    let total = arr_len(tasks)
    let done = 0
    let high = 0
    let med = 0
    let low = 0

    let i = 0
    while i < total
        let t = tasks[i]
        if t.done == 1
            done += 1
        end
        if t.priority == "HIGH"
            high += 1
        elif t.priority == "MED"
            med += 1
        elif t.priority == "LOW"
            low += 1
        end
        i += 1
    end

    let pct = 0
    if total > 0
        pct = (done * 100) / total
    end

    say "  " + style_bold("Productivity Metrics & Breakdown:")
    say "  ─────────────────────────────────────────────────────────────"
    say "  Total Tasks:      " + str(total)
    say "  Completed:        " + color_green(str(done)) + " (" + str(pct) + "%)"
    say "  Pending:          " + color_yellow(str(total - done))
    say ""
    say "  Priority Distribution:"
    say "    • " + ui::badge("HIGH", "red") + "    : " + str(high) + " task(s)"
    say "    • " + ui::badge("MED", "yellow") + "     : " + str(med) + " task(s)"
    say "    • " + ui::badge("LOW", "cyan") + "     : " + str(low) + " task(s)"
    say "  ─────────────────────────────────────────────────────────────"
    say ""
end

function print_help()
    say "Commands:"
    say "  add <title> [--pri high|med|low] [--tag <name>]  Add new task"
    say "  list [--all] [--pending] [--done] [--tag <name>] List recorded tasks"
    say "  done <id>                                        Mark task as completed"
    say "  undone <id>                                      Reopen completed task"
    say "  rm <id> / delete <id>                            Delete task permanently"
    say "  clear                                            Purge all completed tasks"
    say "  stats                                            Display productivity statistics"
    say "  help                                             Show this help message"
    say "  exit / quit                                      Exit application"
    say ""
end

function run_test_suite()
    let test_db = "test_todo_runner.db"
    if fs_exists(test_db)
        fs_remove(test_db)
    end

    say color_yellow("[TODO]") + " Running automated test suite (with 'term' package)..."
    cmd_add(test_db, "Implement C FFI engine", "HIGH", "core")
    cmd_add(test_db, "Write comprehensive LSP docs", "MED", "docs")
    cmd_add(test_db, "Refactor snake collision neighbors", "LOW", "apps")

    let tasks = load_tasks(test_db)
    if arr_len(tasks) != 3
        say color_red("[FAIL] Expected 3 tasks, found " + str(arr_len(tasks)))
        return 1
    end

    cmd_set_done(test_db, 1, 1)
    tasks = load_tasks(test_db)
    if tasks[0].done != 1
        say color_red("[FAIL] Task #1 should be marked done")
        return 1
    end

    cmd_delete(test_db, 2)
    tasks = load_tasks(test_db)
    if arr_len(tasks) != 2
        say color_red("[FAIL] Expected 2 tasks after deletion")
        return 1
    end

    say color_yellow("[TODO]") + " Displaying test list:"
    cmd_list(test_db, -1, "")

    # Test interactive tokenization and command execution
    let add_tokens = tokenize_command("add \"Interactive Task Title\" --pri high --tag interactive")
    execute_action(add_tokens, test_db)

    tasks = load_tasks(test_db)
    if arr_len(tasks) != 3
        say color_red("[FAIL] Expected 3 tasks after interactive add")
        return 1
    end
    let last_t = tasks[2]
    if last_t.title != "Interactive Task Title" or last_t.priority != "HIGH" or last_t.tag != "interactive"
        say color_red("[FAIL] Interactive add task properties mismatched")
        return 1
    end

    say color_yellow("[TODO]") + " Testing interactive list variations..."
    execute_action(tokenize_command("list --all"), test_db)
    execute_action(tokenize_command("list all"), test_db)
    execute_action(tokenize_command("list -all"), test_db)
    execute_action(tokenize_command("list pending"), test_db)
    execute_action(tokenize_command("list --tag interactive"), test_db)

    say color_yellow("[TODO]") + " Testing done / undone / rm with # prefixes..."
    execute_action(tokenize_command("done 4"), test_db)
    tasks = load_tasks(test_db)
    if tasks[2].done != 1
        say color_red("[FAIL] Task #4 should be completed")
        return 1
    end

    execute_action(tokenize_command("undone #4"), test_db)
    tasks = load_tasks(test_db)
    if tasks[2].done != 0
        say color_red("[FAIL] Task #4 should be reopened")
        return 1
    end

    execute_action(tokenize_command("done #4"), test_db)
    execute_action(tokenize_command("clear"), test_db)
    tasks = load_tasks(test_db)
    if arr_len(tasks) != 1
        say color_red("[FAIL] Expected 1 active task after clear")
        return 1
    end

    say color_yellow("[TODO]") + " Displaying test statistics:"
    execute_action(tokenize_command("stats"), test_db)

    if fs_exists(test_db)
        fs_remove(test_db)
    end

    say color_green("[SUCCESS]") + " Todo application with 'term' package verified cleanly."
    return 0
end

function tokenize_command(line)
    let tokens = []
    let slen = len(line)
    let cur = ""
    let in_quote = 0
    let quote_char = ""
    let i = 0

    while i < slen
        let ch = char_at(line, i)
        if in_quote == 1
            if ch == quote_char
                in_quote = 0
                tokens.push(cur)
                cur = ""
            else
                cur += ch
            end
        else
            if ch == "\"" or ch == "'"
                in_quote = 1
                quote_char = ch
            elif ch == " " or ch == "\t"
                if len(cur) > 0
                    tokens.push(cur)
                    cur = ""
                end
            else
                cur += ch
            end
        end
        i += 1
    end

    if len(cur) > 0
        tokens.push(cur)
    end

    return tokens
end

function execute_action(tokens, db_path)
    if arr_len(tokens) == 0
        return
    end

    let raw_cmd = tokens[0]
    let cmd = lower(raw_cmd)

    if cmd == "help" or cmd == "--help" or cmd == "-h" or cmd == "?"
        print_banner()
        print_help()
        return
    elif cmd == "clear"
        cmd_clear(db_path)
        return
    elif cmd == "stats"
        cmd_stats(db_path)
        return
    elif cmd == "list" or cmd == "ls"
        let filter_status = -1
        let filter_tag = ""
        let j = 1
        while j < arr_len(tokens)
            let tok = tokens[j]
            let tok_l = lower(tok)
            if tok_l == "--all" or tok_l == "-all" or tok_l == "all" or tok_l == "-a"
                filter_status = -1
            elif tok_l == "--pending" or tok_l == "-pending" or tok_l == "pending" or tok_l == "-p" or tok_l == "todo" or tok_l == "active"
                filter_status = 0
            elif tok_l == "--done" or tok_l == "-done" or tok_l == "done" or tok_l == "-d" or tok_l == "completed"
                filter_status = 1
            elif (tok_l == "--tag" or tok_l == "-t") and j + 1 < arr_len(tokens)
                filter_tag = lower(tokens[j + 1])
                j += 1
            elif starts_with(tok_l, "--tag=")
                filter_tag = lower(substring(tok, 6, len(tok) - 6))
            elif starts_with(tok_l, "#")
                filter_tag = lower(substring(tok, 1, len(tok) - 1))
            else
                filter_tag = tok_l
            end
            j += 1
        end
        if starts_with(filter_tag, "#")
            filter_tag = substring(filter_tag, 1, len(filter_tag) - 1)
        end
        cmd_list(db_path, filter_status, filter_tag)
        return
    elif cmd == "add"
        let title_parts = []
        let pri = "MED"
        let tag = "general"
        let j = 1
        while j < arr_len(tokens)
            let tok = tokens[j]
            let tok_l = lower(tok)
            if (tok_l == "--pri" or tok_l == "-p" or tok_l == "--priority") and j + 1 < arr_len(tokens)
                pri = tokens[j + 1]
                j += 1
            elif starts_with(tok_l, "--pri=")
                pri = substring(tok, 6, len(tok) - 6)
            elif (tok_l == "--tag" or tok_l == "-t") and j + 1 < arr_len(tokens)
                tag = tokens[j + 1]
                j += 1
            elif starts_with(tok_l, "--tag=")
                tag = substring(tok, 6, len(tok) - 6)
            else
                title_parts.push(tok)
            end
            j += 1
        end

        if starts_with(tag, "#")
            tag = substring(tag, 1, len(tag) - 1)
        end

        let title = ""
        let k = 0
        while k < arr_len(title_parts)
            if k > 0
                title += " "
            end
            title += title_parts[k]
            k += 1
        end

        if is_blank(title)
            say color_red("Error: Task title cannot be empty. Usage: add <title> [--pri high|med|low] [--tag <name>]")
            return
        end

        cmd_add(db_path, title, pri, tag)
        return
    elif cmd == "done" or cmd == "undone"
        if arr_len(tokens) < 2
            say color_red("Error: Missing task ID. Usage: ") + cmd + " <id>"
            return
        end
        let raw_id = tokens[1]
        if starts_with(raw_id, "#")
            raw_id = substring(raw_id, 1, len(raw_id) - 1)
        end
        let tid = to_int(raw_id)
        if tid <= 0
            say color_red("Error: Invalid task ID '") + tokens[1] + color_red("'. Please specify a numeric ID.")
            return
        end
        if cmd == "done"
            cmd_set_done(db_path, tid, 1)
        else
            cmd_set_done(db_path, tid, 0)
        end
        return
    elif cmd == "rm" or cmd == "delete" or cmd == "remove"
        if arr_len(tokens) < 2
            say color_red("Error: Missing task ID. Usage: ") + cmd + " <id>"
            return
        end
        let raw_id = tokens[1]
        if starts_with(raw_id, "#")
            raw_id = substring(raw_id, 1, len(raw_id) - 1)
        end
        let tid = to_int(raw_id)
        if tid <= 0
            say color_red("Error: Invalid task ID '") + tokens[1] + color_red("'. Please specify a numeric ID.")
            return
        end
        cmd_delete(db_path, tid)
        return
    else
        say color_red("Unknown command: '") + raw_cmd + color_red("'. Type 'help' for available commands.")
    end
end

function interactive_mode(db_path)
    print_banner()
    print_help()
    cmd_list(db_path, -1, "")

    while 1
        let line = trim(ask(color_cyan("alya-todo> ")))
        if is_empty(line)
            continue
        end

        let tokens = tokenize_command(line)
        if arr_len(tokens) == 0
            continue
        end

        let first = lower(tokens[0])
        if first == "exit" or first == "quit" or first == "q"
            say "Goodbye!"
            break
        end

        execute_action(tokens, db_path)
    end
end

function main()
    let cli_args = args()
    let db_path = "todo.db"

    if arr_len(cli_args) == 0
        interactive_mode(db_path)
        return
    end

    if cli_args[0] == "--test" or cli_args[0] == "test"
        run_test_suite()
        return
    end

    execute_action(cli_args, db_path)
end

main()
