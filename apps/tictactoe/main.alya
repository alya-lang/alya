# ═══════════════════════════════════════════════════════════════
# TicTacToe - A classic game with PvP and AI modes
# Part of the Alya Apps Collection
# ═══════════════════════════════════════════════════════════════
#
# Features:
#   - Player vs Player (PvP) mode
#   - Player vs AI mode (unbeatable Minimax algorithm)
#   - Modern Terminal UI styled with 'term' ecosystem package
#   - Persistent score tracking across multiple rounds
#   - Robust input validation with error handling
#   - Modern enums, struct methods, and pattern matching
#   - Non-hanging automated smoke test mode (--test)
#
# Controls:
#   Enter a number 1-9 to place your mark:
#     1 | 2 | 3
#     4 | 5 | 6
#     7 | 8 | 9
#
# Usage:
#   alya run
#   alya run -- --test
# ═══════════════════════════════════════════════════════════════

import "term" as ui
import "std/color"
import "std/console"
import "std/mem"
import "std/os"

enum Mark
    Empty = 0,
    X = 1,
    O = 2
end

# ─── Score Tracking Struct ───────────────────────────────────

struct Scores
    p1
    p2
    draws
    rounds
end

function Scores.add_win_p1(self)
    self.p1 += 1
end

function Scores.add_win_p2(self)
    self.p2 += 1
end

function Scores.add_draw(self)
    self.draws += 1
end

function Scores.next_round(self)
    self.rounds += 1
end

# ─── String Persistence ─────────────────────────────────────
# Player names must survive the circular string buffer. We copy
# them into a small arena so they remain valid for the entire
# session regardless of how many temporary strings are created.

function persist_str(arena, s)
    if len(s) == 0
        return s
    end
    return arena_alloc_string(arena, s)
end

# ─── Display Functions ───────────────────────────────────────

function clear_screen()
    console_clear()
end

function show_banner()
    let banner_text = "       T I C  T A C  T O E\n    Written in Alya Language"
    say ui::box_render(ui::box_new(banner_text, "ALYA TIC-TAC-TOE", "rounded"))
    say ""
end

function cell_display(val, pos)
    when val
        is Mark.X then return ui::style_bold(ui::color_bright_red(" X "))
        is Mark.O then return ui::style_bold(ui::color_bright_blue(" O "))
        else return ui::color_gray(" " + str(pos) + " ")
    end
end

function draw_board(board)
    say ui::color_cyan("    ┌───┬───┬───┐")
    say ui::color_cyan("    │") + cell_display(board[0], 1) + ui::color_cyan("│") + cell_display(board[1], 2) + ui::color_cyan("│") + cell_display(board[2], 3) + ui::color_cyan("│")
    say ui::color_cyan("    ├───┼───┼───┤")
    say ui::color_cyan("    │") + cell_display(board[3], 4) + ui::color_cyan("│") + cell_display(board[4], 5) + ui::color_cyan("│") + cell_display(board[5], 6) + ui::color_cyan("│")
    say ui::color_cyan("    ├───┼───┼───┤")
    say ui::color_cyan("    │") + cell_display(board[6], 7) + ui::color_cyan("│") + cell_display(board[7], 8) + ui::color_cyan("│") + cell_display(board[8], 9) + ui::color_cyan("│")
    say ui::color_cyan("    └───┴───┴───┘")
    say ""
end

function show_scores(n1, n2, sc)
    let headers = ["Participant", "Mark", "Score"]
    let rows = [ [n1, ui::color_bright_red("X"), str(sc.p1)], [n2, ui::color_bright_blue("O"), str(sc.p2)], ["Draws", "-", str(sc.draws)], ["Total Rounds", "-", str(sc.rounds)] ]
    let tbl = ui::table_create(headers, rows, "unicode")
    say ui::table_render(tbl)
    say ""
end

# ─── Game Logic ──────────────────────────────────────────────

function check_winner(board)
    # Rows
    if board[0] != Mark.Empty and board[0] == board[1] and board[1] == board[2]
        return board[0]
    end
    if board[3] != Mark.Empty and board[3] == board[4] and board[4] == board[5]
        return board[3]
    end
    if board[6] != Mark.Empty and board[6] == board[7] and board[7] == board[8]
        return board[6]
    end

    # Columns
    if board[0] != Mark.Empty and board[0] == board[3] and board[3] == board[6]
        return board[0]
    end
    if board[1] != Mark.Empty and board[1] == board[4] and board[4] == board[7]
        return board[1]
    end
    if board[2] != Mark.Empty and board[2] == board[5] and board[5] == board[8]
        return board[2]
    end

    # Diagonals
    if board[0] != Mark.Empty and board[0] == board[4] and board[4] == board[8]
        return board[0]
    end
    if board[2] != Mark.Empty and board[2] == board[4] and board[4] == board[6]
        return board[2]
    end

    return Mark.Empty
end

function is_board_full(board)
    for i in 0..8
        if board[i] == Mark.Empty
            return 0
        end
    end
    return 1
end

# ─── AI Engine (Minimax Algorithm) ───────────────────────────

function minimax(board, is_maximizing)
    let winner = check_winner(board)
    if winner == Mark.X
        return -10
    end
    if winner == Mark.O
        return 10
    end
    if is_board_full(board) == 1
        return 0
    end

    if is_maximizing == 1
        let best = -100
        let i = 0
        while i < 9
            if board[i] == Mark.Empty
                board[i] = Mark.O
                let s = minimax(board, 0)
                board[i] = Mark.Empty
                if s > best
                    best = s
                end
            end
            i += 1
        end
        return best
    end

    let best = 100
    let i = 0
    while i < 9
        if board[i] == Mark.Empty
            board[i] = Mark.X
            let s = minimax(board, 1)
            board[i] = Mark.Empty
            if s < best
                best = s
            end
        end
        i += 1
    end
    return best
end

function ai_best_move(board)
    let best_score = -100
    let best_pos = 0
    let i = 0
    while i < 9
        if board[i] == Mark.Empty
            board[i] = Mark.O
            let s = minimax(board, 0)
            board[i] = Mark.Empty
            if s > best_score
                best_score = s
                best_pos = i
            end
        end
        i += 1
    end
    return best_pos
end

# ─── Player Input ────────────────────────────────────────────

function get_move(board, name, mark)
    let mark_str = "X"
    if mark == Mark.O
        mark_str = "O"
    end

    repeat
        let prompt = "    " + name + " (" + mark_str + ") -> Position (1-9): "
        let input = ask prompt
        let choice = trim(input)

        try
            let pos = int(choice)
            if pos >= 1 and pos <= 9
                if board[pos - 1] == Mark.Empty
                    return pos - 1
                end
                console_beep()
                say ui::color_yellow("    ! Position already taken. Choose another.")
            else
                console_beep()
                say ui::color_yellow("    ! Please enter a number between 1 and 9.")
            end
        catch err
            console_beep()
            say ui::color_yellow("    ! Invalid input. Please enter a number.")
        end
    end
end

# ═══════════════════════════════════════════════════════════════
#                        MAIN GAME
# ═══════════════════════════════════════════════════════════════

function main()
    let cli_args = args()
    if len(cli_args) > 0 and cli_args[0] in ["--test", "test"]
        say ui::color_cyan("[TEST]") + " Running TicTacToe Minimax AI smoke test..."
        let test_board = [Mark.X, Mark.O, Mark.X, Mark.O, Mark.O, Mark.X, Mark.Empty, Mark.X, Mark.Empty]
        let m = ai_best_move(test_board)
        say ui::color_green("[TEST]") + " AI move calculated: position " + str(m)
        let t_scores = Scores(1, 1, 0, 2)
        show_scores("Player 1", "Alya AI", t_scores)
        say ui::color_green("[TEST]") + " Smoke test completed successfully."
        return
    end

    console_utf8()
    console_title("TicTacToe - Alya")

    clear_screen()
    show_banner()

    let str_arena = arena_new(4096)

    say ui::color_bright_cyan("  Welcome to TicTacToe!")
    say ""

    let p1_raw = ask "  Enter Player 1 name: "
    let name1 = trim(p1_raw)
    if len(name1) > 0
        name1 = persist_str(str_arena, name1)
    else
        name1 = "Player 1"
    end

    say ""
    say "  " + ui::color_bright_green("[1]") + " Player vs Player (PvP)"
    say "  " + ui::color_bright_green("[2]") + " Player vs AI"
    say ""

    let mode_raw = ask "  Choose mode (1/2): "
    let mode = trim(mode_raw)

    let is_ai = 0
    let name2 = "Player 2"

    if mode == "2"
        is_ai = 1
        name2 = "Alya AI"
        say ""
        say ui::color_bright_magenta("  You will face the unbeatable Alya AI! Good luck!")
        sleep(1500)
    else
        say ""
        let p2_raw = ask "  Enter Player 2 name: "
        name2 = trim(p2_raw)
        if len(name2) > 0
            name2 = persist_str(str_arena, name2)
        else
            name2 = "Player 2"
        end
    end

    let scores = Scores(0, 0, 0, 0)
    let playing = 1

    while playing == 1
        scores.next_round()
        let board = [Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty]
        let current = Mark.X
        let game_over = 0

        while game_over == 0
            clear_screen()
            show_banner()
            show_scores(name1, name2, scores)
            draw_board(board)

            if current == Mark.O and is_ai == 1
                say ui::color_bright_magenta("    Alya AI is thinking...")
                sleep(700)
                let ai_pos = ai_best_move(board)
                board[ai_pos] = Mark.O
            else
                let current_name = name1
                if current == Mark.O
                    current_name = name2
                end
                let move = get_move(board, current_name, current)
                board[move] = current
            end

            let winner = check_winner(board)
            if winner != Mark.Empty
                game_over = 1
            elif is_board_full(board) == 1
                game_over = 1
            else
                if current == Mark.X
                    current = Mark.O
                else
                    current = Mark.X
                end
            end
        end

        clear_screen()
        show_banner()
        draw_board(board)

        let result = check_winner(board)
        when result
            is Mark.X then
                console_beep()
                scores.add_win_p1()
                say ui::style_bold(ui::color_bright_green("    " + name1 + " (X) wins! Congratulations!"))
            is Mark.O then
                console_beep()
                scores.add_win_p2()
                say ui::style_bold(ui::color_bright_green("    " + name2 + " (O) wins! Congratulations!"))
            else
                scores.add_draw()
                say ui::style_bold(ui::color_bright_yellow("    It's a draw! Well played!"))
        end

        say ""
        show_scores(name1, name2, scores)

        let again_raw = ask "  Play again? (y/n): "
        let again = lower(trim(again_raw))
        if again not in ["y", "yes"]
            playing = 0
        end
    end

    say ""
    show_scores(name1, name2, scores)
    say ui::color_bright_cyan("  Thanks for playing TicTacToe!")
    say ui::color_gray("  See you next time!")
    say ""

    arena_free(str_arena)
end

main()
