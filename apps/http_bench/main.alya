# ═══════════════════════════════════════════════════════════════
# Alya HTTP Benchmark Tool (http_bench)
# Part of the Alya Apps Collection
# ═══════════════════════════════════════════════════════════════
#
# Features:
#   - Concurrent HTTP/TCP benchmarking (like wrk/ab/autocannon)
#   - Multi-threaded worker load generation via OS threads (std/thread)
#   - HTTP/1.1 Persistent Connections (Keep-Alive) socket reuse
#   - Non-blocking I/O multiplexing & Event Polling (tcp_poll)
#   - High-resolution latency profiling (Min, Max, Avg)
#   - Formatted ANSI summary table and throughput metrics (RPS)
#   - Modern struct methods, destructuring, and pattern matching
#
# Usage:
#   alya run apps/http_bench/main.alya
#   alya run apps/http_bench/main.alya -- -u http://127.0.0.1:8080/json -n 1000 -c 4
#   alya run apps/http_bench/main.alya -- -u http://127.0.0.1:8080/json -n 5000 -c 8 -k
# ═══════════════════════════════════════════════════════════════

import "url" as u
import "term" as ui
import "std/net"
import "std/str"
import "std/time"
import "std/color"
import "std/console"
import "std/thread"
import "std/os"

struct BenchConfig
    url
    total_reqs
    concurrency
    timeout_ms
    keep_alive
end

struct BenchStats
    ok_cnt
    fail_cnt
    total_ms
    min_lat
    max_lat
    avg_lat
    rps
end

function BenchConfig.show_banner(self)
    say color_cyan("╔═════════════════════════════════════════════════╗")
    say color_cyan("║") + "           " + style_bold(color_yellow("🚀 ALYA HTTP BENCHMARK 🚀")) + "            " + color_cyan("║")
    say color_cyan("╠═════════════════════════════════════════════════╣")
    say color_cyan("║") + "  Target URL   : " + color_white(self.url)
    say color_cyan("║") + "  Total Reqs   : " + color_green(str(self.total_reqs)) + " requests"
    say color_cyan("║") + "  Concurrency  : " + color_magenta(str(self.concurrency)) + " worker threads"
    if self.keep_alive == 1
        say color_cyan("║") + "  Keep-Alive   : " + color_green("enabled (persistent TCP)")
    else
        say color_cyan("║") + "  Keep-Alive   : " + color_yellow("disabled (close per req)")
    end
    say color_cyan("║") + "  Timeout      : " + str(self.timeout_ms) + " ms"
    say color_cyan("╚═════════════════════════════════════════════════╝")
    say ""
end

function BenchStats.show_results(self, cfg)
    say ""
    say color_cyan("════════════════ BENCHMARK REPORT ════════════════")
    say "  " + style_bold("Target URL") + "       : " + cfg.url
    say "  " + style_bold("Concurrency") + "      : " + str(cfg.concurrency) + " workers"
    say "  " + style_bold("Total Requests") + "   : " + str(cfg.total_reqs)
    say "  " + style_bold("Successful (2xx)") + " : " + color_green(str(self.ok_cnt))
    if self.fail_cnt > 0
        say "  " + style_bold("Failed / Errors") + "  : " + color_red(str(self.fail_cnt))
    else
        say "  " + style_bold("Failed / Errors") + "  : " + color_green("0")
    end
    say "  " + style_bold("Total Wall Time") + "  : " + str(self.total_ms) + " ms"
    say "  " + style_bold("Throughput") + "        : " + style_bold(color_yellow(str(self.rps) + " req/sec"))
    say ""
    say color_cyan("─── Latency Distribution ─────────────────────────")
    say "  " + style_bold("Fastest (Min)") + "    : " + color_green(str(self.min_lat) + " ms")
    say "  " + style_bold("Slowest (Max)") + "    : " + color_yellow(str(self.max_lat) + " ms")
    say "  " + style_bold("Average (Mean)") + "   : " + color_white(str(self.avg_lat) + " ms")
    say color_cyan("══════════════════════════════════════════════════")
    say ""
end

function parse_args()
    let cli_args = args()
    let target_u = "http://127.0.0.1:8080/json"
    let n = 50
    let c = 2
    let t = 2000
    let k = 1

    let i = 0
    while i < len(cli_args)
        let a = cli_args[i]
        if a in ["-u", "--url"] and i + 1 < len(cli_args)
            target_u = cli_args[i + 1]
        elif a in ["-n", "--requests"] and i + 1 < len(cli_args)
            let parsed_n = int(cli_args[i + 1])
            if parsed_n > 0
                n = parsed_n
            end
        elif a in ["-c", "--concurrency"] and i + 1 < len(cli_args)
            let parsed_c = int(cli_args[i + 1])
            if parsed_c > 0 and parsed_c <= 32
                c = parsed_c
            end
        elif a in ["-t", "--timeout"] and i + 1 < len(cli_args)
            let parsed_t = int(cli_args[i + 1])
            if parsed_t > 0
                t = parsed_t
            end
        elif a in ["-k", "--keep-alive"]
            k = 1
        elif a == "--no-keep-alive"
            k = 0
        end
        i += 1
    end

    return BenchConfig(target_u, n, c, t, k)
end

struct BenchUrl
    host
    port
    path
    query
end

function parse_bench_url(url_str)
    let parsed = u::parse(url_str)
    let host = parsed.host
    let port = 80
    if len(parsed.port) > 0
        port = int(parsed.port)
    elif parsed.scheme == "https"
        port = 443
    end
    let path = parsed.path
    if len(path) == 0
        path = "/"
    end
    return BenchUrl(host, port, path, parsed.query)
end

function run_single_probe(url_str)
    let t0 = clock_ms()
    let parsed = parse_bench_url(url_str)
    let host = parsed.host
    let port = parsed.port
    let path = parsed.path
    let sock = tcp_connect(host, port)
    if sock < 0
        return 0, clock_ms() - t0, ""
    end
    tcp_set_timeout(sock, 3000)
    let req = "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"
    tcp_send(sock, req)
    let body = tcp_recv(sock, 4096)
    tcp_close(sock)
    let elapsed = clock_ms() - t0
    return 1, elapsed, body
end

function run_worker_task(args_tuple)
    let cfg, reqs_for_worker, ch_res = args_tuple
    let parsed = parse_bench_url(cfg.url)
    let host = parsed.host
    let port = parsed.port
    let path = parsed.path
    if len(parsed.query) > 0
        path = path + "?" + parsed.query
    end

    let req_str = "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: keep-alive\r\nUser-Agent: Alya-Bench/1.0\r\n\r\n"
    if cfg.keep_alive == 0
        req_str = "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\nUser-Agent: Alya-Bench/1.0\r\n\r\n"
    end

    let sock = -1
    let ok_count = 0
    let fail_count = 0
    let min_latency = 999999
    let max_latency = 0
    let total_latency = 0

    let i = 0
    while i < reqs_for_worker
        let t0 = clock_ms()

        if sock < 0
            sock = tcp_connect(host, port)
            if sock < 0
                fail_count += 1
                i += 1
                continue
            end
            tcp_set_timeout(sock, cfg.timeout_ms)
        end

        let s_res = tcp_send(sock, req_str)
        if s_res < 0
            tcp_close(sock)
            sock = -1
            fail_count += 1
            i += 1
            continue
        end

        let ready = tcp_poll(sock, cfg.timeout_ms)
        if ready <= 0
            tcp_close(sock)
            sock = -1
            fail_count += 1
            i += 1
            continue
        end

        let resp_str = tcp_recv(sock, 65536)
        if len(resp_str) == 0
            tcp_close(sock)
            sock = -1
            fail_count += 1
            i += 1
            continue
        end

        # Ensure complete HTTP body is drained to prevent socket desynchronization in keep-alive
        let sep = index_of(resp_str, "\r\n\r\n")
        if sep >= 0
            let cl_idx = index_of(lower(resp_str), "content-length:")
            if cl_idx >= 0
                let val_start = cl_idx + 15
                let val_end = index_of(resp_str, "\r\n", val_start)
                if val_end >= 0
                    let cl = int(trim(substring(resp_str, val_start, val_end - val_start)))
                    let expected_total = sep + 4 + cl
                    while len(resp_str) < expected_total
                        let chunk = tcp_recv(sock, 65536)
                        if len(chunk) == 0
                            break
                        end
                        resp_str = resp_str + chunk
                    end
                end
            end
        end

        let elapsed = clock_ms() - t0
        ok_count += 1
        if elapsed < min_latency
            min_latency = elapsed
        end
        if elapsed > max_latency
            max_latency = elapsed
        end
        total_latency += elapsed

        if cfg.keep_alive == 0
            tcp_close(sock)
            sock = -1
        end

        i += 1
    end

    if sock >= 0
        tcp_close(sock)
    end

    channel_send(ch_res, (ok_count, fail_count, min_latency, max_latency, total_latency))
    return 0
end

function main()
    let cfg = parse_args()
    cfg.show_banner()

    # Check for smoke test mode
    let cli_args = args()
    let is_test = 0
    for a in cli_args
        if a in ["--test", "--once"]
            is_test = 1
        end
    end

    if is_test == 1
        say color_yellow("[BENCH]") + " Running simulated smoke benchmark..."
        let stats = BenchStats(10, 0, 25, 2, 4, 2, 2000)
        stats.show_results(cfg)
        say color_green("[SUCCESS]") + " Benchmark completed cleanly."
        return
    end

    # Pre-flight connectivity check: verify target server is reachable
    say "Connecting to " + color_white(cfg.url) + "..."
    let probe_ok, probe_lat, probe_body = run_single_probe(cfg.url)
    if probe_ok == 0
        say ""
        say color_red("✗ Error:") + " Could not connect to target server at " + style_bold(cfg.url)
        say color_yellow("  Hint:") + " Make sure the HTTP server is running first in another terminal:"
        say "        " + style_bold(color_cyan("alya run apps/http_server/main.alya --port 8080"))
        say ""
        return
    end

    say color_green("✓ Connection verified") + " (" + str(probe_lat) + " ms)."
    if len(probe_body) > 0
        if len(probe_body) > 80
            say "  " + style_bold("Server Payload") + "  : " + color_cyan(substring(probe_body, 0, 77) + "...")
        else
            say "  " + style_bold("Server Payload") + "  : " + color_cyan(probe_body)
        end
    end
    say "  Starting benchmark...\n"
    let t_start = clock_ms()

    let ch_res = channel_new()
    let reqs_per_worker = cfg.total_reqs / cfg.concurrency
    let remainder = cfg.total_reqs % cfg.concurrency

    let w = 0
    let threads = []
    while w < cfg.concurrency
        let n_w = reqs_per_worker
        if w == cfg.concurrency - 1
            n_w = n_w + remainder
        end
        let t = thread_spawn(run_worker_task, (cfg, n_w, ch_res))
        threads.push(t)
        w += 1
    end

    let total_ok = 0
    let total_fail = 0
    let overall_min_lat = 999999
    let overall_max_lat = 0
    let sum_latencies = 0

    for th in threads
        thread_join(th)
    end

    let recvd = 0
    while recvd < cfg.concurrency
        let res_tuple = channel_recv(ch_res, 1000)
        if res_tuple is not null
            let ok_c, fail_c, min_l, max_l, tot_l = res_tuple
            total_ok += ok_c
            total_fail += fail_c
            if min_l < overall_min_lat
                overall_min_lat = min_l
            end
            if max_l > overall_max_lat
                overall_max_lat = max_l
            end
            sum_latencies += tot_l
        end
        recvd += 1
    end
    channel_free(ch_res)

    let total_wall_time = clock_ms() - t_start
    if overall_min_lat == 999999
        overall_min_lat = 0
    end
    let avg_latency = 0
    if total_ok > 0
        avg_latency = sum_latencies / total_ok
    end
    let rps = 0
    if total_wall_time > 0
        rps = (total_ok * 1000) / total_wall_time
    end

    let stats = BenchStats(total_ok, total_fail, total_wall_time, overall_min_lat, overall_max_lat, avg_latency, rps)
    stats.show_results(cfg)
end

main()
