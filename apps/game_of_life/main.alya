# ═══════════════════════════════════════════════════════════════
# Alya Conway's Game of Life (game_of_life)
# Part of the Alya Apps Collection
# ═══════════════════════════════════════════════════════════════
#
# Features:
#   - Conway's 4 cellular automaton rules on a toroidal 2D grid
#   - Preset seed patterns (Glider, R-pentomino, Blinker, Random Soup)
#   - Real-time generation counter and live population tracking
#   - ANSI terminal animation with smooth frame delays
#   - Modern struct methods and enums (Board.step, Board.render)
#   - Non-hanging automated smoke test mode (--test)
#
# Usage:
#   alyac run apps/game_of_life/main.alya
#   alyac run apps/game_of_life/main.alya -- --pattern glider --gens 80
#   alyac run apps/game_of_life/main.alya -- --pattern random --gens 120
#   alyac run apps/game_of_life/main.alya -- --test
# ═══════════════════════════════════════════════════════════════

import "term" as ui
import "rand" as r
import "std/color"
import "std/console"
import "std/time"
import "std/str"
import "std/os"

enum CellState
    Dead = 0,
    Alive = 1
end

struct Board
    cells
    w
    h
end

function make_board(w, h)
    let g = []
    let total = w * h
    let i = 0
    while i < total
        g.push(CellState.Dead)
        i += 1
    end
    return Board(g, w, h)
end

function Board.place(self, x, y)
    if x >= 0 and x < self.w and y >= 0 and y < self.h
        let idx = y * self.w + x
        self.cells[idx] = CellState.Alive
    end
end

function Board.init_glider(self, sx, sy)
    self.place(sx + 1, sy)
    self.place(sx + 2, sy + 1)
    self.place(sx, sy + 2)
    self.place(sx + 1, sy + 2)
    self.place(sx + 2, sy + 2)
end

function Board.init_r_pentomino(self, sx, sy)
    self.place(sx + 1, sy)
    self.place(sx + 2, sy)
    self.place(sx, sy + 1)
    self.place(sx + 1, sy + 1)
    self.place(sx + 1, sy + 2)
end

function Board.init_blinker(self, sx, sy)
    self.place(sx, sy)
    self.place(sx + 1, sy)
    self.place(sx + 2, sy)
end

function Board.init_random(self, pct)
    let y = 0
    while y < self.h
        let x = 0
        while x < self.w
            if r::chance(pct) == 1
                self.place(x, y)
            end
            x += 1
        end
        y += 1
    end
end

function Board.count_neighbors(self, x, y)
    let count = 0
    let dy = -1
    while dy <= 1
        let dx = -1
        while dx <= 1
            if dx != 0 or dy != 0
                let nx = x + dx
                if nx < 0
                    nx += self.w
                elif nx >= self.w
                    nx -= self.w
                end

                let ny = y + dy
                if ny < 0
                    ny += self.h
                elif ny >= self.h
                    ny -= self.h
                end

                let idx = ny * self.w + nx
                count += self.cells[idx]
            end
            dx += 1
        end
        dy += 1
    end
    return count
end

function Board.count_alive(self)
    let count = 0
    for cell in self.cells
        if cell == CellState.Alive
            count += 1
        end
    end
    return count
end

function Board.step(self)
    let next_cells = []
    let y = 0
    while y < self.h
        let x = 0
        while x < self.w
            let n = self.count_neighbors(x, y)
            let cell = self.cells[y * self.w + x]
            let new_cell = CellState.Dead
            if cell == CellState.Alive
                if n in [2, 3]
                    new_cell = CellState.Alive
                end
            else
                if n == 3
                    new_cell = CellState.Alive
                end
            end
            next_cells.push(new_cell)
            x += 1
        end
        y += 1
    end
    return Board(next_cells, self.w, self.h)
end

function show_banner(pattern_name)
    let info = "Pattern: " + ui::color_green(pattern_name) + "  |  Rule: B3/S23 (Standard Conway)"
    say ui::box_render(ui::box_new(info, "🧬 CONWAY'S GAME OF LIFE (ALYA) 🧬", "rounded"))
end

function Board.render(self, gen, alive)
    let top = "  ╔"
    let i = 0
    while i < self.w * 2
        top = top + "═"
        i += 1
    end
    top = top + "╗"
    say ui::color_cyan(top)

    let y = 0
    while y < self.h
        let row = "  " + ui::color_cyan("║")
        let x = 0
        while x < self.w
            let c = self.cells[y * self.w + x]
            if c == CellState.Alive
                row = row + ui::color_bright_cyan("■ ")
            else
                row = row + "  "
            end
            x += 1
        end
        row = row + ui::color_cyan("║")
        say row
        y += 1
    end

    let bottom = "  ╚"
    i = 0
    while i < self.w * 2
        bottom = bottom + "═"
        i += 1
    end
    bottom = bottom + "╝"
    say ui::color_cyan(bottom)

    say "  " + ui::style_bold("Generation") + ": " + ui::color_yellow(str(gen)) + "    " + ui::style_bold("Live Population") + ": " + ui::color_green(str(alive)) + "    " + ui::style_bold("Dimensions") + ": " + str(self.w) + "x" + str(self.h)
    say ""
end

function main()
    console_utf8()
    let cli_args = args()
    let pattern_name = "glider"
    let max_gens = 60
    let delay_ms = 90
    let is_test = 0

    let i = 0
    while i < arr_len(cli_args)
        let a = cli_args[i]
        if a in ["-p", "--pattern"] and i + 1 < arr_len(cli_args)
            pattern_name = cli_args[i + 1]
            i += 1
        elif a in ["-g", "--gens"] and i + 1 < arr_len(cli_args)
            let g = int(cli_args[i + 1])
            if g > 0 max_gens = g end
            i += 1
        elif a in ["-d", "--delay"] and i + 1 < arr_len(cli_args)
            let d = int(cli_args[i + 1])
            if d >= 0 delay_ms = d end
            i += 1
        elif a in ["--test", "--simulate"]
            is_test = 1
        end
        i += 1
    end

    let b = make_board(24, 13)

    when pattern_name
        is "glider" then b.init_glider(2, 2)
        is "r-pentomino" then b.init_r_pentomino(b.w / 2 - 1, b.h / 2 - 1)
        is "rle" then b.init_r_pentomino(b.w / 2 - 1, b.h / 2 - 1)
        is "blinker" then b.init_blinker(b.w / 2 - 1, b.h / 2)
        is "random" then b.init_random(28)
        else b.init_glider(2, 2)
    end

    if is_test == 1
        say color_yellow("[LIFE]") + " Running automated simulation test..."
        let gen = 0
        while gen < 15
            b = b.step()
            gen += 1
        end
        let cur_alive = b.count_alive()
        show_banner(pattern_name)
        b.render(gen, cur_alive)
        say color_green("[SUCCESS]") + " Game of Life simulation passed cleanly (" + str(gen) + " generations computed)."
        return
    end

    console_clear()
    let gen = 0
    let cur_alive = b.count_alive()

    while gen <= max_gens
        console_clear()
        show_banner(pattern_name)
        b.render(gen, cur_alive)

        if gen >= max_gens
            say ui::color_green("Simulation complete!") + " (" + str(gen) + " generations)"
            break
        end

        sleep(delay_ms)
        b = b.step()
        cur_alive = b.count_alive()
        gen += 1
    end
end

main()
